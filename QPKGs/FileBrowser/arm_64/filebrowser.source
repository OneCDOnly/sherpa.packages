#!/bin/bash
#*
#* <?preamble?>
#*
#* Description:
#*	  This is the service-script for the QPKG name show below as $r_qpkg_name
#*
#* <?postamble?>
#*
readonly r_user_args_raw=$*
readonly r_qpkg_name=FileBrowser
readonly r_service_script_version='<?build_date?>'

InitService()
	{

	# This is a type 8 service-script.

	# NOTE: default session variables are set below, but may be customised in the InitService() function for each QPKG. If a variable is set to a non-default value, any later variable that uses it must be recalculated (uncomment these lines).

	# >>> Switches <<<

		# allow_access_to_sys_packages=false
			# Default
		# allow_access_to_sys_packages=true
			# Typical

		# can_restart_to_update=false
			# Default
		can_restart_to_update=true
			# Custom
		# > If 'true', application files can be updated by restarting service-script.

		# check_network_before_start=false
			# Default
		# check_network_before_start=true
			# Custom
		# > If 'true', at-least one network interface must be operational before starting application daemon.

		# compare_release_filename=false
			# Default
		# compare_release_filename=true
			# Custom
		# > If 'true', release package filename is used instead of last modified date to determine if new release is available. Need this for *arr packages, as they don't expose the "last modified" datetime of remote package files.

		# daemon_pidfile_is_managed_by_app=false
			# Default
		# daemon_pidfile_is_managed_by_app=true
			# Custom

		# install_pip_deps=false
			# Default
		# install_pip_deps=true
			# Custom

		# package_is_exec=false
			# Default
		# package_is_exec=true
			# Custom
		# > If 'true', downloadable package is an executable file. If 'false', downloadable package is an archive that must be extracted-from.

		# recheck_daemon_pid_after_kill=false
			# Default
		# recheck_daemon_pid_after_kill=true
			# Custom
		# > If 'true', application PID is reconfirmed shortly after kill. Some applications switch to another PID during shutdown, then kill their main PID.

		# recheck_daemon_pid_after_launch=false
			# Default
		# recheck_daemon_pid_after_launch=true
			# Custom
		# > If 'true', application PID is reconfirmed shortly after initial launch. Some applications launch with one PID, then switch to another. Some just take a while to start.

		# resolve_source_url=false
			# Default
		resolve_source_url=true
			# Custom
		# > If 'true', URL must be retrieved from remote first, then parsed to get final URL.

		# run_daemon_in_screen_session=false
			# Default
		run_daemon_in_screen_session=true
			# Custom
		# > If 'true', daemon is always launched in a `screen` session, but will exit `screen` when it can.

		# silence_pypi_errors=false
			# Default
		# silence_pypi_errors=true
			# Typical
		# > If 'true', PyPI package processing errors won't be shown in system log.

	# >>> Independent values <<<

		# daemon_port=0
			# Default
		# daemon_port=
			# Custom

		# nice_daemon_to=0
			# Default
		# nice_daemon_to=
			# Custom
		# > If non-zero, daemon proc is "niced" to this value on-launch.

		# source_git_branch=undefined
			# Default
		# source_git_branch=main
			# Typical
		# source_git_branch=master
			# Typical
		# source_git_branch=
			# Custom

		# source_git_branch_depth=undefined
			# Default
		# source_git_branch_depth=shallow
			# Typical
		# source_git_branch_depth=single-branch
			# Typical
		# source_git_branch_depth=
			# Custom
		# > 'shallow' (depth 1) or 'single-branch': 'shallow' implies 'single-branch', 'single-branch' does NOT imply 'shallow'.

		# source_url_arch=undefined
			# Default
		source_url_arch=arm64
			# Custom

		# start_retries=0
			# Default
		# start_retries=3
			# Typical
		# start_retries=
			# Custom
		# > If daemon failed to 'start', try 'start' again this many times.

		# ui_listening_address=undefined
			# Default
		ui_listening_address=0.0.0.0
			# Typical
		# ui_listening_address=
			# Custom

		# ui_port=0
			# Default
		ui_port=8641
			# Custom

		# ui_port_secure=0
			# Default
		# ui_port_secure=
			# Custom

		# wait_pid_kill_seconds=10
			# Default
		# wait_pid_kill_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		# wait_pid_start_seconds=10
			# Default
		# wait_pid_start_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		# watch_interface_up_seconds=180
			# Default
		# watch_interface_up_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		# watch_pid_kill_seconds=120
			# Default
		# watch_pid_kill_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		# watch_pid_start_seconds=120
			# Default
		# watch_pid_start_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		# watch_pidfile_start_seconds=60
			# Default
		# watch_pidfile_start_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		# watch_port_check_seconds=120
			# Default
		# watch_port_check_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

	# >>> Paths <<<

		# qpkg_config_path=undefined
			# Default
		qpkg_config_path=$r_qpkg_path/config
			# Typical
		# qpkg_config_path=
			# Custom

		# qpkg_pip_path=undefined
			# Default
		# qpkg_pip_path=$r_qpkg_path/pip-cache
			# Typical
		# qpkg_pip_path=
			# Custom

		# qpkg_repo_path=undefined
			# Default
		qpkg_repo_path=$r_qpkg_path/repo-cache
			# Typical
		# qpkg_repo_path=
			# Custom

		# qpkg_temp_path=undefined
			# Default
		qpkg_temp_path=$r_qpkg_path/tmp
			# Typical
		# qpkg_temp_path=
			# Custom

		# qpkg_venv_path=undefined
			# Default
		# qpkg_venv_path=$r_qpkg_path/venv
			# Typical
		# qpkg_venv_path=
			# Custom

		# qpkg_wheels_path=undefined
			# Default
		# qpkg_wheels_path=$r_qpkg_path/qpkg-wheels
			# Typical
		# qpkg_wheels_path=
			# Custom

	# >>> Pathfilenames <<<

		# appl_version_pathfile=undefined
			# Default
		# appl_version_pathfile=
			# Custom

		# daemon_check_pathfile=undefined
			# Default
		# daemon_check_pathfile=
			# Custom
		# > If set, look for this process name in RAM instead of $daemon_exec_pathfile.

		# daemon_exec_pathfile=undefined
			# Default
		# daemon_exec_pathfile=$qpkg_venv_path/bin/python3
			# Typical
		daemon_exec_pathfile=$qpkg_repo_path/filebrowser
			# Custom
		# > The pathfilename of the main daemon. If $daemon_script_pathfile is set, then this is the interpreter used to run the script.

		# daemon_pid_pathfile=undefined
			# Default
		daemon_pid_pathfile=/var/run/$r_qpkg_name.pid
			# Typical
		# daemon_pid_pathfile=
			# Custom

		# daemon_script_pathfile=undefined
			# Default
		# daemon_script_pathfile=
			# Custom
		# > When an interpreter is to be used, interpret this script.

		# launcher_pathfile=undefined
			# Default
		# launcher_pathfile=
			# Custom
		# > On-demand executables only (no daemon).

		# qpkg_backup_pathfile=undefined
			# Default
		qpkg_backup_pathfile=$r_backup_path/$r_qpkg_name.config.tar.gz
			# Typical
		# qpkg_backup_pathfile=
			# Custom

		# qpkg_config_pathfile=undefined
			# Default
		# qpkg_config_pathfile=$qpkg_config_path/config.ini
			# Typical
		qpkg_config_pathfile=$qpkg_config_path/filebrowser.db
			# Custom

		# qpkg_config_default_pathfile=undefined
			# Default
		qpkg_config_default_pathfile=$qpkg_config_pathfile.def
			# Typical
		# qpkg_config_default_pathfile=
			# Custom

		# qpkg_config_virtual_pathfile=undefined
			# Default
		# qpkg_config_virtual_pathfile=
			# Custom
		# > When config file must be made available to appl through a symlink (like nzbToMedia).

		# userlink_pathfile=undefined
			# Default
		# userlink_pathfile=
			# Custom
		# > Applies to on-demand executables only.

		# venv_pip_pathfile=undefined
			# Default
		# venv_pip_pathfile=$qpkg_venv_path/bin/pip
			# Typical
		# venv_pip_pathfile=
			# Custom

		# venv_python_pathfile=undefined
			# Default
		# venv_python_pathfile=$qpkg_venv_path/bin/python3
			# Typical
		# venv_python_pathfile=
			# Custom

	# >>> Potentially dependent values (these might use a variable set earlier) <<<

		export HOME=$qpkg_config_path
			# Default
		# export HOME=
			# Custom

		# interpreter=undefined
			# Default
		# interpreter=/opt/bin/python3
			# Typical
		# interpreter=
			# Custom

		# orig_daemon_service_script=undefined
			# Default
		# orig_daemon_service_script=
			# Custom
		# > Specific to Entware binaries only.

		# source_asset_url_match=undefined
			# Default
		source_asset_url_match=linux-${source_url_arch}-filebrowser.tar.gz
			# Custom
		# > Longest string to match in URL to determine filename.

	# >>> URLs <<<

		# source_asset_url=undefined
			# Default
		# source_asset_url=https://api.github.com/
			# Typical
		source_asset_url=https://api.github.com/repos/filebrowser/filebrowser/releases/latest
			# Custom

		# source_git_url=undefined
			# Default
		# source_git_url=
			# Custom
		# > https://github.com/
		# > https://gitlab.com/

	# >>> CMDs <<<

		# daemon_launch_cmd=undefined
			# Default
		daemon_launch_cmd="$daemon_exec_pathfile --database $qpkg_config_pathfile --address $ui_listening_address --port $ui_port --root /"
			# Custom

		# get_appl_version_cmd=undefined
			# Default
		# get_appl_version_cmd=
			# Custom

		# get_daemon_port_cmd=undefined
			# Default
		# get_daemon_port_cmd=
			# Custom

		# get_ui_listening_address_cmd=undefined
			# Default
		get_ui_listening_address_cmd="echo $ui_listening_address"
			# Custom

		# get_ui_port_cmd=undefined
			# Default
		get_ui_port_cmd="echo $ui_port"
			# Custom

		# get_ui_port_secure_cmd=undefined
			# Default
		get_ui_port_secure_cmd=false
			# Custom

		# get_ui_port_secure_enabled_test_cmd=undefined
			# Default
		get_ui_port_secure_enabled_test_cmd=false
			# Custom

	}

library_path=$(/usr/bin/readlink "$0" 2>/dev/null)
[[ -z $library_path ]] && library_path=$0
library_path=$(/usr/bin/dirname "$library_path")
service_library_pathfile=$library_path/service-library.source
[[ ! -e $service_library_pathfile ]] && service_library_pathfile=$library_path/service.lib

if [[ ! -e $service_library_pathfile ]]; then
	printf '\033[1;31m%s\033[0m: %s\n' derp "QPKG service function library not found, can't continue."
	exit 1
fi

. $service_library_pathfile

ProcessArgs
