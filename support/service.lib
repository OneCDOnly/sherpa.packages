set -o nounset -o pipefail
shopt -s extglob
[[ $- != *m* ]]||set +m
[[ -L /dev/fd ]]||ln -fns /proc/self/fd /dev/fd
readonly r_service_library_version=251004
InitLibrary(){
[[ $(/usr/bin/basename "${BASH_SOURCE[0]}") = 'service-library.source' ]]&&ShowAsNote 'using source library'
IsQNAP||exit
debug=${DEBUG_QPKG:=false}
local re=''
for re in \\bd\\b \\bD\\b \\bdebug\\b \\bdbug\\b \\bverbose\\b;do
[[ $r_user_args_raw =~ $re ]]||continue
debug=true
break
done
UnsetError
readonly r_backup_path=$(/sbin/getcfg SHARE_DEF defVolMP -f /etc/config/def_share.info)/.qpkg_config_backup
readonly r_opkg_path=/opt/bin:/opt/sbin
export PATH=$r_opkg_path:$(/bin/sed "s|$r_opkg_path||"<<<"$PATH")
readonly r_qpkg_path=$(/sbin/getcfg $r_qpkg_name Install_Path -f /etc/config/qpkg.conf)
readonly r_qpkg_config_path=$r_qpkg_path/config
export HOME=$r_qpkg_config_path
readonly r_qpkg_temp_path=$r_qpkg_path/tmp
readonly r_appl_version_store_pathfile=$r_qpkg_path/version.stored
readonly r_screen_conf_pathfile=$r_qpkg_path/screen.conf
readonly r_service_action_pathfile=/var/log/$r_qpkg_name.action
readonly r_service_log_pathfile=/var/log/$r_qpkg_name.log
readonly r_service_result_pathfile=/var/log/$r_qpkg_name.result
readonly r_service_screen_log_pathfile=$r_qpkg_path/$r_qpkg_name.screen.log
readonly r_chars_regular_prompt='$ '
readonly r_chars_sudo_prompt="${r_chars_regular_prompt}sudo "
readonly r_chars_super_prompt='# '
readonly r_debug_log_datawidth=100
readonly r_extended_datetime_format='+%a %-d %b %Y'
readonly r_full_datetime_format=$r_extended_datetime_format' %-I:%M:%S %p %Z'
readonly r_nas_firmware_version=$(/sbin/getcfg System Version -f /etc/config/uLinux.conf)
readonly r_qpkg_version=$(/sbin/getcfg $r_qpkg_name Version -d unknown -f /etc/config/qpkg.conf)
SetNasArch
SetQpkgArch
SetOsFirmwareVer
SetHardwarePlatform
pip_cache_path=undefined
qpkg_repo_path=undefined
qpkg_wheels_path=undefined
venv_path=undefined
qpkg_ini_file=config.ini
app_version_pathfile=undefined
daemon_check_pathfile=undefined
daemon_exec_pathfile=undefined
daemon_pid_pathfile=/var/run/$r_qpkg_name.pid
daemon_script_pathfile=undefined
launcher_pathfile=undefined
qpkg_backup_pathfile=$r_backup_path/$r_qpkg_name.config.tar.gz
qpkg_ini_pathfile=$r_qpkg_config_path/$qpkg_ini_file
qpkg_ini_default_pathfile=$qpkg_ini_pathfile.def
userlink_pathfile=undefined
venv_pip_pathfile=undefined
venv_python_pathfile=undefined
allow_access_to_sys_packages=true
can_restart_to_update=false
check_network_before_start=false
compare_release_filename=false
daemon_pidfile_is_managed_by_app=false
install_pip_deps=false
package_is_exec=false
recheck_daemon_pid_after_kill=false
recheck_daemon_pid_after_launch=false
resolve_source_url=false
run_daemon_in_screen_session=false
silence_pypi_errors=true
daemon_port=0
interpreter=undefined
nice_daemon_to=0
orig_daemon_service_script=undefined
remote_arch=undefined
remote_match=undefined
source_arch=undefined
source_git_branch=undefined
source_git_branch_depth=undefined
start_retries=0
ui_listening_address=undefined
ui_port=0
ui_port_secure=0
wait_pid_kill_seconds=10
wait_pid_start_seconds=10
watch_interface_up_seconds=180
watch_pid_kill_seconds=120
watch_pid_start_seconds=120
watch_pidfile_start_seconds=60
watch_port_check_seconds=120
source_git_url=undefined
source_url=undefined
daemon_launch_cmd=undefined
get_app_version_cmd=undefined
get_daemon_port_cmd=undefined
get_ui_listening_address_cmd=undefined
get_ui_port_cmd=undefined
get_ui_port_secure_cmd=undefined
get_ui_port_secure_enabled_test_cmd=undefined
InitService
curl_insecure_opt=''
IsOsCanSecureDownload ||curl_insecure_opt=' --insecure'
get_remote_filename_timeout_seconds=5
new_env=false
pyver=''
service_action=unspecified
service_result=undefined
MakePaths
EnsureConfigFileExists
GetAppVersion
DisableOpkgDaemonStart
IsSupportAutoUpdate&&IsAutoUpdateMissing &&EnableAutoUpdate>/dev/null
readonly e_nourl='undefined URL'
rm -f "$r_screen_conf_pathfile"
if [[ $run_daemon_in_screen_session = true &&! -e $r_screen_conf_pathfile ]];then
echo -e "logfile ${r_service_screen_log_pathfile}\nlogfile flush 1\nlog on">"$r_screen_conf_pathfile"
fi;}
StartQPKG(){
IsNotError||return
IsStart &&ShowQPKGStates
if IsDaemon&&IsNotRestart;then
IsNotStart &&DaemonWasNotActive&&return
IsNotClean &&ShowDaemonState
IsDaemonActive&&return
fi
[[ -e $r_service_screen_log_pathfile ]]&&DisplayRunAndLog "remove previous 'screen' session log" "rm -f \"$r_service_screen_log_pathfile\"" log:failure-only
[[ $(type -t PreStartQPKGCustom) = function ]]&&PreStartQPKGCustom
if [[ $(type -t StartQPKGCustom) = function ]];then
StartQPKGCustom
else
StartQPKGLibrary
fi;}
MigrateQPKGName(){
local migration_qpkgs=(OLidarr OMedusa OqBittorrent OReadarr OSickGear OSonarr OTautulli OTransmission OWatcher3 OWhisparr)
if [[ "${migration_qpkgs[*]}" =~ [[:space:]]${r_qpkg_name}[[:space:]] ]];then
echo "found a migratable QPKG name!"
fi;}
StartQPKGLibrary(){
if IsGitApp;then
CloneGitRepo||return
fi
if IsOnlineReleasePackage;then
RefreshReleasePackageFiles||return
fi
if IsVirtualPythonEnv&&IsNotVirtualPythonEnvExist;then
CreateVirtualPythonEnv||return
InstallPythonPackages||return
fi
if IsNotDaemon;then
CreateUserlinkToExec
return
fi
EnsureConfigFileExists
LoadPorts app||return
CheckPortsAvailable||return
if IsCheckNetworkBeforeStart;then
WatchForAnyInterfaceUp||return
fi
StartDaemon
return;}
StopQPKG(){
IsNotError||return
if IsStop ||IsRestart ||IsClean;then
ShowQPKGStates
fi
if IsDaemon;then
ShowDaemonState
IsNotRestart&&IsNotDaemonActive&&return
fi
[[ $(type -t PreStopQPKGCustom) = function ]]&&PreStopQPKGCustom
if [[ $(type -t StopQPKGCustom) = function ]];then
StopQPKGCustom
else
StopQPKGLibrary
fi;}
StopQPKGLibrary(){
if IsNotDaemon;then
RemoveUserlinkToExec
return
fi
RefreshPidFile
if IsDaemon&&IsDaemonActive;then
SetDaemonWasActive
StopDaemon
ShowDaemonState
fi
return;}
StatusQPKG(){
IsNotError||return
ShowQPKGStates
IsDaemon &&ShowDaemonState
if [[ $(type -t StatusQPKGCustom) = function ]];then
StatusQPKGCustom
else
StatusQPKGLibrary
fi;}
StatusQPKGLibrary(){
RefreshPidFile
if IsDaemon&&IsDaemonActive;then
LoadPorts app
if ! WatchForPortsActive;then
Display '! no response from port(s)'
exit 1
fi
else
exit 1
fi
exit 0;}
CreateUserlinkToExec(){
if [[ $userlink_pathfile != undefined ]];then
if [[ ! -L $userlink_pathfile &&-e $launcher_pathfile ]];then
ln -s "$launcher_pathfile" "$userlink_pathfile"
if [[ -L $userlink_pathfile ]];then
DisplayAndCommitInfoToLog "symlink created: $userlink_pathfile"
else
DisplayAndCommitErrorToAllLogs "unable to create symlink to $r_qpkg_name launcher"
SetError;return
fi
else
DisplayAndCommitInfoToLog "symlink exists: $userlink_pathfile"
fi
return
fi;}
RemoveUserlinkToExec(){
if [[ $userlink_pathfile != undefined ]];then
if [[ -L $userlink_pathfile ]];then
rm -f "$userlink_pathfile"
DisplayAndCommitInfoToLog "symlink removed: $userlink_pathfile"
fi
fi;}
CreateVirtualPythonEnv(){
new_env=false
local a=''
local b=$venv_path/pip.conf
[[ $allow_access_to_sys_packages = true ]]&&a=' --system-site-packages'
if IsNotVirtualPythonEnvExist;then
DisplayRunAndLog 'create new virtual Python environment' "export PIP_CACHE_DIR=$pip_cache_path VIRTUALENV_OVERRIDE_APP_DATA=$pip_cache_path;$interpreter -m virtualenv ${venv_path}${a}" log:failure-only
new_env=true
if [[ ! -e $b ]];then
DisplayRunAndLog "create QPKG 'pip' config" "echo \"[global]\">$b" log:failure-only
DisplayRunAndLog "add location '$pip_cache_path' as 'pip' cache" "echo \"cache-dir = $pip_cache_path\">>$b" log:failure-only
if [[ -d $qpkg_wheels_path ]];then
DisplayRunAndLog "add location '$qpkg_wheels_path' to 'pip' search path" "echo \"find-links = $qpkg_wheels_path\">>$b" log:failure-only
fi
fi
fi
return 0;}
StartDaemon(){
IsDaemon||return
if IsDaemonActive;then
DisplayAndCommitInfoToLog 'daemon is already active'
ShowDaemonState
return
fi
local a='start daemon'
local b=$daemon_launch_cmd
local -i c=0
if [[ $run_daemon_in_screen_session = true ]];then
a+=" (in 'screen' session)"
rm -f "${r_service_screen_log_pathfile:?}"
fi
if((nice_daemon_to != 0)) &&((nice_daemon_to>= -20)) &&((nice_daemon_to<= 19)) &&[[ -e /opt/bin/nice ]];then
b="/opt/bin/nice -n $nice_daemon_to sh -c \"$daemon_launch_cmd\""
DisplayAndCommitInfoToLog "nice daemon to: $nice_daemon_to"
fi
while true;do
if ! (DisplayRunAndLog "$a" "$b" log:failure-only "$run_daemon_in_screen_session"&&IsDaemonActive &>/dev/null;WatchForDaemon;PauseForStartPid;ShowDaemonState) ||! IsDaemonActive &>/dev/null ||! WatchForPortsActive;then
DisplayAndCommitWarnToLog 'daemon PID check failed: there appears to have been a launch failure'
[[ $run_daemon_in_screen_session = true ]]&&AddFileToDebug "$r_service_screen_log_pathfile"
((c++))
if [[ $((c-1)) -lt $start_retries ]];then
DisplayAndCommitRetryToLog "retry $c/$start_retries"
continue
fi
DisplayAndCommitErrorToAllLogs "tried to launch $c time$(Pluralise "$c"), no further retries are possible"
SetError;return
fi
break
done
CommitInfoToSysLog "$a: OK";}
StopDaemon(){
[[ -e $daemon_pid_pathfile ]]||return
local a='stop daemon'
local -i b=$(CalcAdaptiveSeconds "$watch_pid_kill_seconds")
local -i c=0
local -i d=$(<$daemon_pid_pathfile)
[[ $d -gt 1 ]]||return
DisplayAndCommitProcessWaitToLog "$a PID ${d} with SIGTERM (no-more than $b second$(Pluralise "$b"))"
kill "$d"
while true;do
while [[ -d /proc/$d ]];do
/bin/sleep 1
((c++))
DisplayWait "$c,"
if [[ $c -ge $b ]];then
DisplayAndCommitOutcomeToLog failed
DisplayAndCommitProcessWaitToLog "$a PID ${d} with SIGKILL"
kill -9 "$d" 2>/dev/null
[[ -f $daemon_pid_pathfile ]]&&rm -f "$daemon_pid_pathfile"
DisplayAndCommitOutcomeToLog OK
break 2
fi
done
[[ -f $daemon_pid_pathfile ]]&&rm -f "$daemon_pid_pathfile"
DisplayAndCommitOutcomeToLog OK
CommitInfoToLog "stopped in $c second$(Pluralise "$c")"
CommitInfoToSysLog "$a: OK"
break
done
PauseForKillPid
if IsDaemonActive;then
SetError;return
fi;}
RefreshReleasePackageFiles(){
local extract_release_package=false
local refresh_release_package=false
local release_package_filename=''
local release_package_name_ref_pathfilename=''
local release_package_pathfile=$r_qpkg_temp_path/source.package
local release_package_url=''
if IsAutoUpdate ||[[ ! -e $release_package_pathfile ]];then
if [[ $resolve_source_url = true ]];then
refresh_release_package=true
DisplayAndCommitProcessWaitToLog 'get latest release package URL'
if IsSiteUp "$source_url";then
release_package_url=$(RequestLatestReleaseURL "$source_url" "$remote_match")
if [[ $? -eq 0 ]];then
DisplayAndCommitOutcomeToLog OK
DisplayAndCommitDoneToLog "release package URL: $release_package_url"
else
DisplayAndCommitOutcomeToLog failed
DisplayAndCommitErrorToAllLogs "$release_package_url"
release_package_url=''
fi
else
DisplayAndCommitErrorToAllLogs 'unable to access remote site'
fi
else
release_package_url=$source_url
fi
if [[ $compare_release_filename = true ]];then
DisplayAndCommitProcessWaitToLog "get latest remote release package filename (no-more than $get_remote_filename_timeout_seconds seconds)"
if IsSiteUp "$source_url";then
release_package_filename=$(RequestLatestReleaseFilename "$source_url" "$remote_arch")
if [[ $? -eq 0 ]];then
DisplayAndCommitOutcomeToLog OK
DisplayAndCommitDoneToLog "release package filename: $release_package_filename"
else
DisplayAndCommitOutcomeToLog failed
DisplayAndCommitErrorToAllLogs "$release_package_filename"
release_package_filename=''
fi
else
DisplayAndCommitErrorToAllLogs 'unable to access remote site'
fi
if [[ -z $release_package_filename &&-n $release_package_url &&$release_package_url != undefined ]];then
release_package_filename=$(/usr/bin/basename "$release_package_url")
fi
if [[ -z $release_package_name_ref_pathfilename &&-n $release_package_filename &&-n $release_package_url &&$release_package_url != undefined ]];then
release_package_name_ref_pathfilename=$(/usr/bin/dirname "$release_package_pathfile")/$release_package_filename
fi
if [[ -n $release_package_filename &&-n $release_package_name_ref_pathfilename ]];then
DisplayAndCommitProcessWaitToLog 'release package name reference exists locally'
if [[ -e $release_package_name_ref_pathfilename ]];then
DisplayAndCommitOutcomeToLog true
else
DisplayAndCommitOutcomeToLog false
refresh_release_package=true
rm -f "$release_package_pathfile"
fi
fi
fi
fi
DisplayAndCommitProcessWaitToLog 'release package exists locally'
if [[ -e $release_package_pathfile ]];then
DisplayAndCommitOutcomeToLog true
else
DisplayAndCommitOutcomeToLog false
refresh_release_package=true
fi
if [[ ! -e $release_package_pathfile &&-n $release_package_url ]]||[[ $refresh_release_package = true ]];then
DownloadReleasePackage "$release_package_url" "$release_package_pathfile"
if [[ -e $release_package_pathfile ]]&&[[ ! -e $daemon_exec_pathfile ||$(($(ConvertNowToSeconds)-$(/usr/bin/stat "$release_package_pathfile" -c %Y))) -lt 10 ]];then
extract_release_package=true
fi
fi
IsPathEmpty "$qpkg_repo_path" &&extract_release_package=true
if [[ $extract_release_package = true &&-e $release_package_pathfile ]];then
if IsReleaseAnArchive;then
ExtractReleasePackage "$release_package_pathfile" "$release_package_name_ref_pathfilename"
else
MakeExecReleasePackage "$release_package_pathfile" "$release_package_name_ref_pathfilename"
fi
fi
if [[ -d $qpkg_repo_path ]];then
if IsPathEmpty "$qpkg_repo_path";then
DisplayAndCommitErrorToAllLogs 'local repository files do not exist'
SetError;return
fi
else
DisplayAndCommitErrorToAllLogs 'local repository path does not exist'
SetError;return
fi
return 0;}
CheckPortsAvailable(){
local a=''
if [[ $daemon_port -le 0 &&$ui_port -le 0 &&$ui_port_secure -le 0 ]];then
DisplayAndCommitErrorToAllLogs 'no port specified'
SetError;return
elif IsNotPortAvailable $ui_port ||IsNotPortAvailable $ui_port_secure;then
DisplayAndCommitErrorToAllLogs "ports $ui_port or $ui_port_secure are already in-use"
a=$(/usr/sbin/lsof -i :$ui_port -Fp)
DisplayAndCommitInfoToAllLogs "process details for port $ui_port: ${a}: PID $([[ -n ${a:-} ]]&&/bin/tr '\000' ' '</proc/"${a/p/}"/cmdline)"
a=$(/usr/sbin/lsof -i :$ui_port_secure -Fp)
DisplayAndCommitInfoToAllLogs "process details for secure port $ui_port_secure: PID ${a}: $([[ -n ${a:-} ]]&&/bin/tr '\000' ' '</proc/"${a/p/}"/cmdline)"
SetError;return
fi;}
ShowHelp(){
Display "$(TextBrightWhite "$(/usr/bin/basename "$0")") v$r_service_script_version • a service control script for the $(FormatAsPackageName $r_qpkg_name) QPKG"
Display
Display "Usage: $0 [ACTION] [OPTION]"
Display
Display '[ACTION] must be one of the following:'
DisplayAsHelp 'activate, start' "start $(FormatAsPackageName $r_qpkg_name) if inactive"
IsSupportBackup &&DisplayAsHelp 'b, backup' "backup current $(FormatAsPackageName $r_qpkg_name) configuration to persistent storage"
IsSourcedOnline &&DisplayAsHelp clean "delete & re-download $(FormatAsPackageName $r_qpkg_name) files from source$(IsSupportBackup &&printf '. Configuration will be retained')"
DisplayAsHelp 'deactivate, stop' "stop $(FormatAsPackageName $r_qpkg_name) if active"
DisplayAsHelp disable "disable $(FormatAsPackageName $r_qpkg_name) to prevent it starting (on NAS bootup)"
IsSupportAutoUpdate &&DisplayAsHelp disable-auto-update "don't auto-update $(FormatAsPackageName $r_qpkg_name) before starting it"
DisplayAsHelp enable "enable $(FormatAsPackageName $r_qpkg_name) so it can be started"
IsSupportAutoUpdate &&DisplayAsHelp enable-auto-update "auto-update $(FormatAsPackageName $r_qpkg_name) before starting (default)"
DisplayAsHelp 'l, L, log' 'display the service-script log'
DisplayAsHelp 'r, reactivate, restart' "stop, then start $(FormatAsPackageName $r_qpkg_name)"
IsSupportActions &&DisplayAsHelp reset-action 'clear the current service-script action and action result'
IsSupportReset &&DisplayAsHelp reset-config "revert $(FormatAsPackageName $r_qpkg_name) configuration, databases and history to defaults"
IsSupportBackup &&DisplayAsHelp restore 'restore a previously saved configuration from persistent storage'
DisplayAsHelp 's, status' "check if $(FormatAsPackageName $r_qpkg_name) application is active. Returns \$? = 0 if active, 1 if not"
DisplayAsHelp 'v, V, version' 'display the package version numbers'
Display
Display '[OPTION] may be one of the following:'
DisplayAsHelp 'd, D, debug, verbose' "execute the specified [ACTION] in debug mode"
Display;}
InstallPythonPackages(){
IsVirtualPythonEnv||return 0
local a=''
local cmd=''
local default_essential_modules_pathfile=$r_qpkg_path/pip-essential.txt
local default_recommended_modules_pathfile=$r_qpkg_path/pip-recommended.txt
local default_requirements_modules_pathfile=$r_qpkg_path/pip-requirements.txt
local essential_modules_pathfile=$qpkg_repo_path/pip-essential.txt
local excluded_modules_pathfile=$r_qpkg_path/pip-exclusions.txt
local module_exclusions=''
local no_pip_deps=' --no-deps'
local no_pips_installed=true
local pyproject_pathfile=$qpkg_repo_path/pyproject.toml
local re=''
local recommended_modules_pathfile=$qpkg_repo_path/recommended.txt
local rename_modules_pathfile=$r_qpkg_path/pip-rename.txt
local requirements_modules_pathfile=$qpkg_repo_path/requirements.txt
[[ $install_pip_deps = true ]]&&no_pip_deps=''
if IsNotVirtualPythonEnvExist;then
DisplayAndCommitErrorToAllLogs 'unable to install addons: virtual Python environment does not exist'
SetError;return
fi
IsNotAutoUpdate &&[[ $new_env = false ]]&&return 0
if [[ $r_qpkg_name = OWatcher3 ]];then
DisplayRunAndLog "KLUDGE: install 'm2r' PyPI module first" "$venv_pip_pathfile install${no_pip_deps} --no-input m2r" log:failure-only
if [[ $? -gt 0 &&$silence_pypi_errors = false ]];then
CommitWarnToSysLog "'mr2' PyPI module installation failed"
fi
fi
[[ ! -e $default_essential_modules_pathfile &&-e $essential_modules_pathfile &&-d $(/usr/bin/dirname "$default_essential_modules_pathfile") ]]&&cp -f "$essential_modules_pathfile" "$default_essential_modules_pathfile"
[[ -e $default_essential_modules_pathfile ]]&&essential_modules_pathfile=$default_essential_modules_pathfile
[[ ! -e $default_requirements_modules_pathfile &&-e $requirements_modules_pathfile &&-d $(/usr/bin/dirname "$default_requirements_modules_pathfile") ]]&&cp -f "$requirements_modules_pathfile" "$default_requirements_modules_pathfile"
[[ -e $default_requirements_modules_pathfile ]]&&requirements_modules_pathfile=$default_requirements_modules_pathfile
[[ ! -e $default_recommended_modules_pathfile &&-e $recommended_modules_pathfile &&-d $(/usr/bin/dirname "$default_recommended_modules_pathfile") ]]&&cp -f "$recommended_modules_pathfile" "$default_recommended_modules_pathfile"
[[ -e $default_recommended_modules_pathfile ]]&&recommended_modules_pathfile=$default_recommended_modules_pathfile
if [[ -e $excluded_modules_pathfile ]];then
module_exclusions=$(/bin/tr '\n' ' '<<<"$(StripComments "$(<"$excluded_modules_pathfile")")")
module_exclusions=${module_exclusions%* }
[[ -n $module_exclusions ]]&&[[ -e /opt/bin/sed ]]&&re="${module_exclusions// /|}"
if [[ -n $re ]];then
for a in $essential_modules_pathfile $requirements_modules_pathfile $recommended_modules_pathfile $pyproject_pathfile;do
if [[ -e $a &&-e /opt/bin/sed ]];then
cmd="/opt/bin/sed -i -E '/^(${re})[[:space:]]/Id;/^(${re})$/Id' $a"
DisplayRunAndLog "exclude problematic PyPI modules from $(/usr/bin/basename "$a")" "$cmd" log:failure-only
fi
done
fi
fi
for a in $essential_modules_pathfile $requirements_modules_pathfile $recommended_modules_pathfile;do
if [[ -e $a ]];then
DisplayRunAndLog "install PyPI modules from $(/usr/bin/basename "$a")" "$venv_pip_pathfile install${no_pip_deps} --no-input --upgrade pip -r $a" log:failure-only
if [[ $? -gt 0 &&$silence_pypi_errors = false ]];then
CommitWarnToAllLogs 'PyPI module installation failed'
fi
no_pips_installed=false
fi
done
if [[ -e $rename_modules_pathfile ]];then
for a in $(StripComments "$(<"$rename_modules_pathfile")");do
RenameSharedObjectFile "$a"
done
fi
if IsSupportGetAppVersion;then
GetAppVersion
if [[ $new_env = false &&-e $r_appl_version_store_pathfile &&$(<"$r_appl_version_store_pathfile") != "$app_version" ]];then
DisplayRunAndLog 'clean Python bytecode files' "/opt/bin/find $qpkg_repo_path -type d -name '__pycache__' -print0|xargs -I {} -0 rm -rf '{}'
" log:failure-only
fi
if [[ ! -e $r_appl_version_store_pathfile ||$(<"$r_appl_version_store_pathfile") != "$app_version" ]];then
DisplayRunAndLog 'generate language translations' "cd $qpkg_repo_path;$venv_python_pathfile $qpkg_repo_path/tools/make_mo.py" log:failure-only
fi
SaveAppVersion
fi
return 0;}
StripComments(){
[[ -n $1 ]]||return
local a=$1
a=$(/bin/sed -e '/^#[[:space:]].*/d;/#$/d;s/[[:space:]]#[[:space:]].*//'<<<"$a")
a=$(/bin/sed -e 's/^[[:space:]]*//'<<<"$a")
a=$(/bin/sed 's/[[:space:]]*$//'<<<"$a")
a=$(/bin/sed "/^$/d"<<<"$a")
echo "$a";}
BackupConfig(){
if ! DisplayRunAndLog 'update configuration backup' "/bin/tar --create --gzip --file=$qpkg_backup_pathfile --directory=$r_qpkg_path/config ." log:failure-only;then
SetError;return
fi;}
RestoreConfig(){
if [[ ! -f $qpkg_backup_pathfile ]];then
DisplayAndCommitErrorToAllLogs "unable to restore configuration: no backup file was found"
SetError;return
fi
if ! DisplayRunAndLog 'restore configuration backup' "/bin/tar --extract --gzip --file=$qpkg_backup_pathfile --directory=$r_qpkg_path/config" log:failure-only;then
SetError;return
fi;}
ResetConfig(){
if ! DisplayRunAndLog 'reset configuration' "mv $qpkg_ini_default_pathfile $r_qpkg_path;rm -rf $r_qpkg_path/config/*;mkdir -p $(/usr/bin/dirname "$qpkg_ini_default_pathfile");mv $r_qpkg_path/$(/usr/bin/basename "$qpkg_ini_default_pathfile") $qpkg_ini_default_pathfile" log:failure-only;then
SetError;return
fi;}
MakePaths(){
local a=''
if [[ -d $r_qpkg_path ]];then
for a in "$r_qpkg_temp_path" "$qpkg_repo_path" "$pip_cache_path" "$venv_path";do
[[ $a != undefined &&! -d $a ]]&&mkdir -p "$a"
done
fi
[[ $r_backup_path != undefined &&! -d $r_backup_path ]]&&mkdir -p "$r_backup_path";}
LoadPorts(){
case $1 in
app)
DisplayAndCommitProcessWaitToLog 'load ports from configuration file'
[[ $get_ui_port_cmd != undefined ]]&&ui_port=$(eval "$get_ui_port_cmd")
[[ $get_ui_port_secure_cmd != undefined ]]&&ui_port_secure=$(eval "$get_ui_port_secure_cmd")
DisplayAndCommitOutcomeToLog OK;;
qts)
DisplayAndCommitProcessWaitToLog 'load UI ports from QPKG icon'
ui_port=$(/sbin/getcfg $r_qpkg_name Web_Port -d 0 -f /etc/config/qpkg.conf)
ui_port_secure=$(/sbin/getcfg $r_qpkg_name Web_SSL_Port -d 0 -f /etc/config/qpkg.conf)
DisplayAndCommitOutcomeToLog OK;;
*)DisplayAndCommitErrorToAllLogs "unable to load ports: action '$1' is unrecognised"
SetError;return
esac
[[ $get_daemon_port_cmd != undefined ]]&&daemon_port=$(eval "$get_daemon_port_cmd")
[[ $get_ui_listening_address_cmd != undefined ]]&&ui_listening_address=$(eval "$get_ui_listening_address_cmd")
ui_port=${ui_port//[!0-9]/}
[[ -z $ui_port ||$ui_port -lt 0 ||$ui_port -gt 65535 ]]&&ui_port=0
ui_port_secure=${ui_port_secure//[!0-9]/}
[[ -z $ui_port_secure ||$ui_port_secure -lt 0 ||$ui_port_secure -gt 65535 ]]&&ui_port_secure=0
daemon_port=${daemon_port//[!0-9]/}
[[ -z $daemon_port ||$daemon_port -lt 0 ||$daemon_port -gt 65535 ]]&&daemon_port=0
[[ -z $ui_listening_address ]]&&ui_listening_address=undefined
return 0;}
GetAppVersion(){
if IsSupportGetAppVersion &&[[ -e $app_version_pathfile ]];then
app_version=$(eval "$get_app_version_cmd")
return 0
else
app_version=unknown
return 1
fi;}
ShowQPKGStates(){
DisplayAndCommitInfoWaitToLog 'QPKG enabled'
if IsQPKGEnabled;then
DisplayAndCommitOutcomeToLog true
else
DisplayAndCommitOutcomeToLog false
fi
if IsSupportAutoUpdate;then
DisplayAndCommitInfoWaitToLog 'application auto-update'
if IsAutoUpdate;then
DisplayAndCommitOutcomeToLog true
else
DisplayAndCommitOutcomeToLog false
fi
fi
if IsGitApp;then
DisplayAndCommitInfoToLog "active git branch: $(GetPathGitBranch "$qpkg_repo_path")"
fi;}
DisableOpkgDaemonStart(){
if [[ $orig_daemon_service_script != undefined &&-x $orig_daemon_service_script ]];then
$orig_daemon_service_script stop
chmod -x "$orig_daemon_service_script"
fi;}
CloneGitRepo(){
IsGitApp||return 0
local active_branch=$(GetPathGitBranch "$qpkg_repo_path")
local branch_depth=' --depth 1'
local branch_switch=false
local hide_advice_opt=' -c advice.detachedHead=false'
local opts=''
local progress_opt=''
[[ $source_git_branch_depth = single-branch ]]&&branch_depth=' --single-branch'
[[ $debug = true ]]&&progress_opt=' --progress'
WatchForGit||return
if [[ -d $qpkg_repo_path/.git ]];then
if [[ $active_branch != "$source_git_branch" ]];then
DisplayAndCommitInfoToLog "new git branch specified: $source_git_branch"
branch_switch=true
[[ $r_qpkg_name = nzbToMedia ]]&&BackupConfig
CleanLocalRepo
fi
fi
local branch_opt=" --branch ${source_git_branch}${branch_depth}"
if [[ ! -d $qpkg_repo_path/.git ]];then
opts=" clone${progress_opt}${branch_opt}${hide_advice_opt} $source_git_url $qpkg_repo_path"
DisplayRunAndLog "create $(FormatAsPackageName "$r_qpkg_name") from remote repository" "cd /tmp;/opt/bin/git${opts}" log:failure-only
if [[ $? -ne 0 ]];then
DisplayAndCommitErrorToAllLogs "'git clone' failed"
SetError;return
fi
else
if IsAutoUpdate;then
opts=" -C $qpkg_repo_path clean -f;/opt/bin/git -C $qpkg_repo_path reset --hard origin/$source_git_branch;/opt/bin/git -C $qpkg_repo_path pull"
DisplayRunAndLog "update $(FormatAsPackageName "$r_qpkg_name") from remote repository" "cd /tmp;/opt/bin/git${opts}" log:failure-only
if [[ $? -ne 0 ]];then
DisplayAndCommitErrorToAllLogs "'git pull' failed"
SetError;return
fi
fi
fi
active_branch=$(GetPathGitBranch "$qpkg_repo_path")
DisplayAndCommitInfoToLog "active git branch: $active_branch"
if [[ -z $active_branch ]];then
DisplayAndCommitErrorToAllLogs 'no active git branch found'
SetError;return
fi
[[ $branch_switch = true &&$r_qpkg_name = nzbToMedia ]]&&RestoreConfig
return 0;}
CleanLocalRepo(){
if [[ -z $r_qpkg_path ||-z $r_qpkg_name ]]||IsNotSourcedOnline;then
SetError;return
fi
(IsGitApp ||IsOnlineReleasePackage) &&DisplayRunAndLog 'clean local repository' "rm -rf \"$qpkg_repo_path\"" log:failure-only
IsVirtualPythonEnv &&[[ -d $venv_path ]]&&DisplayRunAndLog 'clean virtual Python environment' "rm -rf \"$venv_path\"" log:failure-only
IsUsePipCache &&[[ -d $pip_cache_path ]]&&DisplayRunAndLog 'clean PyPI cache' "rm -rf \"$pip_cache_path\"" log:failure-only
[[ -e $r_appl_version_store_pathfile ]]&&DisplayRunAndLog 'remove application version' "rm -f \"$r_appl_version_store_pathfile\"" log:failure-only
[[ -e $r_service_screen_log_pathfile ]]&&DisplayRunAndLog "remove previous 'screen' session log" "rm -f \"$r_service_screen_log_pathfile\"" log:failure-only
IsUseTemp &&[[ -d $r_qpkg_temp_path ]]&&DisplayRunAndLog 'clean temp path' "rm -rf \"$r_qpkg_temp_path\"" log:failure-only
MakePaths;}
WatchForGit(){
if IsNotQPKGInstalled Entware;then
DisplayAndCommitErrorToAllLogs "'git' unavailable: Entware is not installed"
SetError;return
fi
if IsNotQPKGEnabled Entware;then
DisplayAndCommitErrorToAllLogs "'git' unavailable: Entware is not enabled"
SetError;return
fi
if WatchForFileToAppear /opt/bin/git 300;then
export PATH=$r_opkg_path:$(/bin/sed "s|$r_opkg_path||"<<<"$PATH")
return 0
fi
SetError;return;}
RefreshPidFile(){
local -i a=0
if [[ -e $daemon_pid_pathfile &&! -d /proc/"$(<$daemon_pid_pathfile)" ]];then
rm -f "$daemon_pid_pathfile"
fi
if [[ $daemon_check_pathfile != undefined ]];then
a=$(FindPid "$daemon_check_pathfile")
else
a=$(FindPid "$daemon_exec_pathfile" "$daemon_script_pathfile")
fi
[[ -n $a &&$a -gt 0 ]]&&echo "$a">"$daemon_pid_pathfile";}
FindPid(){
[[ -n ${1:-} ]]||return
local -i a=0
local b=''
[[ -n ${2:-} &&$2 != undefined ]]&&b=$2
for a in $(/bin/pidof "$(/usr/bin/basename "$1")");do
[[ $a -gt 1 ]]||continue
[[ -d /proc/$a ]]||continue
[[ -e /proc/$a/cmdline &&-L /proc/$a/exe ]]||continue
[[ $(</proc/$a/cmdline) =~ $1 ||$(/usr/bin/readlink /proc/$a/exe) = "$1" ]]||continue
if [[ -n $b ]];then
[[ $(</proc/$a/cmdline) =~ $b ]]||continue
fi
printf '%s' "$a"
return
done
return 1;}
PauseForStartPid(){
local -i a=$(CalcAdaptiveSeconds "$wait_pid_start_seconds")
local -i i=0
if [[ $daemon_pidfile_is_managed_by_app = true ]];then
if WatchForFileToAppear "$daemon_pid_pathfile" "$(CalcAdaptiveSeconds "$watch_pidfile_start_seconds")";then
/bin/sleep 1
fi
fi
if [[ $recheck_daemon_pid_after_launch = true ]];then
DisplayAndCommitProcessWaitToLog "wait $a second$(Pluralise "$a") to confirm PID is still alive"
for((i=1;i<=a;i++));do
/bin/sleep 1
DisplayWait "$i,"
done
DisplayAndCommitOutcomeToLog 'done'
fi
RefreshPidFile||return;}
PauseForKillPid(){
local -i a=$(CalcAdaptiveSeconds "$wait_pid_kill_seconds")
local -i i=0
if [[ $recheck_daemon_pid_after_kill = true ]];then
DisplayAndCommitProcessWaitToLog "wait $a second$(Pluralise "$a") to confirm PID is still dead"
for((i=1;i<=a;i++));do
/bin/sleep 1
DisplayWait "$i,"
done
DisplayAndCommitOutcomeToLog 'done'
fi
! RefreshPidFile||return;}
WatchForAnyInterfaceUp(){
local -i a=$(CalcAdaptiveSeconds "$watch_interface_up_seconds")
local -i i=0
local found_interface=''
if ! IsAnyInterfaceUp;then
DisplayAndCommitProcessWaitToLog "watch for a network interface to become operational (no-more than $a second$(Pluralise "$a"))"
(
for((i=1;i<=a;i++));do
/bin/sleep 1
DisplayWait "$i,"
if IsAnyInterfaceUp;then
Display OK
CommitToLog "found in $i second$(Pluralise "$i")"
true
exit
fi
done
false
)
if [[ $? -ne 0 ]];then
DisplayAndCommitErrorToAllLogs "operational network interface not found (exceeded timeout: $a second$(Pluralise "$a"))"
return 1
fi
fi
DisplayAndCommitInfoToLog "operational network interface found: $found_interface"
return 0;}
WatchForDaemon(){
local -i a=$(CalcAdaptiveSeconds "$watch_pid_start_seconds")
local -i i=0
if [[ ! -e $daemon_pid_pathfile ]];then
DisplayAndCommitProcessWaitToLog "watch for daemon process name to appear (no-more than $a second$(Pluralise "$a"))"
(
for((i=1;i<=a;i++));do
/bin/sleep 1
DisplayWait "$i,"
RefreshPidFile
if IsDaemonActive;then
DisplayAndCommitOutcomeToLog OK
CommitDoneToLog "process name appeared in $i second$(Pluralise "$i")"
true
exit
fi
done
false
)
if [[ $? -ne 0 ]];then
DisplayAndCommitWarnToLog "process name not found (exceeded timeout: $a second$(Pluralise "$a"))"
return 1
fi
fi
return 0;}
WatchForFileToAppear(){
[[ -n $1 ]]||return
local -i a=0
local -i i=0
if [[ -n $2 ]];then
a=$2
else
a=30
fi
if [[ ! -e $1 ]];then
DisplayAndCommitProcessWaitToLog "watch for $1 to appear in filesystem (no-more than $a second$(Pluralise "$a"))"
(
for((i=1;i<=a;i++));do
/bin/sleep 1
DisplayWait "$i,"
if [[ -e $1 ]];then
Display OK
CommitToLog "visible after $i second$(Pluralise "$i")"
true
exit
fi
done
false
)
if [[ $? -ne 0 ]];then
DisplayAndCommitErrorToAllLogs "file $1 not found (exceeded timeout: $a second$(Pluralise "$a"))"
return 1
fi
fi
DisplayAndCommitInfoToLog "file exists: $1"
return 0;}
ViewLog(){
if [[ -e $r_service_log_pathfile ]];then
if [[ -e /opt/bin/less ]];then
LESSSECURE=1 /opt/bin/less +G --quit-on-intr --tilde --LINE-NUMBERS --RAW-CONTROL-CHARS --prompt ' use arrow-keys to scroll up-down left-right, press Q to quit' "$r_service_log_pathfile"
else
/bin/cat --number "$r_service_log_pathfile"
fi
else
Display "service log not found: $r_service_log_pathfile"
SetError;return
fi
return 0;}
EnsureConfigFileExists(){
IsNotSupportReset&&return
if IsNotConfigFound&&IsDefaultConfigFound;then
DisplayAndCommitInfoToLog 'no configuration file found: using default'
cp "${qpkg_ini_default_pathfile:?undefined}" "${qpkg_ini_pathfile:?undefined}"
fi;}
SaveAppVersion(){
[[ $r_appl_version_store_pathfile != undefined ]]&&echo "$app_version">"$r_appl_version_store_pathfile";}
DisplayRunAndLog(){
local -r r_log_pathfile=$(/bin/mktemp /var/log/"${FUNCNAME[0]}"_XXXXXX)
local -i z=0
DisplayAndCommitProcessWaitToLog "$1"
Executer "${2:?empty}" "$r_log_pathfile" "${4:-false}"
z=$?
if [[ $z -eq 0 ]];then
if [[ $debug = true ]];then
CommitToLog OK
else
DisplayAndCommitToLog OK
fi
[[ ${3:-} != log:failure-only ]]&&AddFileToDebug "$r_log_pathfile"
else
if [[ $debug = true ]];then
CommitToLog failed
else
DisplayAndCommitToLog failed
fi
AddFileToDebug "$r_log_pathfile"
fi
[[ -e $r_log_pathfile ]]&&rm -f "$r_log_pathfile"
return $z;}
Executer(){
local -r r_log_pathfile=$(/bin/mktemp /var/log/"${FUNCNAME[0]}"_XXXXXX)
local run_in_screen=${3:-false}
local -i z=0
FormatAsCommand "${1:?empty}">"${2:?empty}"
if [[ $debug = true ]];then
local exec_msg='{ exec'
[[ $run_in_screen = true ]]&&exec_msg+=" (in 'screen' session)"
exec_msg+=':'
if IsHaveSingleQuote "$1";then
exec_msg+=" \"$1\""
else
exec_msg+=" '$1'"
fi
Display
Display "$exec_msg"
fi
if [[ $run_in_screen = true ]];then
FormatAsCommand "$1">>"$r_service_screen_log_pathfile"
/usr/sbin/screen -c "$r_screen_conf_pathfile" -dmLS "$r_qpkg_name" sh -c "$1"
z=$?
elif [[ $debug = true ]];then
eval "$1 2>&1|/usr/bin/tee $r_log_pathfile"
z=${PIPESTATUS[0]}
else
(eval "$1">"$r_log_pathfile" 2>&1)
z=$?
fi
if [[ -e $r_log_pathfile ]];then
FormatAsResultAndStdout "$z" "$(<"$r_log_pathfile")">>"$2"
else
FormatAsResultAndStdout "$z" '<null>'>>"$2"
fi
if [[ $debug = true ]];then
exec_msg='} exec: completed'
if [[ $z -eq 0 ]];then
Display "$exec_msg OK ($z)"
else
Display "$exec_msg with errors ($z)"
fi
fi
[[ -e $r_log_pathfile ]]&&rm -f "$r_log_pathfile"
return $z;}
ShowEnabled(){
DisplayAndCommitInfoToLog "$(FormatAsPackageName "$r_qpkg_name") QPKG is enabled.";}
ShowDisabled(){
DisplayAndCommitToLog "= $(FormatAsPackageName "$r_qpkg_name") QPKG is disabled.";}
ShowDisabledPrompt(){
DisplayAndCommitToLog "= $(FormatAsPackageName "$r_qpkg_name") QPKG is disabled. Please enable it first with: $0 enable";}
ShowEnableFailed(){
DisplayAndCommitToLog "= $(FormatAsPackageName "$r_qpkg_name") QPKG enable failed.";}
ShowDisableFailed(){
DisplayAndCommitToLog "= $(FormatAsPackageName "$r_qpkg_name") QPKG disable failed.";}
AddFileToDebug(){
[[ -e ${1:?no filename supplied} ]]||return
local a=''
local debug_was_set=$debug
debug=false
DebugAsLog ''
DebugAsLog 'adding external log to main log ...'
DebugExtLogMinorSeparator
DebugAsLog "$(FormatAsLogFilename "$1")"
while read -r a;do
DebugAsLog "$a"
done<"$1"
DebugExtLogMinorSeparator
debug=$debug_was_set;}
FormatAsLogFilename(){
Display "log file: '${1:-}'";}
FormatAsCommand(){
Display "command: '${1:-}'";}
FormatAsResultAndStdout(){
if [[ ${1:-0} -eq 0 ]];then
echo "= result_code: $(FormatAsExitcode "$1")"
else
echo "= result_code: $(FormatAsExitcode "$1")"
fi
DebugBulletSeparatorWithText 'stdout & stderr begins below'
echo "${2:-}"
DebugBulletSeparatorWithText 'stdout & stderr is complete';}
FormatAsExitcode(){
echo "[${1:-}]";}
FormatAsPackageName(){
echo "'${1:-}'";}
DebugExtLogMinorSeparator(){
DebugAsLog "$(DebugMinorSeparator)";}
DebugBulletSeparatorWithText(){
local a=''
[[ -n ${1:-} ]]&&a=" ${1:-} "
local b=$(((r_debug_log_datawidth-${#a})/2))
local c=$((r_debug_log_datawidth-${#a}-b))
eval printf '%0.s•' "{1..$b}";printf '%s' "$a";eval printf '%0.s•' "{1..$c}";echo;}
DebugMinorSeparator(){
eval printf '%0.s-' "{1..$r_debug_log_datawidth}";}
DebugAsLog(){
[[ -n ${1:-} ]]||return
DebugThis "(LL) $1";}
DebugThis(){
[[ $debug = true ]]&&Display "${1:-}"
WriteAsDebug "${1:-}";}
WriteAsDebug(){
WriteToLog dbug "${1:-}";}
WriteToLog(){
printf "%-4s: %s\n" "$(StripANSICodes "${1:-}")" "$(StripANSICodes "${2:-}")">>"$r_service_log_pathfile";}
StripANSICodes(){
if [[ -e /opt/bin/sed &&-L /opt/etc/passwd ]];then
/opt/bin/sed -r 's/\x1b\[[0-9;]*m//g'<<<"${1:-}"
else
echo "${1:-}"
fi;}
Capitalise(){
echo "$(Uppercase ${1:0:1})${1:1}";}
Uppercase(){
/bin/tr 'a-z' 'A-Z'<<<"$1";}
ReWriteUIPorts(){
[[ $get_daemon_port_cmd != undefined ]]&&return
DisplayAndCommitProcessWaitToLog 'update QPKG icon with UI ports'
/sbin/setcfg $r_qpkg_name Web_Port "$ui_port" -f /etc/config/qpkg.conf
if IsSSLEnabled;then
/sbin/setcfg $r_qpkg_name Web_SSL_Port "$ui_port_secure" -f /etc/config/qpkg.conf
else
/sbin/setcfg $r_qpkg_name Web_SSL_Port '-2' -f /etc/config/qpkg.conf
fi
DisplayAndCommitOutcomeToLog OK;}
WatchForPortsActive(){
local a=''
DisplayAndCommitInfoToLog "daemon listening address: $ui_listening_address"
if [[ $daemon_port -ne 0 ]];then
DisplayAndCommitInfoToLog "daemon port: $daemon_port"
if IsPortResponds $daemon_port;then
a="daemon port $daemon_port"
fi
else
DisplayAndCommitInfoWaitToLog 'HTTPS port enabled'
if IsSSLEnabled;then
DisplayAndCommitOutcomeToLog true
DisplayAndCommitInfoToLog "HTTPS port: $ui_port_secure"
if IsPortSecureResponds $ui_port_secure;then
a="HTTPS port $ui_port_secure"
fi
else
DisplayAndCommitOutcomeToLog false
fi
DisplayAndCommitInfoToLog "HTTP port: $ui_port"
if IsPortResponds $ui_port;then
[[ -n $a ]]&&a+=' and '
a+="HTTP port $ui_port"
fi
fi
if [[ -z $a ]];then
DisplayAndCommitWarnToLog 'no response on configured port(s)'
return 1
else
ReWriteUIPorts
return 0
fi;}
GetPythonVer(){
local a=''
a=$(GetThisBinPath ${1:-python} &>/dev/null &&${1:-python} -V 2>&1|/bin/sed 's|^Python ||;s|\.||g')
[[ -n $a ]]&&echo "${a:0:3}";}
GetThisBinPath(){
[[ -n ${1:?null} ]]&&command -v "$1" 2>&1;}
RenameSharedObjectFile(){
[[ -n ${1:-} ]]||return
if [[ -e $(GetModulePath)/$(GetOriginalModuleSOFilename "_$1") ]];then
mv "$(GetModulePath)/$(GetOriginalModuleSOFilename "_$1")" "$(GetModulePath)/$(GetFixedModuleSOFilename "_$1")"
DisplayAndCommitToLog "= renamed module: _$1"
fi
if [[ -e $(GetModulePath)/$1/$(GetOriginalModuleSOFilename "$1") ]];then
mv "$(GetModulePath)/$1/$(GetOriginalModuleSOFilename "$1")" "$(GetModulePath)/$1/$(GetFixedModuleSOFilename "$1")"
DisplayAndCommitToLog "= renamed module: $1/$1"
fi
if [[ -e $(GetModulePath)/$(GetOriginalModuleSOFilename "$1") ]];then
mv "$(GetModulePath)/$(GetOriginalModuleSOFilename "$1")" "$(GetModulePath)/$(GetFixedModuleSOFilename "$1")"
DisplayAndCommitToLog "= renamed module: $1"
fi
return 0;}
GetOriginalModuleSOFilename(){
[[ -z $pyver ]]&&pyver=$(GetPythonVer)
[[ -n ${1:-} ]]&&echo "$1.cpython-$pyver-$r_nas_arch-linux-gnu.so";}
GetFixedModuleSOFilename(){
[[ -z $pyver ]]&&pyver=$(GetPythonVer)
[[ -n ${1:-} ]]&&echo "$1.cpython-$pyver.so";}
GetModulePath(){
[[ -z $pyver ]]&&pyver=$(GetPythonVer)
echo "$venv_path/lib/python${pyver:0:1}.${pyver:1:2}/site-packages";}
GetQpkgArch(){
if [[ $(get_display_name) = 'TS-269H' ]];then
printf i53
return
fi
SetNasArch
SetOsFirmwareVer
SetHardwarePlatform
case $r_nas_arch in
x86_64)
[[ $r_nas_firmware_ver -ge 430 ]]&&printf i64||printf i86;;
i686|x86)
printf i86;;
armv5tel)
printf a19;;
armv7l)
case $r_nas_platform in
ARM_MS)
printf a31;;
ARM_AL)
printf a41;;
*)printf unknown
esac;;
aarch64)
printf a64;;
*)printf unknown
esac;}
GetNasArch(){
/bin/uname -m;}
GetOsFirmwareVer(){
/sbin/getcfg System Version -d undefined -f /etc/config/uLinux.conf|tr -d '.';}
GetHardwarePlatform(){
/sbin/getcfg '' Platform -d undefined -f /etc/platform.conf;}
parse_yaml(){
local s='[[:space:]]*' w='[a-zA-Z0-9_]*' fs=$(echo @|tr @ '\034')
/bin/sed -ne "s|^\($s\):|\1|" \
-e "s|^\($s\)\($w\)$s:$s[\"']\(.*\)[\"']$s\$|\1$fs\2$fs\3|p" \
-e "s|^\($s\)\($w\)$s:$s\(.*\)$s\$|\1$fs\2$fs\3|p"  $1 |
/bin/awk -F$fs '{
indent = length($1)/2;
vname[indent] = $2;
for (i in vname) {if (i>indent) {delete vname[i]}}
if (length($3)>0) {
vn="";for (i=0;i<indent;i++) {vn=(vn)(vname[i])("_")}
printf("%s%s%s=\"%s\"\n", "'${2:-}'",vn, $2, $3);;}
}';}
GetKeyFromYAML(){
[[ -n ${1:-} &&-n ${2:-} ]]||return
[[ -e $2 ]]||return
set -o pipefail
parse_yaml "$2"|grep "${1/:/_}"|cut -d '"' -f2;}
GetKeyFromTOML(){
[[ -n ${1:-} &&-n ${2:-} ]]||return
[[ -e $2 ]]||return
set -o pipefail
/bin/grep "^$1 " "$2"|cut -d '=' -f2|tr -d ' \"';}
SetNasArch(){
[[ ${r_nas_arch:-unset} = unset ]]&&readonly r_nas_arch=$(GetNasArch);}
SetQpkgArch(){
[[ ${r_nas_qpkg_arch:-unset} = unset ]]&&readonly r_nas_qpkg_arch=$(GetQpkgArch);}
SetOsFirmwareVer(){
[[ ${r_nas_firmware_ver:-unset} = unset ]]&&readonly r_nas_firmware_ver=$(GetOsFirmwareVer);}
SetHardwarePlatform(){
[[ ${r_nas_platform:-unset} = unset ]]&&readonly r_nas_platform=$(GetHardwarePlatform);}
IsQNAP(){
if [[ ! -e /etc/init.d/functions ]];then
Display 'QTS functions missing (is this a QNAP NAS?)'
SetError;return
fi
return 0;}
IsQPKGInstalled(){
[[ "$(</etc/config/qpkg.conf)" =~ "[${1:-$r_qpkg_name}]" ]];}
IsNotQPKGInstalled(){
! IsQPKGInstalled "${1:-$r_qpkg_name}";}
IsQPKGEnabled(){
[[ $(/sbin/getcfg ${1:-$r_qpkg_name} Enable -u -d FALSE -f /etc/config/qpkg.conf) = TRUE ]];}
IsNotQPKGEnabled(){
! IsQPKGEnabled "${1:-$r_qpkg_name}";}
IsSupportBackup(){
[[ $qpkg_backup_pathfile != undefined ]];}
IsSupportReset(){
[[ $qpkg_ini_pathfile != undefined ]];}
IsNotSupportReset(){
! IsSupportReset;}
IsSupportActions(){
[[ -e $r_service_action_pathfile ||-e $r_service_result_pathfile ]];}
IsSupportGetAppVersion(){
[[ $get_app_version_cmd != undefined &&$app_version_pathfile != undefined ]];}
IsVirtualPythonEnv(){
[[ $venv_path != undefined ]];}
IsGitApp(){
[[ $source_git_url != undefined &&$source_git_branch != undefined &&$qpkg_repo_path != undefined ]];}
IsUsePipCache(){
[[ $pip_cache_path != undefined ]];}
IsOnlineReleasePackage(){
[[ $source_url != undefined ]];}
IsReleaseAnArchive(){
[[ $package_is_exec != undefined &&$package_is_exec = false ]];}
IsSupportAutoUpdate(){
[[ $can_restart_to_update = true ]];}
IsNotSourcedOnline(){
! IsSourcedOnline;}
IsSourcedOnline(){
IsGitApp ||IsUsePipCache ||IsOnlineReleasePackage;}
IsUseTemp(){
[[ $r_qpkg_temp_path != undefined ]];}
IsSSLEnabled(){
eval "$get_ui_port_secure_enabled_test_cmd";}
IsNotDaemon(){
! IsDaemon;}
IsDaemon(){
[[ $daemon_exec_pathfile != undefined ]];}
IsDaemonCheck(){
[[ $daemon_check_pathfile != undefined ]];}
ShowDaemonState(){
if [[ -e $daemon_pid_pathfile &&-s $daemon_pid_pathfile ]];then
DisplayAndCommitInfoToLog "daemon PID: $(<"$daemon_pid_pathfile")"
else
DisplayAndCommitInfoToLog 'daemon PID: none'
fi;}
IsNotDaemonActive(){
! IsDaemonActive;}
IsDaemonActive(){
if [[ -e $daemon_pid_pathfile &&-d /proc/"$(<$daemon_pid_pathfile)" ]];then
if IsDaemonCheck;then
[[ $(/usr/bin/readlink /proc/"$(<$daemon_pid_pathfile)"/exe) = "$daemon_check_pathfile" ]]
else
[[ $(</proc/"$(<$daemon_pid_pathfile)"/cmdline) =~ $daemon_exec_pathfile ]]
fi
else
false
fi;}
IsPortAvailable(){
local port=${1//[!0-9]/}
[[ -n $port &&$port -gt 0 ]]||return 0
/usr/sbin/lsof -i :"$port" -sTCP:LISTEN>/dev/null 2>&1&&return 1
return 0;}
IsNotPortAvailable(){
! IsPortAvailable "${1:-0}";}
IsPortResponds(){
local -i a=${1//[!0-9]/}
local -i b=$(CalcAdaptiveSeconds "$watch_port_check_seconds")
local -i c=0
if [[ -z $a ]];then
Display 'empty port: not testing for response'
return 1
elif [[ $a -eq 0 ]];then
Display 'port 0: not testing for response'
return 1
fi
DisplayAndCommitProcessWaitToLog "test for port $a response (no-more than $b second$(Pluralise "$b"))"
while true;do
if ! IsDaemonActive;then
DisplayAndCommitToLog 'process not active'
break
fi
/sbin/curl --silent --fail --max-time 1 http://localhost:"$a" &>/dev/null
case $? in
0|22|52)
DisplayAndCommitOutcomeToLog OK
CommitDoneToLog "responded in $c second$(Pluralise "$c")"
return 0;;
28)
:;;
7)
/bin/sleep 1;;
*):
esac
((c++))
DisplayWait "$c,"
if [[ $c -ge $b ]];then
DisplayAndCommitOutcomeToLog failed
CommitErrorToSysLog "port $a failed to respond after $c second$(Pluralise "$c")"
break
fi
done
return 1;}
IsPortSecureResponds(){
local -i a=${1//[!0-9]/}
local -i b=$(CalcAdaptiveSeconds "$watch_port_check_seconds")
local -i c=0
if [[ -z $a ]];then
Display 'empty port: not testing for response'
return 1
elif [[ $a -eq 0 ]];then
Display 'port 0: not testing for response'
return 1
fi
DisplayAndCommitProcessWaitToLog "test for secure port $a response (no-more than $b second$(Pluralise "$b"))"
while true;do
if ! IsDaemonActive;then
DisplayAndCommitToLog 'process not active'
break
fi
/sbin/curl --silent --insecure --fail --max-time 1 https://localhost:"$a" &>/dev/null
case $? in
0|22|52)
Display OK
CommitToLog "port responded after $c second$(Pluralise "$c")"
return 0;;
35)
DisplayAndCommitToLog 'TLS inactive'
break;;
28)
:;;
7)
/bin/sleep 1;;
*):
esac
((c++))
DisplayWait "$c,"
if [[ $c -ge $b ]];then
DisplayAndCommitToLog failed
CommitErrorToSysLog "secure port $a failed to respond after $c second$(Pluralise "$c")"
break
fi
done
return 1;}
IsConfigFound(){
[[ $qpkg_ini_pathfile != undefined &&-e $qpkg_ini_pathfile ]];}
IsNotConfigFound(){
! IsConfigFound;}
IsDefaultConfigFound(){
[[ $qpkg_ini_default_pathfile != undefined &&-e $qpkg_ini_default_pathfile ]];}
IsVirtualPythonEnvExist(){
[[ -e $venv_path/bin/activate ]];}
IsNotVirtualPythonEnvExist(){
! IsVirtualPythonEnvExist;}
IsOsCanSecureDownload(){
[[ $r_nas_firmware_ver -ge 500 ]];}
IsSiteUp(){
[[ -n $1 &&$1 != undefined ]]||return
local a=$(cut -d'/' -f3<<<"$1"|cut -d':' -f1)
[[ -n $a &&$a != undefined ]]||return
local -i n=0
for((n=0;n<20;n++));do
/bin/ping -c 1 -w 1 "$a"&&return 0
/bin/sleep 5
done
return 1
} &>/dev/null
IsHaveSingleQuote(){
/bin/grep "'"<<<"${1:-}"
} &>/dev/null
IsCheckNetworkBeforeStart(){
[[ $check_network_before_start = true ]];}
IsInterfaceUp(){
[[ -n ${1:-} ]]||return
[[ -n $(/bin/ip a|/bin/sed -rn '/: '"$1"':.*state UP/{N;N;s/.*inet (\S*).*/\1/p}') ]];}
IsAnyInterfaceUp(){
local a=''
found_interface=null
for a in $(/bin/grep ':' /proc/net/dev|cut -d':' -f1|tr -d ' ');do
[[ $a != 'lo' ]]||continue
[[ ! $a =~ 'docker' ]]||continue
[[ ! $a =~ 'bond' ]]||continue
[[ ! $a =~ 'dummy' ]]||continue
[[ ! $a =~ 'lxc' ]]||continue
[[ ! $a =~ 'lxd' ]]||continue
if IsInterfaceUp "$a";then
echo "interface $a is operational"
found_interface=$a
return
fi
done
return 1
} &>/dev/null
RequestLatestReleaseFilename(){
[[ -n ${1:-} &&${1:-} != undefined ]]||return
local a="$curl_insecure_opt --silent --max-time $get_remote_filename_timeout_seconds --limit-rate 1K --location --dump-header -"
local b=$(/sbin/curl${a} "${1/https/http}"|/bin/grep -v 'Location:'|/bin/grep filename|cut -d';' -f2|cut -d'=' -f2|/bin/sed -e 's|\r||g')
[[ -n ${2:-} &&${2:-} != undefined ]]&&b=$(/bin/grep -e "$2"<<<"$b")
local -i c=$(wc -l<<<"$b")
case $c in
0)
printf '%s' "${FUNCNAME[0]}(): zero filenames matched"
return 1;;
1)
printf '%s' "$b"
return 0;;
*)printf '%s' "${FUNCNAME[0]}(): multiple filenames matched"
return 1
esac
} 2>/dev/null
RequestLatestReleaseURL(){
[[ -n ${1:-} &&${1:-} != undefined ]]||return
local a="$curl_insecure_opt --silent --max-time $get_remote_filename_timeout_seconds --location"
local b=$(/sbin/curl${a} "$1"|/bin/grep browser_download_url|cut -d\" -f4)
[[ -n ${2:-} &&${2:-} != undefined ]]&&b=$(/bin/grep -e "$2"<<<"$b")
local -i c=$(wc -l<<<"$b")
case $c in
0)
printf '%s' "${FUNCNAME[0]}(): zero URLs matched"
return 1;;
1)
printf '%s' "$b"
return 0;;
*)printf '%s' "${FUNCNAME[0]}(): multiple URLs matched"
return 1
esac
} 2>/dev/null
DownloadReleasePackage(){
[[ -n ${1:-} &&${1:-} != undefined ]]||return
[[ -n ${2:-} &&${2:-} != undefined ]]||return
local a=''
local b=$curl_insecure_opt
local c=$2
[[ $debug = false ]]&&b+=' --silent'
if [[ -e $c ]];then
a='refresh existing release package (only-if-newer)'
b+=" --time-cond $c"
else
a='download latest release package'
fi
b+=" --show-error --max-time 300 --location --output $c"
DisplayRunAndLog "$a" "/sbin/curl${b} '$1'" log:failure-only;}
ExtractReleasePackage(){
[[ -n ${1:-} &&${1:-} != undefined ]]||return
local release_package_name_ref_pathfilename=''
local release_package_pathfile=$1
local tar_opts=''
local tar_verbose=''
local unzip_opts=''
local unzip_verbose=''
[[ -n ${2:-} &&${2:-} != undefined ]]&&release_package_name_ref_pathfilename=$2
if [[ $debug = true ]];then
tar_verbose=' --verbose'
fi
if [[ -e $release_package_pathfile ]];then
tar_opts="$tar_verbose --extract --gzip --file=$release_package_pathfile --directory=$qpkg_repo_path"
unzip_opts="$unzip_verbose -o $release_package_pathfile -d $qpkg_repo_path"
DisplayRunAndLog 'extract from release package' "/usr/bin/unzip${unzip_opts} 2>/dev/null||/bin/tar${tar_opts}" log:failure-only
if [[ $compare_release_filename = true &&-n $release_package_name_ref_pathfilename ]];then
if [[ ! -e $release_package_name_ref_pathfilename ]];then
DisplayRunAndLog 'create release package name reference' "/bin/touch $release_package_name_ref_pathfilename" log:failure-only
fi
fi
fi;}
MakeExecReleasePackage(){
[[ -n ${1:-} &&${1:-} != undefined ]]||return
local release_package_name_ref_pathfilename=''
local release_package_pathfile=$1
[[ -n ${2:-} &&${2:-} != undefined ]]&&release_package_name_ref_pathfilename=$2
if [[ -e $release_package_pathfile ]];then
DisplayRunAndLog 'copy release package' "cp -f $release_package_pathfile $daemon_exec_pathfile" log:failure-only
[[ ! -x $daemon_exec_pathfile ]]&&DisplayRunAndLog 'make release package executable' "chmod +x $daemon_exec_pathfile" log:failure-only
if [[ $compare_release_filename = true &&-n $release_package_name_ref_pathfilename ]];then
if [[ ! -e $release_package_name_ref_pathfilename ]];then
DisplayRunAndLog 'create release package name reference' "/bin/touch $release_package_name_ref_pathfilename" log:failure-only
fi
fi
fi;}
ResetServiceAction(){
SetServiceAction reset-action
SetServiceResultAsOK;}
SetServiceAction(){
service_action=${1:-none}
CommitServiceAction
SetServiceResultAsInProgress
DisplayAndCommitActionToLog;}
SetServiceResultAsOK(){
service_result=ok
CommitServiceResult
DisplayAndCommitResultToLog;}
SetServiceResultAsFailed(){
service_result=failed
CommitServiceResult
DisplayAndCommitResultToLog;}
SetServiceResultAsAborted(){
service_result=aborted
CommitServiceResult
DisplayAndCommitResultToLog;}
SetServiceResultAsInProgress(){
service_result=in-progress
CommitServiceResult;}
CommitServiceAction(){
if IsNotStatus&&IsNotLog&&IsNotNone;then
[[ $r_service_action_pathfile != undefined ]]&&echo "$service_action">"$r_service_action_pathfile"
fi;}
CommitServiceResult(){
if IsNotStatus&&IsNotLog&&IsNotNone;then
[[ $r_service_result_pathfile != undefined ]]&&echo "$service_result">"$r_service_result_pathfile"
fi;}
SetDaemonWasActive(){
_daemon_was_active=true;}
DaemonWasNotActive(){
[[ ${_daemon_was_active:=false} = false ]];}
SetStatusGet(){
_get_status_flag=true;}
IsStatus(){
[[ ${_get_status_flag:=false} = true ]];}
IsNotStatus(){
! IsStatus;}
SetError(){
IsError&&return
_error_flag=true
false;}
UnsetError(){
IsNotError&&return
_error_flag=false;}
IsError(){
[[ ${_error_flag:=false} = true ]];}
IsNotError(){
! IsError;}
IsReinstall(){
[[ ${REINSTALL_QPKG:=false} = true ]];}
IsUpgrade(){
[[ ${UPGRADE_QPKG:=false} = true ]];}
IsUninstall(){
[[ ${UNINSTALL_QPKG:=false} = true ]];}
IsStart(){
[[ $service_action = start ]];}
IsNotStart(){
! IsStart;}
IsStop(){
[[ $service_action = stop ]];}
IsRestart(){
[[ $service_action = restart ]];}
IsNotRestart(){
! IsRestart;}
IsLog(){
[[ $service_action = log ]];}
IsNotLog(){
! IsLog;}
IsNone(){
[[ $service_action = none ]];}
IsNotNone(){
! IsNone;}
IsClean(){
[[ $service_action = clean ]];}
IsNotClean(){
! IsClean;}
IsUnsupported(){
[[ $service_action = unsupported ]];}
IsInProgress(){
[[ $service_result = in-progress ]];}
IsPathEmpty(){
local a=${1:-}
[[ -n $a &&-d $a ]]||return
rmdir "$a" &>/dev/null &&mkdir "$a";}
ShowAsNote(){
Display "$(TextBrightYellow note): ${1:-}"
}>&2
ShowAsImportant(){
Display "$(TextBrightYellowBlink note): ${1:-}"
}>&2
ShowAsError(){
Display "$(TextBrightRed derp): ${1:-}"
}>&2
ShowAsURL(){
TextUnderlinedCyan "${1:?${FUNCNAME[0]}(): $e_nourl}";}
DisplayAndCommitInfoToAllLogs(){
DisplayAndCommitInfoToLog "${1:-}"
CommitInfoToSysLog "${1:-}";}
CommitWarnToAllLogs(){
CommitWarnToLog "${1:-}"
CommitWarnToSysLog "${1:-}";}
DisplayAndCommitErrorToAllLogs(){
DisplayAndCommitErrorToLog "${1:-}"
CommitErrorToSysLog "${1:-}";}
DisplayAndCommitInfoToLog(){
DisplayAndCommitToLog "- ${1:-}";}
DisplayAndCommitWarnToLog(){
DisplayAndCommitToLog "w ${1:-}";}
DisplayAndCommitErrorToLog(){
DisplayAndCommitToLog "! ${1:-}";}
DisplayAndCommitDoneToLog(){
DisplayAndCommitToLog "= ${1:-}";}
DisplayAndCommitOutcomeToLog(){
DisplayAndCommitToLog "${1:-}";}
DisplayAndCommitRetryToLog(){
DisplayAndCommitToLog "~ ${1:-}";}
DisplayAndCommitActionToLog(){
[[ $service_action = unspecified ]]&&return
starttime=$(ConvertNowToNanoseconds)
local msg="- source: $(/usr/bin/basename "$0"), action: $service_action, time: $(ConvertNowToFullDate), load: $(GetSysLoad1MinAverage)"
msg="$(/bin/tr -s ' '<<<"$msg") "
local a=DisplayAndCommitToLog
if IsNotStatus&&IsNotLog&&IsNotNone;then
IsUnsupported &&a=CommitToLog
CommitToLog '•'
$a "$(TextInverse "$msg")"
$a "- package: $r_qpkg_version, service: $r_service_script_version, library: $r_service_library_version"
fi;}
DisplayAndCommitResultToLog(){
[[ $service_action = unspecified ]]&&return
local msg="= source: $(/usr/bin/basename "$0"), action: $service_action, time: $(ConvertNowToFullDate), result: $(Uppercase "$service_result"), elapsed: $(FormatAsDuration "$(CalcMilliDifference "$starttime" "$(ConvertNowToNanoseconds)")"), load: $(GetSysLoad1MinAverage)"
msg="$(/bin/tr -s ' '<<<"$msg") "
local a=DisplayAndCommitToLog
if IsNotStatus&&IsNotLog&&IsNotNone;then
IsUnsupported &&a=CommitToLog
case $service_result in
ok)
$a "$(TextBlackOnGreen "$msg")";;
failed)
$a "$(TextBlackOnRed "$msg")";;
*)$a "$(TextBlackOnYellow "$msg")"
esac
fi;}
DisplayAndCommitToLog(){
Display "${1:-}"
CommitToLog "${1:-}";}
DisplayAndCommitProcessWaitToLog(){
	DisplayWait "> ${1:-}:"
	CommitWaitToLog "> ${1:-}:";}
DisplayAndCommitInfoWaitToLog(){
DisplayWait "- ${1:-}:"
CommitWaitToLog "- ${1:-}:";}
CommitInfoToLog(){
CommitToLog "- ${1:-}";}
CommitDoneToLog(){
CommitToLog "= ${1:-}";}
CommitInfoToSysLog(){
CommitToSysLog "${1:-}." 4;}
CommitWarnToSysLog(){
CommitToSysLog "${1:-}. Please check the service log for more information." 2;}
CommitErrorToSysLog(){
CommitToSysLog "${1:-}. Please check the service log for more information." 1;}
CommitToLog(){
if IsNotStatus&&IsNotLog&&IsNotNone;then
[[ ${1:-} = '•' &&! -s "$r_service_log_pathfile" ]]||echo -e "${1:-}">>"$r_service_log_pathfile"
fi;}
CommitWaitToLog(){
if IsNotStatus&&IsNotLog&&IsNotNone;then
printf '%s' "${1:-} ">>"$r_service_log_pathfile"
fi;}
CommitToSysLog(){
if IsNotStatus&&IsNotLog&&IsNotNone;then
if [[ -z ${1:-} ||-z ${2:-} ]];then
SetError;return
fi
/sbin/write_log "[$r_qpkg_name] $1" "$2"
fi;}
DisplayAsHelp(){
printf '  %-22s  - %s\n' "${1:-}" "${2:-}.";}
Display(){
echo "${1:-}";}
DisplayWait(){
echo -n "${1:-} ";}
TextBrightWhite(){
printf '\033[1;97m%s\033[0m' "${1:-}"
} 2>/dev/null
TextBrightRed(){
printf '\033[1;31m%s\033[0m' "${1:-}"
} 2>/dev/null
TextBrightYellow(){
printf '\033[1;33m%s\033[0m' "${1:-}"
} 2>/dev/null
TextBrightYellowBlink(){
printf '\033[1;5;33m%s\033[0m' "${1:-}"
} 2>/dev/null
TextBlackOnGreen(){
printf '\033[30;42m%s\033[0m' "${1:-}"
} 2>/dev/null
TextBlackOnRed(){
printf '\033[30;41m%s\033[0m' "${1:-}"
} 2>/dev/null
TextBlackOnYellow(){
printf '\033[30;43m%s\033[0m' "${1:-}"
} 2>/dev/null
TextUnderlinedCyan(){
printf '\033[4;36m%s\033[0m' "${1:-}"
} 2>/dev/null
TextInverse(){
printf '\033[7m%s\033[0m' "${1:-}"
} 2>/dev/null
Pluralise(){
[[ ${1:-0} -ne 1 ]]&&printf s;}
CalcMilliDifference(){
echo "$(((${2:-1}-${1:-0})/1000000))";}
ConvertAsSmartDate(){
[[ -n ${1:-} ]]||return
local a=$(/bin/sed 's/[^0-9]*//g'<<<"$1")
local b=''
case ${#a} in
6)
b=$(/bin/date -d "${a::2}-${a:2:2}-${a:4:2}" "$r_extended_datetime_format");;
8)
b=$(/bin/date -d ${a::4}-${a:4:2}-${a:6:2} "$r_extended_datetime_format");;
10)
b=$(/bin/date -d @"$a" "$r_full_datetime_format")
esac
if [[ -n $b ]];then
printf '%s (%s)' "$1" "$b"
else
printf '%s' "$1"
fi
return
} 2>/dev/null
ConvertNowToFullDate(){
/bin/date "$r_full_datetime_format"
} 2>/dev/null
ConvertNowToSeconds(){
/bin/date +%s
} 2>/dev/null
ConvertNowToNanoseconds(){
/bin/date +%s%N
} 2>/dev/null
FormatAsThous(){
local rightside_group=''
local foutput=''
local remainder=$(/bin/sed 's/[^0-9]*//g'<<<"${1:-}")
while [[ ${#remainder} -gt 0 ]];do
rightside_group=${remainder:${#remainder}<3?0:-3}
if [[ -z $foutput ]];then
foutput=$rightside_group
else
foutput=$rightside_group,$foutput
fi
if [[ ${#rightside_group} -eq 3 ]];then
remainder=${remainder%???}
else
break
fi
done
printf '%s' "$foutput"
return 0;}
FormatAsDuration(){
if [[ ${1:-0} -lt 10000 ]];then
printf '%s' "$(FormatAsThous "${1:-0}")ms"
else
FormatSecsToHoursMinutesSecs "$(((${1:-0}+500)/1000))"
fi;}
FormatSecsToHoursMinutesSecs(){
((h=${1:-0}/3600))
((m=(${1:-0}%3600)/60))
((s=${1:-0}%60))
printf '%01dh:%02dm:%02ds\n' "$h" "$m" "$s"
} 2>/dev/null
IsAutoUpdateMissing(){
[[ $(/sbin/getcfg $r_qpkg_name Auto_Update -f /etc/config/qpkg.conf) = '' ]];}
IsAutoUpdate(){
IsSupportAutoUpdate &&[[ $(/sbin/getcfg $r_qpkg_name Auto_Update -u -f /etc/config/qpkg.conf) = TRUE ]];}
IsNotAutoUpdate(){
! IsAutoUpdate;}
EnableAutoUpdate(){
StoreAutoUpdateSelection true;}
DisableAutoUpdate(){
StoreAutoUpdateSelection false;}
StoreAutoUpdateSelection(){
/sbin/setcfg $r_qpkg_name Auto_Update "$(Uppercase "$1")" -f /etc/config/qpkg.conf
DisplayAndCommitInfoToLog "application auto-update: $1";}
GetPathGitBranch(){
[[ -n $1 ]]||return
/opt/bin/git -C "$1" branch|/bin/grep '^\*'|/bin/sed 's|^\* ||'
} 2>/dev/null
IsSU(){
if [[ $EUID -ne 0 ]];then
if [[ -e /usr/bin/sudo ]];then
ShowAsError 'this utility must be run with superuser privileges. Try again as:'
Display "${r_chars_sudo_prompt}$0 $r_user_args_raw">&2
else
ShowAsError "this utility must be run as the 'admin' user. Please login via SSH as 'admin' and try again"
fi
return 1
fi
return 0;}
ShowUnsupportedAction(){
ShowAsError "specified action '$1' is unsupported by this service-script."
SetError
CommitInfoToLog "specified action '$1' is unsupported."
Display
ShowHelp;}
CalcAdaptiveSeconds(){
local a=$(GetSysLoad1MinAverage);a=${a/./}0
local b=$(($(GetCPUCores)*100))
local c=$((10#$a/10#$b))
local d=$((10#${1:-1}))
[[ $((10#$c)) -gt 10 ]]&&d=$(((c*d)/10))
[[ $((10#$d)) -gt 1800 ]]&&d=1800
printf '%s' "$d";}
GetSysLoad1MinAverage(){
/usr/bin/uptime|/bin/sed 's/.*load average: //'|/bin/awk -F', ' '{print $1}';}
GetCPUCores(){
local a=$(/bin/grep -c '^processor' /proc/cpuinfo)
[[ $a -eq 0 ]]&&a=$(/bin/grep -c '^Processor' /proc/cpuinfo)
printf '%s' "$a";}
AddToQPKGPostInstallDeps(){
[[ -n ${1:-} &&-n ${2:-} ]]||return
RemoveFromQPKGPostInstallDeps "$1" "$2"
SetQPKGPostInstallDeps "$1" "$(GetQPKGPostInstallDeps "$1"):$2";}
GetQPKGPostInstallDeps(){
[[ -n ${1:-} ]]||return
CleanDependencyField "$(/sbin/getcfg "$1" Dependency -f /etc/config/qpkg.conf)";}
RemoveFromQPKGPostInstallDeps(){
[[ -n ${1:-} &&-n ${2:-} ]]||return
local re=\\b${2}\\b
SetQPKGPostInstallDeps "$1" "$(/bin/sed "s|${re}||g"<<<"$(GetQPKGPostInstallDeps "$1")")";}
SetQPKGPostInstallDeps(){
[[ -n ${1:-} ]]||return
local a=$(CleanDependencyField "${2:-}")
if [[ -n $a ]];then
/sbin/setcfg "$1" Dependency "$a" -f /etc/config/qpkg.conf
else
/sbin/setcfg -e "$1" Dependency -f /etc/config/qpkg.conf
fi;}
CleanDependencyField(){
[[ -n ${1:-} ]]||return
local a=$(/bin/tr -s ':'<<<"$1")
[[ -n $a &&${a:0:1} = ':' ]]&&a=${a#?}
[[ -n $a &&${a: -1:1} = ':' ]]&&a=${a%?}
printf '%s' "$a";}
Lowercase(){
[[ -n ${1:-} ]]||return
tr 'A-Z' 'a-z'<<<"$1";}
SetTraps(){
trap CaughtSIGHUP SIGHUP
trap CaughtSIGINT SIGINT
trap CaughtEXIT EXIT;}
CaughtSIGHUP(){
trap - SIGHUP
if IsInProgress;then
Display
DisplayAndCommitWarnToLog 'caught SIGHUP: abort'
SetServiceResultAsAborted
fi
exit;}
CaughtSIGINT(){
trap - SIGINT
if IsInProgress;then
Display
DisplayAndCommitWarnToLog 'caught SIGINT: abort'
SetServiceResultAsAborted
fi
exit;}
CaughtEXIT(){
trap - EXIT
if IsInProgress;then
Display
DisplayAndCommitWarnToLog 'caught EXIT: abort'
SetServiceResultAsAborted
fi;}
ProcessArgs(){
if IsReinstall;then
echo "Detected 'reinstall' in-progress, so not processing internal QPKG actions further."
exit
fi
if IsUpgrade;then
echo "Detected 'upgrade' in-progress, so not processing internal QPKG actions further."
exit
fi
if IsGitApp;then
local test_branch=$(/sbin/getcfg $r_qpkg_name Git_Branch -d unknown -f /etc/config/qpkg.conf)
if [[ $test_branch = unknown ]];then
/sbin/setcfg $r_qpkg_name Git_Branch $source_git_branch -f /etc/config/qpkg.conf
else
source_git_branch=$test_branch
fi
fi
if IsNotError;then
local user_arg=${r_user_args_raw%% *}
case $user_arg in
?(--)activate|?(--)start)
IsSU||exit
SetServiceAction start
if IsQPKGEnabled;then
SetTraps
StartQPKG
else
ShowDisabledPrompt
SetError
fi;;
?(-)b|?(--)backup?(-config))
IsSU||exit
if IsSupportBackup;then
SetServiceAction backup
SetTraps
StopQPKG
BackupConfig
IsQPKGEnabled &&StartQPKG
else
SetServiceAction unsupported
ShowUnsupportedAction "$user_arg"
fi;;
?(--)clean|?(--)update|?(--)upgrade)
IsSU||exit
if IsSourcedOnline;then
SetServiceAction clean
SetTraps
StopQPKG
[[ $r_qpkg_name = nzbToMedia ]]&&BackupConfig
CleanLocalRepo
IsQPKGEnabled &&StartQPKG
[[ $r_qpkg_name = nzbToMedia ]]&&RestoreConfig
else
SetServiceAction unsupported
ShowUnsupportedAction "$user_arg"
fi;;
?(--)deactivate|?(--)stop)
IsSU||exit
IsUninstall &&exit
SetServiceAction stop
SetTraps
StopQPKG;;
?(--)disable)
IsSU||exit
SetServiceAction disable
SetTraps
[[ $(type -t PreDisableQPKGCustom) = function ]]&&PreDisableQPKGCustom
/sbin/qpkg_service disable "$r_qpkg_name"
if IsNotQPKGEnabled;then
ShowDisabled
else
ShowDisableFailed
SetError
fi;;
?(--)disable-auto-update)
IsSU||exit
if IsSupportAutoUpdate;then
SetServiceAction disable-auto-update
SetTraps
DisableAutoUpdate
else
SetServiceAction unsupported
ShowUnsupportedAction "$user_arg"
fi;;
?(--)enable)
IsSU||exit
SetServiceAction enable
SetTraps
[[ $(type -t PreEnableQPKGCustom) = function ]]&&PreEnableQPKGCustom
/sbin/qpkg_service enable "$r_qpkg_name"
if IsQPKGEnabled;then
ShowEnabled
else
ShowEnableFailed
SetError
fi;;
?(--)enable-auto-update)
IsSU||exit
if IsSupportAutoUpdate;then
SetServiceAction enable-auto-update
SetTraps
EnableAutoUpdate
else
SetServiceAction unsupported
ShowUnsupportedAction "$user_arg"
fi;;
?(--)help)
ShowHelp;;
?(-)+(l|L)|?(--)log)
SetServiceAction log
ViewLog;;
?(-)r|?(--)reactivate|?(--)restart)
IsSU||exit
SetServiceAction restart
if IsQPKGEnabled;then
SetTraps
StopQPKG &&StartQPKG
else
ShowDisabledPrompt
SetError
fi;;
remove)
SetServiceAction uninstall;;
?(--)reset-action)
IsSU||exit
if IsSupportActions;then
ResetServiceAction
exit
else
SetServiceAction unsupported
ShowUnsupportedAction "$user_arg"
fi;;
?(--)reset-config)
IsSU||exit
if IsSupportReset;then
SetServiceAction reset
SetTraps
StopQPKG
ResetConfig
IsQPKGEnabled &&StartQPKG
else
SetServiceAction unsupported
ShowUnsupportedAction "$user_arg"
fi;;
?(--)restore?(-config))
IsSU||exit
if IsSupportBackup;then
SetServiceAction restore
SetTraps
StopQPKG
RestoreConfig
IsQPKGEnabled &&StartQPKG
else
SetServiceAction unsupported
ShowUnsupportedAction "$user_arg"
fi;;
?(-)s|?(--)status)
IsSU||exit
SetStatusGet
StatusQPKG;;
uninstall)
:;;
?(-)+(v|V)|?(--)version?(s))
Display "QPKG: $(ConvertAsSmartDate ${r_qpkg_version:-undefined})"
Display "service: $(ConvertAsSmartDate "${r_service_script_version:-undefined}")"
Display "library: $(ConvertAsSmartDate "${r_service_library_version:-undefined}")";;
*)if [[ -z $user_arg ]];then
ShowHelp
else
SetServiceAction unsupported
ShowUnsupportedAction "$user_arg"
fi
esac
fi
if IsNotLog&&IsNotNone;then
if IsError;then
SetServiceResultAsFailed
exit 1
else
SetServiceResultAsOK
fi
fi
exit 0;}
InitLibrary
