#!/bin/bash
#*
#* <?preamble?>
#*
#* Description:
#*	  A library of common bash functions used by many sherpa QPKG service-scripts.
#*	  Each QPKG has a copy for use only by that QPKG's service-script.
#*
#* <?postamble?>
#*

set -o nounset -o pipefail
shopt -s extglob
[[ $- != *m* ]] || set +m								# Disable job control if-enabled (only needed for QTS 4.2.6).
[[ -L /dev/fd ]] || ln -fns /proc/self/fd /dev/fd		# KLUDGE: `/dev/fd` isn't always created by QTS.
readonly r_service_library_version='<?build_date?>'

InitLibrary()
	{

	[[ $(/usr/bin/basename "${BASH_SOURCE[0]}") = 'service-library.source' ]] && ShowAsNote 'using source library'

	IsQNAP || exit

	debug=${DEBUG_QPKG:=false}

	local re=''

	for re in \\bd\\b \\bD\\b \\bdebug\\b \\bdbug\\b \\bverbose\\b; do
		[[ $r_user_args_raw =~ $re ]] || continue
		debug=true
		break
	done

	UnsetError

	# Internal session constants.

		# Error messages.

			readonly e_noact='undefined action'
			readonly e_nochk='undefined checksum'
			readonly e_nocmd='undefined command'
			readonly e_noext='undefined exitcode'
			readonly e_nofil='undefined filename'
			readonly e_nonam='undefined name'
			readonly e_noopr='undefined operation'
			readonly e_nopfi='undefined pathfile'
			readonly e_nopnm='undefined package name'
			readonly e_noprm='undefined prompt'
			readonly e_nopth='undefined path'
			readonly e_nopty='undefined package type'
			readonly e_norea='undefined reason'
			readonly e_nores='undefined result'
			readonly e_nostr='undefined string'
			readonly e_notir='undefined tier'
			readonly e_nourl='undefined URL'
			readonly e_noval='undefined value'
			readonly e_novar='undefined variable'

		# Paths.

			readonly r_backup_path=$(/sbin/getcfg SHARE_DEF defVolMP -f /etc/config/def_share.info)/.qpkg_config_backup
			readonly r_opkg_path=/opt/bin:/opt/sbin
				export PATH=$r_opkg_path:$(/bin/sed "s|$r_opkg_path||" <<< "$PATH")
			readonly r_qpkg_path=$(/sbin/getcfg $r_qpkg_name Install_Path -f /etc/config/qpkg.conf)

		# Pathfilenames.

			readonly r_appl_version_store_pathfile=$r_qpkg_path/version.stored
			readonly r_screen_conf_pathfile=$r_qpkg_path/screen.conf
			readonly r_service_action_pathfile=/var/log/$r_qpkg_name.action
			readonly r_service_log_pathfile=/var/log/$r_qpkg_name.log
			readonly r_service_result_pathfile=/var/log/$r_qpkg_name.result
			readonly r_service_screen_log_pathfile=$r_qpkg_path/$r_qpkg_name.screen.log

		# Values.

			readonly r_chars_regular_prompt='$ '
				readonly r_chars_sudo_prompt="${r_chars_regular_prompt}sudo "
			readonly r_chars_super_prompt='# '
			readonly r_debug_log_datawidth=100
			readonly r_extended_datetime_format='+%a %-d %b %Y'
			readonly r_full_datetime_format=$r_extended_datetime_format' %-I:%M:%S %p %Z'
			readonly r_nas_firmware_version=$(/sbin/getcfg System Version -f /etc/config/uLinux.conf)
			readonly r_qpkg_version=$(/sbin/getcfg $r_qpkg_name Version -d unknown -f /etc/config/qpkg.conf)
			r_qpkgs_name_arrs=(Readarr Sonarr Whisparr)
				readonly r_qpkgs_name_arrs
			r_qpkgs_name_migrated=(Lidarr Medusa qBittorrent Readarr SickGear Sonarr Tautulli Transmission Watcher3 Whisparr)
				readonly r_qpkgs_name_migrated

	SetNasArch
	SetQpkgArch
	SetOsFirmwareVer
	SetHardwarePlatform

	# NOTE: default session variables are set below, but may be customised in the InitService() function for each QPKG. If a variable is set to a non-default value, any later variable that uses it must be recalculated (uncomment these lines).

	# >>> Switches <<<

		allow_access_to_sys_packages=false
			# Default
		# allow_access_to_sys_packages=true
			# Typical

		can_restart_to_update=false
			# Default
		# can_restart_to_update=true
			# Custom
		# > If 'true', application files can be updated by restarting service-script.

		check_network_before_start=false
			# Default
		# check_network_before_start=true
			# Custom
		# > If 'true', at-least one network interface must be operational before starting application daemon.

		compare_release_filename=false
			# Default
		# compare_release_filename=true
			# Custom
		# > If 'true', release package filename is used instead of last modified date to determine if new release is available. Need this for *arr packages, as they don't expose the "last modified" datetime of remote package files.

		daemon_pidfile_is_managed_by_app=false
			# Default
		# daemon_pidfile_is_managed_by_app=true
			# Custom

		install_pip_deps=false
			# Default
		# install_pip_deps=true
			# Custom

		package_is_exec=false
			# Default
		# package_is_exec=true
			# Custom
		# > If 'true', downloadable package is an executable file. If 'false', downloadable package is an archive that must be extracted-from.

		recheck_daemon_pid_after_kill=false
			# Default
		# recheck_daemon_pid_after_kill=true
			# Custom
		# > If 'true', application PID is reconfirmed shortly after kill. Some applications switch to another PID during shutdown, then kill their main PID.

		recheck_daemon_pid_after_launch=false
			# Default
		# recheck_daemon_pid_after_launch=true
			# Custom
		# > If 'true', application PID is reconfirmed shortly after initial launch. Some applications launch with one PID, then switch to another. Some just take a while to start.

		resolve_source_url=false
			# Default
		# resolve_source_url=true
			# Custom
		# > If 'true', URL must be retrieved from remote first, then parsed to get final URL.

		run_daemon_in_screen_session=false
			# Default
		# run_daemon_in_screen_session=true
			# Custom
		# > If 'true', daemon is always launched in a `screen` session, but will exit `screen` when it can.

		silence_pypi_errors=false
			# Default
		# silence_pypi_errors=true
			# Typical
		# > If 'true', PyPI package processing errors won't be shown in system log.

	# >>> Values (independent) <<<

		daemon_port=0
			# Default
		# daemon_port=
			# Custom

		nice_daemon_to=0
			# Default
		# nice_daemon_to=
			# Custom
		# > If non-zero, daemon proc is "niced" to this value on-launch.

		source_git_branch=undefined
			# Default
		# source_git_branch=main
			# Typical
		# source_git_branch=master
			# Typical
		# source_git_branch=
			# Custom

		source_git_branch_depth=undefined
			# Default
		# source_git_branch_depth=shallow
			# Typical
		# source_git_branch_depth=single-branch
			# Typical
		# source_git_branch_depth=
			# Custom
		# > 'shallow' (depth 1) or 'single-branch': 'shallow' implies 'single-branch', 'single-branch' does NOT imply 'shallow'.

		source_url_arch=undefined
			# Default
		# source_url_arch=
			# Custom

		start_retries=0
			# Default
		# start_retries=3
			# Typical
		# start_retries=
			# Custom
		# > If daemon failed to 'start', try 'start' again this many times.

		ui_listening_address=undefined
			# Default
		# ui_listening_address=0.0.0.0
			# Typical
		# ui_listening_address=
			# Custom

		ui_port=0
			# Default
		# ui_port=
			# Custom

		ui_port_secure=0
			# Default
		# ui_port_secure=
			# Custom

		wait_pid_kill_seconds=10
			# Default
		# wait_pid_kill_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		wait_pid_start_seconds=10
			# Default
		# wait_pid_start_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		watch_interface_up_seconds=180
			# Default
		# watch_interface_up_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		watch_pid_kill_seconds=120
			# Default
		# watch_pid_kill_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		watch_pid_start_seconds=120
			# Default
		# watch_pid_start_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		watch_pidfile_start_seconds=60
			# Default
		# watch_pidfile_start_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

		watch_port_check_seconds=120
			# Default
		# watch_port_check_seconds=
			# Custom
		# > This value is adaptive (increases with system load average).

	# >>> Paths <<<

		qpkg_config_path=undefined
			# Default
		# qpkg_config_path=$r_qpkg_path/config
			# Typical
		# qpkg_config_path=
			# Custom
		# > Must reset $HOME lower-down: `export HOME=$qpkg_config_path`

		qpkg_pip_path=undefined
			# Default
		# qpkg_pip_path=$r_qpkg_path/pip-cache
			# Typical
		# qpkg_pip_path=
			# Custom

		qpkg_repo_path=undefined
			# Default
		# qpkg_repo_path=$r_qpkg_path/repo-cache
			# Typical
		# qpkg_repo_path=
			# Custom

		qpkg_temp_path=undefined
			# Default
		# qpkg_temp_path=$r_qpkg_path/tmp
			# Typical
		# qpkg_temp_path=
			# Custom

		qpkg_venv_path=undefined
			# Default
		# qpkg_venv_path=$r_qpkg_path/venv
			# Typical
		# qpkg_venv_path=
			# Custom

		qpkg_wheels_path=undefined
			# Default
		# qpkg_wheels_path=$r_qpkg_path/qpkg-wheels
			# Typical
		# qpkg_wheels_path=
			# Custom

	# >>> Pathfilenames <<<

		appl_version_pathfile=undefined
			# Default
		# appl_version_pathfile=
			# Custom

		daemon_check_pathfile=undefined
			# Default
		# daemon_check_pathfile=
			# Custom
		# > If set, look for this process name in RAM instead of $daemon_exec_pathfile.

		daemon_exec_pathfile=undefined
			# Default
		# daemon_exec_pathfile=$qpkg_venv_path/bin/python3
			# Typical
		# daemon_exec_pathfile=
			# Custom
		# > The pathfilename of the main daemon. If $daemon_script_pathfile is set, then this is the interpreter used to run the script.

		daemon_pid_pathfile=undefined
			# Default
		# daemon_pid_pathfile=/var/run/$r_qpkg_name.pid
			# Typical
		# daemon_pid_pathfile=
			# Custom

		daemon_script_pathfile=undefined
			# Default
		# daemon_script_pathfile=
			# Custom
		# > When an interpreter is to be used, interpret this script.

		launcher_pathfile=undefined
			# Default
		# launcher_pathfile=
			# Custom
		# > On-demand executables only (no daemon).

		qpkg_backup_pathfile=undefined
			# Default
		# qpkg_backup_pathfile=$r_backup_path/$r_qpkg_name.config.tar.gz
			# Typical
		# qpkg_backup_pathfile=
			# Custom

		qpkg_config_pathfile=undefined
			# Default
		# qpkg_config_pathfile=$qpkg_config_path/config.ini
			# Typical
		# qpkg_config_pathfile=
			# Custom

		qpkg_config_default_pathfile=undefined
			# Default
		# qpkg_config_default_pathfile=$qpkg_config_pathfile.def
			# Typical
		# qpkg_config_default_pathfile=
			# Custom

		qpkg_config_virtual_pathfile=undefined
			# Default
		# qpkg_config_virtual_pathfile=
			# Custom
		# > When config file must be made available to appl through a symlink (like nzbToMedia).

		userlink_pathfile=undefined
			# Default
		# userlink_pathfile=
			# Custom
		# > Applies to on-demand executables only.

		venv_pip_pathfile=undefined
			# Default
		# venv_pip_pathfile=$qpkg_venv_path/bin/pip
			# Typical
		# venv_pip_pathfile=
			# Custom

		venv_python_pathfile=undefined
			# Default
		# venv_python_pathfile=$qpkg_venv_path/bin/python3
			# Typical
		# venv_python_pathfile=
			# Custom

	# >>> Values (potentially independent: these might use a variable set earlier) <<<

		export HOME=$qpkg_config_path
			# Default
		# export HOME=
			# Custom

		interpreter=undefined
			# Default
		# interpreter=/opt/bin/python3
			# Typical
		# interpreter=
			# Custom

		orig_daemon_service_script=undefined
			# Default
		# orig_daemon_service_script=
			# Custom
		# > Specific to Entware binaries only.

		source_asset_url_match=undefined
			# Default
		# source_asset_url_match=
			# Custom
		# > Longest string to match in URL to determine filename.

	# >>> URLs <<<

		source_asset_url=undefined
			# Default
		# source_asset_url=https://api.github.com/repos/<user>/<project>/releases/latest
			# Typical
		# source_asset_url=
			# Custom

		source_git_url=undefined
			# Default
		# source_git_url=https://github.com/<user>/<project>.git
			# Typical
		# source_git_url=
			# Custom
		# > https://github.com/
		# > https://gitlab.com/

	# >>> CMDs <<<

		daemon_launch_cmd=undefined
			# Default
		# daemon_launch_cmd=
			# Custom

		get_appl_version_cmd=undefined
			# Default
		# get_appl_version_cmd=
			# Custom

		get_daemon_port_cmd=undefined
			# Default
		# get_daemon_port_cmd=
			# Custom

		get_ui_listening_address_cmd=undefined
			# Default
		# get_ui_listening_address_cmd=
			# Custom

		get_ui_port_cmd=undefined
			# Default
		# get_ui_port_cmd=
			# Custom

		get_ui_port_secure_cmd=undefined
			# Default
		# get_ui_port_secure_cmd=
			# Custom

		get_ui_port_secure_enabled_test_cmd=undefined
			# Default
		# get_ui_port_secure_enabled_test_cmd=
			# Custom

	InitService					# Located in each parent QPKG service-script. Service-script variables will override the variables set above.

	curl_insecure_opt=''
	IsOsCanSecureDownload || curl_insecure_opt=' --insecure'
	get_remote_filename_timeout_seconds=5
	new_env=false
	pyver=''
	service_action=unspecified
	service_result=undefined
	MakePaths
	EnsureConfigFileExists
	GetApplVersion
	DisableOpkgDaemonStart
	IsSupportAutoUpdate && IsAutoUpdateMissing && EnableAutoUpdate > /dev/null

	# KLUDGE: delete existing `screen.conf` so it's rewritten with new log location.
	# see https://github.com/OneCDOnly/sherpa/discussions/301 for more information.

	rm -f "$r_screen_conf_pathfile"

	# KLUDGE: update <InstanceName> in config of *arr QPKGs, so process can be recognised by application.

	if IsQpkgArr && [[ -e $qpkg_config_pathfile ]] && /bin/grep O${r_qpkg_name} "$qpkg_config_pathfile" &>/dev/null; then
		/bin/sed -i "s|O${r_qpkg_name}|$r_qpkg_name|g" "$qpkg_config_pathfile"
	fi

	# Create a `screen.conf` for this QPKG.

	if [[ $run_daemon_in_screen_session = true && ! -e $r_screen_conf_pathfile ]]; then
		echo -e "logfile ${r_service_screen_log_pathfile}\nlogfile flush 1\nlog on" > "$r_screen_conf_pathfile"
	fi

	}

IsQpkgArr()
	{

	# Check if specified QPKG is an *arr application.

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name - if $1 is explicitly stated, lookup $1 in package lists, ignoring current $r_qpkg_name.

	# Inputs: (global)
	#	$r_qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local re=\\b${1:-${r_qpkg_name:?${FUNCNAME[0]}(): $e_nopnm}}\\b			# bash 3.2 regex with word boundaries: https://stackoverflow.com/a/9793094

	[[ ${r_qpkgs_name_arrs[*]} =~ $re ]]

	}

StartQpkg()
	{

	IsNtError || return
	IsStart && ShowQpkgStates

	if IsDaemon && IsNtRestart; then
		IsNtStart && DaemonWasNotActive && return		# Don't start (after running actions like 'backup') if daemon wasn't active before.
		IsNtClean && ShowDaemonState
		IsDaemonActive && return						# No-need to check for an active daemon during 'restart' as it has already been killed.
	fi

	# Clear previous `screen.log` on each startup.

	[[ -e $r_service_screen_log_pathfile ]] && DisplayRunAndLog "remove previous 'screen' session log" "rm -f \"$r_service_screen_log_pathfile\"" log:failure-only

	if [[ $(type -t PreStartQpkgCustom) = function ]]; then
		PreStartQpkgCustom
		IsNtError || return
	fi

	if [[ $(type -t StartQpkgCustom) = function ]]; then
		StartQpkgCustom
	else
		StartQpkgLibrary
	fi

	}

StartQpkgLibrary()
	{

	if IsSourceGit; then
		CloneGitRepo || return
	fi

	if IsSourceReleasePackage; then
		RefreshReleasePackageFiles || return
	fi

	if IsVirtualPythonEnv && IsNtVirtualPythonEnvFound; then
		CreateVirtualPythonEnv || return
		InstallPythonPackages || return
	fi

	if IsNtDaemon; then
		CreateUserlinkToExec
		return
	fi

	EnsureConfigFileExists

	if IsWebUi; then
		LoadPorts app || return
		CheckPortsAvailable || return
	fi

	if IsCheckNetworkBeforeStart; then
		WatchForAnyInterfaceUp || return
	fi

	StartDaemon

	return

	}

StopQpkg()
	{

	IsNtError || return

	if IsStop || IsRestart || IsClean; then
		ShowQpkgStates
	fi

	if IsDaemon; then
		ShowDaemonState
		IsNtRestart && IsNtDaemonActive && return
	fi

	[[ $(type -t PreStopQpkgCustom) = function ]] && PreStopQpkgCustom

	if [[ $(type -t StopQpkgCustom) = function ]]; then
		StopQpkgCustom
	else
		StopQpkgLibrary
	fi

	}

StopQpkgLibrary()
	{

	if IsNtDaemon; then
		RemoveUserlinkToExec
		return
	fi

	RefreshPidFile

	if IsDaemon && IsDaemonActive; then
		SetDaemonWasActive
		StopDaemon
		ShowDaemonState
	fi

	return

	}

StatusQpkg()
	{

	IsNtError || return
	ShowQpkgStates
	IsDaemon && ShowDaemonState

	if [[ $(type -t StatusQpkgCustom) = function ]]; then
		StatusQpkgCustom				# <-- NOTE: Processing will terminate in this function (no-return).
	else
		StatusQpkgLibrary				# <-- NOTE: Processing will terminate in this function (no-return).
	fi

	}

StatusQpkgLibrary()
	{

	# The following only checks for daemon services, and only HTTP/S port responses (where-applicable).
	# Any other status checks must be customised for the application and placed in StatusQpkgCustom() in the QPKG service-script.

	# NOTE: Processing will terminate in this function (no-return).

	RefreshPidFile

	if IsDaemon && IsDaemonActive; then
		if IsWebUi; then
			LoadPorts app

			if ! WatchForPortsActive; then
				Display '! no response from port(s)'
				exit 1
			fi
		fi
	else
		exit 1
	fi

	exit 0

	}

CreateUserlinkToExec()
	{

	# Inputs: (global)
	#	$launcher_pathfile
	#	$r_qpkg_name
	#	$userlink_pathfile

	if [[ $userlink_pathfile != undefined ]]; then
		if [[ ! -L $userlink_pathfile && -e $launcher_pathfile ]]; then
			ln -s "$launcher_pathfile" "$userlink_pathfile"

			if [[ -L $userlink_pathfile ]]; then
				DisplayAndCommitInfoToServiceLog "symlink created: $userlink_pathfile"
			else
				DisplayAndCommitErrorToAllLogs "unable to create symlink to $r_qpkg_name launcher"

				SetError; return
			fi
		else
			DisplayAndCommitInfoToServiceLog "symlink exists: $userlink_pathfile"
		fi

		return
	fi

	}

RemoveUserlinkToExec()
	{

	# Inputs: (global)
	#	$userlink_pathfile

	if [[ $userlink_pathfile != undefined ]]; then
		if [[ -L $userlink_pathfile ]]; then
			rm -f "$userlink_pathfile"
			DisplayAndCommitInfoToServiceLog "symlink removed: $userlink_pathfile"
		fi
	fi

	}

CreateVirtualPythonEnv()
	{

	# Inputs: (global)
	#	$allow_access_to_sys_packages
	#	$interpreter
	#	$qpkg_pip_path
	#	$qpkg_venv_path
	#	$qpkg_wheels_path

	# Outputs: (global)
	#	$new_env = true: new virtual environment was created.
	#			 = false: a virtual environment already exists.

	ConfirmVarIsDefined qpkg_venv_path "${qpkg_venv_path:-}" "$e_nopth" || return
	ConfirmVarIsDefined qpkg_pip_path "${qpkg_pip_path:-}" "$e_nopth" || return

	new_env=false
	local a=''
	local b=$qpkg_venv_path/pip.conf

	[[ $allow_access_to_sys_packages = true ]] && a=' --system-site-packages'

	if IsNtVirtualPythonEnvFound; then
		DisplayRunAndLog 'create new virtual Python environment' "export PIP_CACHE_DIR=$qpkg_pip_path VIRTUALENV_OVERRIDE_APP_DATA=$qpkg_pip_path; $interpreter -m virtualenv ${qpkg_venv_path}${a}" log:failure-only
		new_env=true

		if [[ ! -e $b ]]; then
			DisplayRunAndLog "create QPKG 'pip' config" "echo \"[global]\" > $b" log:failure-only
			DisplayRunAndLog "add location '$qpkg_pip_path' as 'pip' cache" "echo \"cache-dir = $qpkg_pip_path\" >> $b" log:failure-only

			if [[ $qpkg_wheels_path != undefined && -d $qpkg_wheels_path ]]; then
				DisplayRunAndLog "add location '$qpkg_wheels_path' to 'pip' search path" "echo \"find-links = $qpkg_wheels_path\" >> $b" log:failure-only
			fi
		fi
	fi

	return 0

	}

ConfirmVarIsDefined()
	{

	# Inputs: (local)
	#	$1 = test variable name.
	#	$2 = test variable value.
	#	$3 = error message reason shown if empty or undefined.

	local -i backdepth=1			# 0 = this function, 1 = calling function, etc...

	[[ ${2:-undefined} != undefined ]] || { ShowAsBug "${FUNCNAME[$backdepth]}" "\$${1:-undefined}: '${3:-undefined}'"; return ;}

	return 0

	}

StartDaemon()
	{

	# Inputs: (global)
	#	$daemon_launch_cmd
	#	$nice_daemon_to
	#	$r_service_screen_log_pathfile
	#	$run_daemon_in_screen_session
	#	$start_retries

	IsNtSkipDaemonStart || return
	IsDaemon || return

	if IsDaemonActive; then
		DisplayAndCommitInfoToServiceLog 'daemon is already active'
		ShowDaemonState
		return
	fi

	local a='start daemon'
	local b=$daemon_launch_cmd
	local -i c=0

	if [[ $run_daemon_in_screen_session = true ]]; then
		a+=" (in 'screen' session)"
		rm -f "${r_service_screen_log_pathfile:?}"
	fi

	if ((nice_daemon_to != 0)) && ((nice_daemon_to >= -20)) && ((nice_daemon_to <= 19)) && [[ -e /opt/bin/nice ]]; then
		b="/opt/bin/nice -n $nice_daemon_to sh -c \"$daemon_launch_cmd\""
		DisplayAndCommitInfoToServiceLog "nice daemon to: $nice_daemon_to"
	fi

	if UsesConfig possible; then
		ConfirmVarIsDefined qpkg_config_path "${qpkg_config_path:-}" "$e_nopth" || return
		ConfirmVarIsDefined qpkg_config_pathfile "${qpkg_config_pathfile:-}" "$e_nopfi" || return
	fi

	while true; do
		if ! DisplayRunAndLog "$a" "$b" log:failure-only "$run_daemon_in_screen_session"; then
			DisplayAndCommitWarnToServiceLog 'there has been a daemon launch failure'
			SetError; return
		fi

		IsDaemonActive &> /dev/null
		WatchForDaemon
		PauseForStartPid
		ShowDaemonState

		if ! IsDaemonActive &> /dev/null || (IsWebUi && ! WatchForPortsActive); then
			DisplayAndCommitWarnToServiceLog 'daemon PID check failed: there appears to have been a post-launch failure'
			[[ $run_daemon_in_screen_session = true ]] && AddFileToDebug "$r_service_screen_log_pathfile"
			((c++))

			if [[ $((c-1)) -lt $start_retries ]]; then
				DisplayAndCommitRetryToServiceLog "retry $c/$start_retries"
				continue
			fi

			DisplayAndCommitErrorToAllLogs "tried to launch $c time$(Pluralise "$c"), no further retries are possible"

			SetError; return
		fi

		break
	done

	CommitInfoToSysLog "$a: OK"

	}

StopDaemon()
	{

	# Inputs: (global)
	#	$daemon_pid_pathfile
	#	$watch_pid_kill_seconds

	[[ -e $daemon_pid_pathfile ]] || return

	local a='stop daemon'
	local -i b=$(CalcAdaptiveSeconds "$watch_pid_kill_seconds")
	local -i c=0
	local -i d=$(< $daemon_pid_pathfile)

	[[ $d -gt 1 ]] || return

	DisplayAndCommitProcessWaitToServiceLog "$a PID ${d} with SIGTERM (no-more than $b second$(Pluralise "$b"))"

	kill "$d"

	while true; do
		while [[ -d /proc/$d ]]; do
			/bin/sleep 1
			((c++))
			DisplayWait "$c,"

			if [[ $c -ge $b ]]; then
				DisplayAndCommitOutcomeToServiceLog failed
				DisplayAndCommitProcessWaitToServiceLog "$a PID ${d} with SIGKILL"

				kill -9 "$d" 2> /dev/null

				[[ -f $daemon_pid_pathfile ]] && rm -f "$daemon_pid_pathfile"
				DisplayAndCommitOutcomeToServiceLog OK					# Assume `kill -9` actually worked.
				break 2
			fi
		done

		[[ -f $daemon_pid_pathfile ]] && rm -f "$daemon_pid_pathfile"

		DisplayAndCommitOutcomeToServiceLog OK
		CommitInfoToServiceLog "stopped in $c second$(Pluralise "$c")"
		CommitInfoToSysLog "$a: OK"
		break
	done

	PauseForKillPid

	if IsDaemonActive; then
		SetError; return
	fi

	}

RefreshReleasePackageFiles()
	{

	# Inputs: (global)
	#	$compare_release_filename
	#	$get_remote_filename_timeout_seconds
	#	$qpkg_repo_path
	#	$qpkg_temp_path
	#	$resolve_source_url
	#	$source_asset_url
	#	$source_url_arch
	#	$source_asset_url_match

	if UsesReleasePackage possible; then
		ConfirmVarIsDefined qpkg_repo_path "${qpkg_repo_path:-}" "$e_nopth" || return
		ConfirmVarIsDefined qpkg_temp_path "${qpkg_temp_path:-}" "$e_nopth" || return
		ConfirmVarIsDefined source_asset_url "${source_asset_url:-}" "$e_nourl" || return
	fi

	local extract_release_package=false
	local refresh_release_package=false
	local release_package_filename=''
	local release_package_name_ref_pathfilename=''
	local release_package_pathfile=$qpkg_temp_path/source.package			# Local filename of the remote application package.
	local release_package_url=''

	if IsAutoUpdate || [[ ! -e $release_package_pathfile ]]; then			# Get remote package - even when auto-update is disabled - if one doesn't exist locally.
		if [[ $resolve_source_url = true ]]; then
			refresh_release_package=true

			DisplayAndCommitProcessWaitToServiceLog 'get latest release package URL'

			if IsSiteUp "$source_asset_url"; then
				release_package_url=$(RequestLatestReleaseURL "$source_asset_url" "$source_asset_url_match")

				if [[ $? -eq 0 ]]; then
					DisplayAndCommitOutcomeToServiceLog OK
					DisplayAndCommitDoneToServiceLog "release package URL: $release_package_url"
				else
					DisplayAndCommitOutcomeToServiceLog failed
					DisplayAndCommitErrorToAllLogs "$release_package_url"
					release_package_url=''
				fi
			else
				DisplayAndCommitErrorToAllLogs 'unable to access remote site'
			fi
		else
			release_package_url=$source_asset_url
		fi

		if [[ $compare_release_filename = true ]]; then
			DisplayAndCommitProcessWaitToServiceLog "get latest remote release package filename (no-more than $get_remote_filename_timeout_seconds seconds)"

			if IsSiteUp "$source_asset_url"; then
				release_package_filename=$(RequestLatestReleaseFilename "$source_asset_url" "$source_url_arch")

				if [[ $? -eq 0 ]]; then
					DisplayAndCommitOutcomeToServiceLog OK
					DisplayAndCommitDoneToServiceLog "release package filename: $release_package_filename"
				else
					DisplayAndCommitOutcomeToServiceLog failed
					DisplayAndCommitErrorToAllLogs "$release_package_filename"
					release_package_filename=''
				fi
			else
				DisplayAndCommitErrorToAllLogs 'unable to access remote site'
			fi

			if [[ -z $release_package_filename && -n $release_package_url && $release_package_url != undefined ]]; then
				release_package_filename=$(/usr/bin/basename "$release_package_url")
			fi

			if [[ -z $release_package_name_ref_pathfilename && -n $release_package_filename && -n $release_package_url && $release_package_url != undefined ]]; then
				release_package_name_ref_pathfilename=$(/usr/bin/dirname "$release_package_pathfile")/$release_package_filename
			fi

			if [[ -n $release_package_filename && -n $release_package_name_ref_pathfilename ]]; then
				DisplayAndCommitProcessWaitToServiceLog 'release package name reference exists locally'

				if [[ -e $release_package_name_ref_pathfilename ]]; then
					DisplayAndCommitOutcomeToServiceLog true
				else
					DisplayAndCommitOutcomeToServiceLog false
					refresh_release_package=true
					rm -f "$release_package_pathfile"
				fi
			fi
		fi
	fi

	DisplayAndCommitProcessWaitToServiceLog 'release package exists locally'

	if [[ -e $release_package_pathfile ]]; then
		DisplayAndCommitOutcomeToServiceLog true
	else
		DisplayAndCommitOutcomeToServiceLog false
		refresh_release_package=true
	fi

	if [[ ! -e $release_package_pathfile && -n $release_package_url ]] || [[ $refresh_release_package = true ]]; then
		DownloadReleasePackage "$release_package_url" "$release_package_pathfile"

		if [[ -e $release_package_pathfile ]] && [[ ! -e $daemon_exec_pathfile || $(($(ConvertNowToSeconds)-$(/usr/bin/stat "$release_package_pathfile" -c %Y))) -lt 10 ]]; then		# If release package was downloaded less-than 10 minutes ago, assume it's new and must therefore be extracted-from.
			extract_release_package=true
		fi
	fi

	IsPathEmpty "$qpkg_repo_path" && extract_release_package=true

	if [[ $extract_release_package = true && -e $release_package_pathfile ]]; then
		if IsReleaseAnArchive; then
			ExtractReleasePackage "$release_package_pathfile" "$release_package_name_ref_pathfilename"
		else
			MakeExecReleasePackage "$release_package_pathfile" "$release_package_name_ref_pathfilename"
		fi
	fi

	if [[ -d $qpkg_repo_path ]]; then
		if IsPathEmpty "$qpkg_repo_path"; then
			DisplayAndCommitErrorToAllLogs 'local repository files do not exist'

			SetError; return
		fi
	else
		DisplayAndCommitErrorToAllLogs 'local repository path does not exist'

		SetError; return
	fi

	return 0

	}

CheckPortsAvailable()
	{

	# Inputs: (global)
	#	$daemon_port
	#	$ui_port
	#	$ui_port_secure

	local a=''

	if [[ $daemon_port -le 0 && $ui_port -le 0 && $ui_port_secure -le 0 ]]; then
		DisplayAndCommitErrorToAllLogs 'no port specified'

		SetError; return
	elif IsNtPortAvailable $ui_port || IsNtPortAvailable $ui_port_secure; then
		DisplayAndCommitErrorToAllLogs "ports $ui_port or $ui_port_secure are already in-use"

		a=$(/usr/sbin/lsof -i :$ui_port -Fp)
		DisplayAndCommitInfoToAllLogs "process details for port $ui_port: ${a}: PID $([[ -n ${a:-} ]] && /bin/tr '\000' ' ' </proc/"${a/p/}"/cmdline)"

		a=$(/usr/sbin/lsof -i :$ui_port_secure -Fp)
		DisplayAndCommitInfoToAllLogs "process details for secure port $ui_port_secure: PID ${a}: $([[ -n ${a:-} ]] && /bin/tr '\000' ' ' </proc/"${a/p/}"/cmdline)"

		SetError; return
	fi

	}

ShowHelp()
	{

	# Inputs: (global)
	#	$r_qpkg_name
	#	$r_service_script_version

	Display "$(TextBrightWhite "$(/usr/bin/basename "$0")") v$r_service_script_version • a service control script for the $(FormatAsPackageName $r_qpkg_name) QPKG"
	Display
	Display "Usage: $0 [ACTION] [OPTION]"
	Display
	Display '[ACTION] must be one of the following:'
	DisplayAsHelp 'activate, start' "start $(FormatAsPackageName $r_qpkg_name) if inactive"
	IsSupportBackup && DisplayAsHelp 'b, backup' "backup current $(FormatAsPackageName $r_qpkg_name) configuration to persistent storage"
	IsSourcedOnline && DisplayAsHelp clean "delete & re-download $(FormatAsPackageName $r_qpkg_name) files from source$(IsSupportBackup && printf '. Configuration will be retained')"
	DisplayAsHelp 'deactivate, stop' "stop $(FormatAsPackageName $r_qpkg_name) if active"
	DisplayAsHelp disable "disable $(FormatAsPackageName $r_qpkg_name) to prevent it starting (on NAS bootup)"
	IsSupportAutoUpdate && DisplayAsHelp disable-auto-update "don't auto-update $(FormatAsPackageName $r_qpkg_name) before starting it"
	DisplayAsHelp enable "enable $(FormatAsPackageName $r_qpkg_name) so it can be started"
	IsSupportAutoUpdate && DisplayAsHelp enable-auto-update "auto-update $(FormatAsPackageName $r_qpkg_name) before starting (default)"
	DisplayAsHelp 'l, L, log' 'display the service-script log'
	DisplayAsHelp 'r, reactivate, restart' "stop, then start $(FormatAsPackageName $r_qpkg_name)"
	IsSupportActions && DisplayAsHelp reset-action 'clear the current service-script action and action result'
	IsSupportReset && DisplayAsHelp reset-config "revert $(FormatAsPackageName $r_qpkg_name) configuration, databases and history to defaults"
	IsSupportBackup && DisplayAsHelp restore 'restore a previously saved configuration from persistent storage'
	DisplayAsHelp 's, status' "check if $(FormatAsPackageName $r_qpkg_name) application is active. Returns \$? = 0 if active, 1 if not"
	DisplayAsHelp 'v, V, version' 'display the package version numbers'
	Display
	Display '[OPTION] may be one of the following:'
	DisplayAsHelp 'd, D, debug, verbose' "execute the specified [ACTION] in debug mode"
	Display

	}

InstallPythonPackages()
	{

	# Inputs: (global)
	#	$appl_version
	#	$install_pip_deps
	#	$new_env
	#	$qpkg_repo_path
	#	$r_appl_version_store_pathfile
	#	$r_qpkg_name
	#	$silence_pypi_errors
	#	$venv_pip_pathfile

	IsVirtualPythonEnv || return 0

	local a=''
	local cmd=''
	local default_essential_modules_pathfile=$r_qpkg_path/pip-essential.txt
	local default_recommended_modules_pathfile=$r_qpkg_path/pip-recommended.txt
	local default_requirements_modules_pathfile=$r_qpkg_path/pip-requirements.txt
	local essential_modules_pathfile=$qpkg_repo_path/pip-essential.txt
	local excluded_modules_pathfile=$r_qpkg_path/pip-exclusions.txt
	local module_exclusions=''
	local no_pip_deps=' --no-deps'
	local no_pips_installed=true
	local pyproject_pathfile=$qpkg_repo_path/pyproject.toml
	local re=''
	local recommended_modules_pathfile=$qpkg_repo_path/recommended.txt
	local rename_modules_pathfile=$r_qpkg_path/pip-rename.txt
	local requirements_modules_pathfile=$qpkg_repo_path/requirements.txt

	[[ $install_pip_deps = true ]] && no_pip_deps=''

	if IsNtVirtualPythonEnvFound; then
		DisplayAndCommitErrorToAllLogs 'unable to install addons: virtual Python environment does not exist'

		SetError; return
	fi

	IsNtAutoUpdate && [[ $new_env = false ]] && return 0

	if [[ $r_qpkg_name = Watcher3 || $r_qpkg_name = OWatcher3 ]]; then
		# Need to install `m2r` PyPI module first.
		DisplayRunAndLog "KLUDGE: install 'm2r' PyPI module first" "$venv_pip_pathfile install${no_pip_deps} --no-input m2r" log:failure-only

		if [[ $? -gt 0 && $silence_pypi_errors = false ]]; then
			CommitWarnToSysLog "'mr2' PyPI module installation failed"
		fi
	fi

	# Edit developer-provided Python module requirements files out-of-repo.
	# NOTE: Always prefer QPKG-supplied PyPI lists over repo-supplied versions.

	[[ ! -e $default_essential_modules_pathfile && -e $essential_modules_pathfile && -d $(/usr/bin/dirname "$default_essential_modules_pathfile") ]] && cp -f "$essential_modules_pathfile" "$default_essential_modules_pathfile"
	[[ -e $default_essential_modules_pathfile ]] && essential_modules_pathfile=$default_essential_modules_pathfile

	[[ ! -e $default_requirements_modules_pathfile && -e $requirements_modules_pathfile && -d $(/usr/bin/dirname "$default_requirements_modules_pathfile") ]] && cp -f "$requirements_modules_pathfile" "$default_requirements_modules_pathfile"
	[[ -e $default_requirements_modules_pathfile ]] && requirements_modules_pathfile=$default_requirements_modules_pathfile

	[[ ! -e $default_recommended_modules_pathfile && -e $recommended_modules_pathfile && -d $(/usr/bin/dirname "$default_recommended_modules_pathfile") ]] && cp -f "$recommended_modules_pathfile" "$default_recommended_modules_pathfile"
	[[ -e $default_recommended_modules_pathfile ]] && recommended_modules_pathfile=$default_recommended_modules_pathfile

	# Must remove these modules from repo txt files, and use the ones installed via `opkg` instead (if-available).
	# If not, `pip` will attempt to compile these, which fails on various arches.

	if [[ -e $excluded_modules_pathfile ]]; then
		module_exclusions=$(/bin/tr '\n' ' ' <<< "$(StripComments "$(< "$excluded_modules_pathfile")")")
		module_exclusions=${module_exclusions%* }

		[[ -n $module_exclusions ]] && [[ -e /opt/bin/sed ]] && re="${module_exclusions// /|}"	# Replace whitespace with pipes.

		if [[ -n $re ]]; then
			for a in $essential_modules_pathfile $requirements_modules_pathfile $recommended_modules_pathfile $pyproject_pathfile; do
				if [[ -e $a && -e /opt/bin/sed ]]; then
					cmd="/opt/bin/sed -i -E '/^(${re})[[:space:]]/Id;/^(${re})$/Id' $a"		# Perform extended and case-insensitive matching. First match = first word (or hyphenated-words) on each line. Second match = whole line. Delete line if matched.

					DisplayRunAndLog "exclude problematic PyPI modules from $(/usr/bin/basename "$a")" "$cmd" log:failure-only
				fi
			done
		fi
	fi

	# Install PyPI modules.

	for a in $essential_modules_pathfile $requirements_modules_pathfile $recommended_modules_pathfile; do
		if [[ -e $a ]]; then
			DisplayRunAndLog "install PyPI modules from $(/usr/bin/basename "$a")" "$venv_pip_pathfile install${no_pip_deps} --no-input --upgrade pip -r $a" log:failure-only

			if [[ $? -gt 0 && $silence_pypi_errors = false ]]; then
				CommitWarnToAllLogs 'PyPI module installation failed'
			fi

			no_pips_installed=false
		fi
	done

	# KLUDGE: `manytolinux2014` builds are problematic in QTS, so rename these locally.

	if [[ -e $rename_modules_pathfile ]]; then
		for a in $(StripComments "$(< "$rename_modules_pathfile")"); do
			RenameSharedObjectFile "$a"
		done
	fi

	if IsSupportGetApplVersion; then
		GetApplVersion

		if [[ $new_env = false && -e $r_appl_version_store_pathfile && $(< "$r_appl_version_store_pathfile") != "$appl_version" ]]; then
			# Remove existing .pyc files to prevent runtime errors
			DisplayRunAndLog 'clean Python bytecode files' "/opt/bin/find $qpkg_repo_path -type d -name '__pycache__' -print0 | xargs -I {} -0 rm -rf '{}'
" log:failure-only
		fi

		if [[ ! -e $r_appl_version_store_pathfile || $(< "$r_appl_version_store_pathfile") != "$appl_version" ]]; then
			# Generate language translations.
			DisplayRunAndLog 'generate language translations' "cd $qpkg_repo_path; $venv_python_pathfile $qpkg_repo_path/tools/make_mo.py" log:failure-only
		fi

		SaveApplVersion
	fi

	return 0

	}

StripComments()
	{

	# Inputs: (local)
	#	$1 = String to strip comment lines, empty lines, and so-on.

	# Outputs: (local)
	#	stdout

	[[ -n $1 ]] || return

	local a=$1

	a=$(/bin/sed -e '/^#[[:space:]].*/d;/#$/d;s/[[:space:]]#[[:space:]].*//' <<< "$a")		# Remove comment lines and line comments.
	a=$(/bin/sed -e 's/^[[:space:]]*//' <<< "$a")											# Remove leading whitespace.
	a=$(/bin/sed 's/[[:space:]]*$//' <<< "$a")												# Remove trailing whitespace.
	a=$(/bin/sed "/^$/d" <<< "$a")															# Remove empty lines.

	echo "$a"

	}

BackupConfig()
	{

	# Inputs: (global)
	#	$qpkg_backup_pathfile
	#	$r_qpkg_path

	if ! DisplayRunAndLog 'update configuration backup' "/bin/tar --create --gzip --file=$qpkg_backup_pathfile --directory=$r_qpkg_path/config ." log:failure-only; then
		SetError; return
	fi

	}

RestoreConfig()
	{

	# Inputs: (global)
	#	$qpkg_backup_pathfile
	#	$r_qpkg_path

	if [[ ! -f $qpkg_backup_pathfile ]]; then
		DisplayAndCommitErrorToAllLogs "unable to restore configuration: no backup file was found"

		SetError; return
	fi

	if ! DisplayRunAndLog 'restore configuration backup' "/bin/tar --extract --gzip --file=$qpkg_backup_pathfile --directory=$r_qpkg_path/config" log:failure-only; then
		SetError; return
	fi

	IsQpkgMigrated && MigrateConfig

	}

ResetConfig()
	{

	# Inputs: (global)
	#	$qpkg_config_default_pathfile
	#	$r_qpkg_path

	if ! DisplayRunAndLog 'reset configuration' "mv $qpkg_config_default_pathfile $r_qpkg_path; rm -rf $r_qpkg_path/config/*; mkdir -p $(/usr/bin/dirname "$qpkg_config_default_pathfile"); mv $r_qpkg_path/$(/usr/bin/basename "$qpkg_config_default_pathfile") $qpkg_config_default_pathfile" log:failure-only; then
		SetError; return
	fi

	}

MigrateConfig()
	{

	IsNtConfigMigrated || return

	# KLUDGE: update old paths in application config (and default config).

	[[ -e $qpkg_config_pathfile ]] && /bin/sed -i "s|O$r_qpkg_name|$r_qpkg_name|g" "$qpkg_config_pathfile"
	[[ -e $qpkg_config_default_pathfile ]] && /bin/sed -i "s|O$r_qpkg_name|$r_qpkg_name|g" "$qpkg_config_default_pathfile"

	/sbin/setcfg $r_qpkg_name Migrated TRUE -f /etc/config/qpkg.conf

	}

MakePaths()
	{

	# Inputs: (global)
	#	$qpkg_config_path
	#	$qpkg_pip_path
	#	$qpkg_repo_path
	#	$qpkg_temp_path
	#	$r_backup_path
	#	$r_qpkg_path
	#	$qpkg_venv_path

	local a=''

	if [[ -d $r_qpkg_path ]]; then
		for a in "$qpkg_config_path" "$qpkg_pip_path" "$qpkg_repo_path" "$qpkg_temp_path" "$qpkg_venv_path"; do
			[[ $a != undefined && ! -d $a ]] && mkdir -p "$a"
		done
	fi

	[[ $r_backup_path != undefined && ! -d $r_backup_path ]] && mkdir -p "$r_backup_path"

	}

LoadPorts()
	{

	# If user changes ports via application UI, must first 'stop' application on old ports, then 'start' on new ports.

	# Inputs: (local)
	#	$1 = source location of ports.

	# Inputs: (global)
	#	$get_daemon_port_cmd
	#	$get_ui_listening_address_cmd
	#	$get_ui_port_cmd
	#	$get_ui_port_secure_cmd
	#	$r_qpkg_name

	# Outputs: (global)
	#	$daemon_port
	#	$ui_listening_address
	#	$ui_port
	#	$ui_port_secure

	case $1 in
		app)
			# Read the current application UI ports from application configuration.

			DisplayAndCommitProcessWaitToServiceLog 'load ports from configuration file'
			[[ $get_ui_port_cmd != undefined ]] && ui_port=$(eval "$get_ui_port_cmd")
			[[ $get_ui_port_secure_cmd != undefined ]] && ui_port_secure=$(eval "$get_ui_port_secure_cmd")
			DisplayAndCommitOutcomeToServiceLog OK
			;;
		qts)
			# Read the current application UI ports from QTS App Center.

			DisplayAndCommitProcessWaitToServiceLog 'load UI ports from QPKG icon'
			ui_port=$(/sbin/getcfg $r_qpkg_name Web_Port -d 0 -f /etc/config/qpkg.conf)
			ui_port_secure=$(/sbin/getcfg $r_qpkg_name Web_SSL_Port -d 0 -f /etc/config/qpkg.conf)
			DisplayAndCommitOutcomeToServiceLog OK
			;;
		*)
			DisplayAndCommitErrorToAllLogs "unable to load ports: action '$1' is unrecognised"

			SetError; return
	esac

	# Always read these from the application configuration file.

	[[ $get_daemon_port_cmd != undefined ]] && daemon_port=$(eval "$get_daemon_port_cmd")
	[[ $get_ui_listening_address_cmd != undefined ]] && ui_listening_address=$(eval "$get_ui_listening_address_cmd")

	# Validate port numbers.

	ui_port=${ui_port//[!0-9]/}					# Strip all non-numerals.
	[[ -z $ui_port || $ui_port -lt 0 || $ui_port -gt 65535 ]] && ui_port=0

	ui_port_secure=${ui_port_secure//[!0-9]/}	# Strip all non-numerals
	[[ -z $ui_port_secure || $ui_port_secure -lt 0 || $ui_port_secure -gt 65535 ]] && ui_port_secure=0

	daemon_port=${daemon_port//[!0-9]/}			# Strip all non-numerals.
	[[ -z $daemon_port || $daemon_port -lt 0 || $daemon_port -gt 65535 ]] && daemon_port=0

	[[ -z $ui_listening_address ]] && ui_listening_address=undefined
	return 0

	}

GetApplVersion()
	{

	# Find the application's internal version number. This is the installed application version (not the QPKG version).

	# Inputs: (global)
	#	$appl_version_pathfile
	#	$get_appl_version_cmd

	# Output (global):
	#	$appl_version

	if IsSupportGetApplVersion && [[ -e $appl_version_pathfile ]]; then
		appl_version=$(eval "$get_appl_version_cmd")
		return 0
	else
		appl_version=unknown
		return 1
	fi

	}

ShowQpkgStates()
	{

	# Inputs: (global)
	#	$qpkg_repo_path

	DisplayAndCommitInfoWaitToServiceLog 'QPKG enabled'

	if IsQpkgEnabled; then
		DisplayAndCommitOutcomeToServiceLog true
	else
		DisplayAndCommitOutcomeToServiceLog false
	fi

	if IsSupportAutoUpdate; then
		DisplayAndCommitInfoWaitToServiceLog 'application auto-update'

		if IsAutoUpdate; then
			DisplayAndCommitOutcomeToServiceLog true
		else
			DisplayAndCommitOutcomeToServiceLog false
		fi
	fi

	if IsSourceGit; then
		DisplayAndCommitInfoToServiceLog "active git branch: $(GetPathGitBranch "$qpkg_repo_path")"
	fi

	}

DisableOpkgDaemonStart()
	{

	# Inputs: (global)
	#	$orig_daemon_service_script

	if [[ $orig_daemon_service_script != undefined && -x $orig_daemon_service_script ]]; then
		$orig_daemon_service_script stop		# Stop default daemon,
		chmod -x "$orig_daemon_service_script"	# ... and ensure Entware doesn't re-launch it on startup.
	fi

	}

CloneGitRepo()
	{

	# Inputs: (global)
	#	$debug
	#	$qpkg_repo_path
	#	$r_nas_arch
	#	$r_qpkg_name
	#	$source_git_branch
	#	$source_git_branch_depth
	#	$source_git_url

	IsSourceGit || return 0

	ConfirmVarIsDefined qpkg_repo_path "${qpkg_repo_path:-}" "$e_nopth" || return
	ConfirmVarIsDefined source_git_branch "${source_git_branch:-}" "$e_nostr" || return
	ConfirmVarIsDefined source_git_branch_depth "${source_git_branch_depth:-}" "$e_nostr" || return
	ConfirmVarIsDefined source_git_url "${source_git_url:-}" "$e_nourl" || return

	local active_branch=$(GetPathGitBranch "$qpkg_repo_path")
	local branch_depth=' --depth 1'
	local branch_switch=false
	local hide_advice_opt=' -c advice.detachedHead=false'
	local opts=''
	local progress_opt=''

	[[ $source_git_branch_depth = single-branch ]] && branch_depth=' --single-branch'
	[[ $debug = true ]] && progress_opt=' --progress'

	WatchForGit || return

	if [[ -d $qpkg_repo_path/.git ]]; then
		if [[ $active_branch != "$source_git_branch" ]]; then
			DisplayAndCommitInfoToServiceLog "new git branch specified: $source_git_branch"
			branch_switch=true
#			[[ $r_qpkg_name = nzbToMedia ]] && BackupConfig
			CleanLocalRepo
		fi
	fi

	local branch_opt=" --branch ${source_git_branch}${branch_depth}"

	if [[ ! -d $qpkg_repo_path/.git ]]; then
		opts="clone${progress_opt}${branch_opt}${hide_advice_opt} '$source_git_url' $qpkg_repo_path"

		DisplayRunAndLog "create $(FormatAsPackageName "$r_qpkg_name") from remote repository" "cd /tmp; /opt/bin/git $opts" log:failure-only

		if [[ $? -ne 0 ]]; then
			DisplayAndCommitErrorToAllLogs "'git clone' failed"
			SetError; return
		fi
	else
		if IsAutoUpdate; then
			# Latest effort at resolving local clone corruption: https://stackoverflow.com/a/10170195
			opts="-C $qpkg_repo_path clean -f; /opt/bin/git -C $qpkg_repo_path reset --hard origin/$source_git_branch; /opt/bin/git -C $qpkg_repo_path pull"

			DisplayRunAndLog "update $(FormatAsPackageName "$r_qpkg_name") from remote repository" "cd /tmp; /opt/bin/git $opts" log:failure-only

			if [[ $? -ne 0 ]]; then
				DisplayAndCommitErrorToAllLogs "'git pull' failed"
				SetError; return
			fi
		fi
	fi

	active_branch=$(GetPathGitBranch "$qpkg_repo_path")
	DisplayAndCommitInfoToServiceLog "active git branch: $active_branch"

	if [[ -z $active_branch ]]; then
		DisplayAndCommitErrorToAllLogs 'no active git branch found'
		SetError; return
	fi

#	[[ $branch_switch = true && $r_qpkg_name = nzbToMedia ]] && RestoreConfig

	return 0

	}

CleanLocalRepo()
	{

	# For occasions where the local repo needs to be deleted and cloned again from source.

	# Inputs: (global)
	#	$qpkg_pip_path
	#	$qpkg_repo_path
	#	$qpkg_temp_path
	#	$qpkg_venv_path
	#	$r_appl_version_store_pathfile
	#	$r_qpkg_name
	#	$r_qpkg_path

	if [[ -z $r_qpkg_path || -z $r_qpkg_name ]] || IsNtSourcedOnline; then
		SetError; return
	fi

	(IsSourceGit || IsSourceReleasePackage) && DisplayRunAndLog 'clean local repository' "rm -rf \"$qpkg_repo_path\"" log:failure-only
	IsVirtualPythonEnv && [[ -d $qpkg_venv_path ]] && DisplayRunAndLog 'clean virtual Python environment' "rm -rf \"$qpkg_venv_path\"" log:failure-only
	UsesPipCache && [[ -d $qpkg_pip_path ]] && DisplayRunAndLog 'clean PyPI cache' "rm -rf \"$qpkg_pip_path\"" log:failure-only
	[[ -e $r_appl_version_store_pathfile ]] && DisplayRunAndLog 'remove application version' "rm -f \"$r_appl_version_store_pathfile\"" log:failure-only
	[[ -e $r_service_screen_log_pathfile ]] && DisplayRunAndLog "remove previous 'screen' session log" "rm -f \"$r_service_screen_log_pathfile\"" log:failure-only
	UsesTemp && [[ -d $qpkg_temp_path ]] && DisplayRunAndLog 'clean temp path' "rm -rf \"$qpkg_temp_path\"" log:failure-only

	MakePaths

	}

WatchForGit()
	{

	# Inputs: (global)
	#	$r_opkg_path
	#	$PATH

	# Outputs: (global)
	#	$PATH

	if IsNtQpkgInstalled Entware; then
		DisplayAndCommitErrorToAllLogs "'git' unavailable: Entware is not installed"
		SetError; return
	fi

	if IsNtQpkgEnabled Entware; then
		DisplayAndCommitErrorToAllLogs "'git' unavailable: Entware is not enabled"
		SetError; return
	fi

	if WatchForFileToAppear /opt/bin/git 300; then
		export PATH=$r_opkg_path:$(/bin/sed "s|$r_opkg_path||" <<< "$PATH")
		return 0
	fi

	SetError; return

	}

RefreshPidFile()
	{

	# Inputs: (global)
	#	$daemon_check_pathfile
	#	$daemon_exec_pathfile
	#	$daemon_pid_pathfile
	#	$daemon_script_pathfile

	# Outputs:
	#	stdout > $daemon_pid_pathfile

	local -i a=0

	if [[ -e $daemon_pid_pathfile && ! -d /proc/"$(< $daemon_pid_pathfile)" ]]; then
		rm -f "$daemon_pid_pathfile"
	fi

	if [[ $daemon_check_pathfile != undefined ]]; then
		a=$(FindPid "$daemon_check_pathfile")
	else
		a=$(FindPid "$daemon_exec_pathfile" "$daemon_script_pathfile")
	fi

	[[ -n $a && $a -gt 0 ]] && echo "$a" > "$daemon_pid_pathfile"

	}

FindPid()
	{

	# Inputs: (local)
	#	$1 = Process pathfilename to find.
	#	$2 (optional) = additional string to match if there are multiple processes with identical pathfilenames.

	# Outputs: (local)
	#	$? = 0 (found) or 1 (not found)
	#	stdout = PID

	ConfirmVarIsDefined 1 "${1:-}" "$e_nopfi" || return

	local -i a=0
	local b=''

	[[ -n ${2:-} && $2 != undefined ]] && b=$2

	for a in $(/bin/pidof "$(/usr/bin/basename "$1")"); do
		[[ $a -gt 1 ]] || continue
		[[ -d /proc/$a ]] || continue
		[[ -e /proc/$a/cmdline && -L /proc/$a/exe ]] || continue
		[[ $(</proc/$a/cmdline) =~ $1 || $(/usr/bin/readlink /proc/$a/exe) = "$1" ]] || continue

		if [[ -n $b ]]; then
			[[ $(</proc/$a/cmdline) =~ $b ]] || continue	# Check for additional string (if-specified).
		fi

		printf '%s' "$a"

		return
	done

	return 1

	}

PauseForStartPid()
	{

	# Inputs: (global)
	#	$daemon_pid_pathfile
	#	$daemon_pidfile_is_managed_by_app
	#	$recheck_daemon_pid_after_launch
	#	$wait_pid_start_seconds
	#	$watch_pidfile_start_seconds

	local -i a=$(CalcAdaptiveSeconds "$wait_pid_start_seconds")
	local -i i=0

	if [[ $daemon_pidfile_is_managed_by_app = true ]]; then
		if WatchForFileToAppear "$daemon_pid_pathfile" "$(CalcAdaptiveSeconds "$watch_pidfile_start_seconds")"; then
			/bin/sleep 1		# Wait one more second to allow file to have PID written into it.
		fi
	fi

	if [[ $recheck_daemon_pid_after_launch = true ]]; then
		DisplayAndCommitProcessWaitToServiceLog "wait $a second$(Pluralise "$a") to confirm PID is still alive"

		for ((i=1; i<=a; i++)); do
			/bin/sleep 1
			DisplayWait "$i,"
		done

		DisplayAndCommitOutcomeToServiceLog 'done'
	fi

	RefreshPidFile || return

	}

PauseForKillPid()
	{

	# Inputs: (global)
	#	$recheck_daemon_pid_after_kill
	#	$wait_pid_kill_seconds

	local -i a=$(CalcAdaptiveSeconds "$wait_pid_kill_seconds")
	local -i i=0

	if [[ $recheck_daemon_pid_after_kill = true ]]; then
		DisplayAndCommitProcessWaitToServiceLog "wait $a second$(Pluralise "$a") to confirm PID is still dead"

		for ((i=1; i<=a; i++)); do
			/bin/sleep 1
			DisplayWait "$i,"
		done

		DisplayAndCommitOutcomeToServiceLog 'done'
	fi

	! RefreshPidFile || return

	}

WatchForAnyInterfaceUp()
	{

	# Inputs: (global)
	#	$watch_interface_up_seconds

	# Outputs: (local)
	#	$? = 0 (network was found) or 1 (network not found: timeout)

	local -i a=$(CalcAdaptiveSeconds "$watch_interface_up_seconds")
	local -i i=0

	local interface_name=''

	if ! IsAnyInterfaceUp; then
		DisplayAndCommitProcessWaitToServiceLog "watch for a network interface to become operational (no-more than $a second$(Pluralise "$a"))"

		(
			for ((i=1; i<=a; i++)); do
				/bin/sleep 1
				DisplayWait "$i,"

				if IsAnyInterfaceUp; then
					Display OK
					CommitToServiceLog "found in $i second$(Pluralise "$i")"
					true

					exit	# Only this sub-shell.
				fi
			done

			false
		)

		if [[ $? -ne 0 ]]; then
			DisplayAndCommitErrorToAllLogs "operational network interface not found (exceeded timeout: $a second$(Pluralise "$a"))"
			return 1
		fi
	fi

	DisplayAndCommitInfoToServiceLog "operational network interface found: $interface_name"

	return 0

	}

WatchForDaemon()
	{

	# Inputs: (global)
	#	$daemon_pid_pathfile
	#	$watch_pid_start_seconds

	# Outputs: (local)
	#	$? = 0 (file was found) or 1 (file not found: timeout)

	local -i a=$(CalcAdaptiveSeconds "$watch_pid_start_seconds")
	local -i i=0

	if [[ ! -e $daemon_pid_pathfile ]]; then
		DisplayAndCommitProcessWaitToServiceLog "watch for daemon process name to appear (no-more than $a second$(Pluralise "$a"))"

		(
			for ((i=1; i<=a; i++)); do
				/bin/sleep 1
				DisplayWait "$i,"

				RefreshPidFile

				if IsDaemonActive; then
					DisplayAndCommitOutcomeToServiceLog OK
					CommitDoneToServiceLog "process name appeared in $i second$(Pluralise "$i")"
					true

					exit	# Only this sub-shell.
				fi
			done

			false
		)

		if [[ $? -ne 0 ]]; then
			DisplayAndCommitWarnToServiceLog "process name not found (exceeded timeout: $a second$(Pluralise "$a"))"
			return 1
		fi
	fi

	return 0

	}

WatchForFileToAppear()
	{

	# Inputs: (local)
	#	$1 = pathfilename to watch-for.
	#	$2 (optional) = timeout in seconds - default 30

	# Outputs: (local)
	#	$? = 0 : file was found
	#	$? = 1 : file not found/timeout

	[[ -n $1 && $1 != undefined ]] || return

	local -i a=0
	local -i i=0

	if [[ -n $2 ]]; then
		a=$2
	else
		a=30
	fi

	if [[ ! -e $1 ]]; then
		DisplayAndCommitProcessWaitToServiceLog "watch for $1 to appear in filesystem (no-more than $a second$(Pluralise "$a"))"

		(
			for ((i=1; i<=a; i++)); do
				/bin/sleep 1
				DisplayWait "$i,"

				if [[ -e $1 ]]; then
					Display OK
					CommitToServiceLog "visible after $i second$(Pluralise "$i")"
					true

					exit	# Only this sub-shell.
				fi
			done
			false
		)

		if [[ $? -ne 0 ]]; then
			DisplayAndCommitErrorToAllLogs "file $1 not found (exceeded timeout: $a second$(Pluralise "$a"))"
			return 1
		fi
	fi

	DisplayAndCommitInfoToServiceLog "file exists: $1"

	return 0

	}

ViewLog()
	{

	# Inputs: (global)
	#	$r_service_log_pathfile

	if [[ -e $r_service_log_pathfile ]]; then
		if [[ -e /opt/bin/less ]]; then
			LESSSECURE=1 /opt/bin/less +G --quit-on-intr --tilde --LINE-NUMBERS --RAW-CONTROL-CHARS --prompt ' use arrow-keys to scroll up-down left-right, press Q to quit' "$r_service_log_pathfile"
		else
			/bin/cat --number "$r_service_log_pathfile"
		fi
	else
		Display "service log not found: $r_service_log_pathfile"

		SetError; return
	fi

	return 0

	}

EnsureConfigFileExists()
	{

	# Inputs: (global)
	#	$qpkg_config_default_pathfile
	#	$qpkg_config_pathfile
	#	$qpkg_config_virtual_pathfile

	IsSupportReset || return 0

	if UsesConfig valid && [[ ! -e $qpkg_config_pathfile && -e $qpkg_config_default_pathfile ]]; then
		cp "$qpkg_config_default_pathfile" "$qpkg_config_pathfile"
		DisplayAndCommitInfoToServiceLog 'no configuration file, using default as template'
	fi

	if UsesVirtualConfig && [[ -e $qpkg_config_pathfile ]]; then
		if [[ -e $qpkg_config_virtual_pathfile && ! -L $qpkg_config_virtual_pathfile ]]; then
			mv "$qpkg_config_virtual_pathfile" "$qpkg_config_pathfile"			# Use existing config as appl config.
			DisplayAndCommitInfoToServiceLog 'existing file is now configuration file'
		fi

		if [[ ! -L $qpkg_config_virtual_pathfile ]]; then
			ln -s "$qpkg_config_pathfile" "$qpkg_config_virtual_pathfile"
			DisplayAndCommitInfoToServiceLog 'created virtual link to configuration file'
		elif [[ ! -e $qpkg_config_virtual_pathfile ]]; then
			ln -sf "$qpkg_config_pathfile" "$qpkg_config_virtual_pathfile"
			DisplayAndCommitInfoToServiceLog 'existing link broken, re-created link to configuration file'
		fi
	fi

	}

SaveApplVersion()
	{

	# Inputs: (global)
	#	$appl_version
	#	$r_appl_version_store_pathfile

	[[ $r_appl_version_store_pathfile != undefined ]] && echo "$appl_version" > "$r_appl_version_store_pathfile"

	}

DisplayRunAndLog()
	{

	# Run a commandstring with a summarised description, log the results, and show onscreen if-requested.
	# This function is just a fancy wrapper for Executer()			# unused-ignore

	# Inputs: (local)
	#	$1 = Processing message.
	#	$2 = commandstring to execute.
	#	$3 (optional) = 'log:failure-only' - if specified, stdout & stderr are only recorded in the specified log if the command failed. Default is to always record stdout & stderr.
	#	$4 (optional) = true/false - if true, run command in a `screen` session.

	# Inputs: (global)
	#	$debug

	local -r r_log_pathfile=$(/bin/mktemp /var/log/"${FUNCNAME[0]}"_XXXXXX)
	local -i z=0

	DisplayAndCommitProcessWaitToServiceLog "$1"
	Executer "${2:?empty}" "$r_log_pathfile" "${4:-false}"
	z=$?

	if [[ $z -eq 0 ]]; then
		if [[ $debug = true ]]; then
			CommitToServiceLog OK
		else
			DisplayAndCommitToServiceLog OK
		fi

		[[ ${3:-} != log:failure-only ]] && AddFileToDebug "$r_log_pathfile"
	else
		if [[ $debug = true ]]; then
			CommitToServiceLog failed
		else
			DisplayAndCommitToServiceLog failed
		fi

		AddFileToDebug "$r_log_pathfile"
	fi

	[[ -e $r_log_pathfile ]] && rm -f "$r_log_pathfile"
	return $z

	}

Executer()
	{

	# Run a commandstring, log the results, and show onscreen if-requested.

	# Inputs: (local)
	#	$1 = commandstring to execute.
	#	$2 = log pathfile to record stdout and stderr for commandstring.
	#	$3 (optional) = true/false - if true, run command in a `screen` session.

	# Inputs: (global)
	#	$debug
	#	$r_qpkg_name
	#	$r_screen_conf_pathfile
	#	$r_service_screen_log_pathfile

	# Outputs:
	#	stdout = commandstring stdout and stderr if script is in 'debug' mode.
	#	pathfile ($2) = commandstring ($1) stdout and stderr.
	#	$? = $result_code of commandstring.

	local -r r_log_pathfile=$(/bin/mktemp /var/log/"${FUNCNAME[0]}"_XXXXXX)
	local run_in_screen=${3:-false}
	local -i z=0

	FormatAsCommand "${1:?empty}" > "${2:?empty}"

	if [[ $debug = true ]]; then
		local exec_msg='{ exec'
		[[ $run_in_screen = true ]] && exec_msg+=" (in 'screen' session)"
		exec_msg+=':'

		if IsHaveSingleQuote "$1"; then						# Change display quotes depending-on content quote chars.
			exec_msg+=" \"$1\""
		else
			exec_msg+=" '$1'"
		fi

		Display
		Display "$exec_msg"
	fi

	if [[ $run_in_screen = true ]]; then
		FormatAsCommand "$1" >> "$r_service_screen_log_pathfile"
		/usr/sbin/screen -c "$r_screen_conf_pathfile" -dmLS "$r_qpkg_name" sh -c "$1"
		z=$?
	elif [[ $debug = true ]]; then
		eval "$1 2>&1 | /usr/bin/tee $r_log_pathfile"		# NOTE: stdout is buffered here.
		z=${PIPESTATUS[0]}									# Must use $PIPESTATUS after `tee` to get returncode of previous command: https://stackoverflow.com/questions/1221833/pipe-output-and-capture-exit-status-in-bash
	else
		(eval "$1" > "$r_log_pathfile" 2>&1)				# Run within a subshell to suppress "Terminated" message later.
		z=$?
	fi

	if [[ -e $r_log_pathfile ]]; then
		FormatAsResultAndStdout "$z" "$(< "$r_log_pathfile")" >> "$2"
	else
		FormatAsResultAndStdout "$z" '<null>' >> "$2"
	fi

	if [[ $debug = true ]]; then
		exec_msg='} exec: completed'

		if [[ $z -eq 0 ]]; then
			Display "$exec_msg OK ($z)"
		else
			Display "$exec_msg with errors ($z)"
		fi
	fi

	[[ -e $r_log_pathfile ]] && rm -f "$r_log_pathfile"
	return $z

	}

ShowEnabled()
	{

	DisplayAndCommitInfoToServiceLog "$(FormatAsPackageName "$r_qpkg_name") QPKG is enabled."

	}

ShowDisabled()
	{

	DisplayAndCommitToServiceLog "= $(FormatAsPackageName "$r_qpkg_name") QPKG is disabled."

	}

ShowDisabledPrompt()
	{

	DisplayAndCommitToServiceLog "= $(FormatAsPackageName "$r_qpkg_name") QPKG is disabled. Please enable it first with: $0 enable"

	}

ShowEnableFailed()
	{

	DisplayAndCommitToServiceLog "= $(FormatAsPackageName "$r_qpkg_name") QPKG enable failed."

	}

ShowDisableFailed()
	{

	DisplayAndCommitToServiceLog "= $(FormatAsPackageName "$r_qpkg_name") QPKG disable failed."

	}

AddFileToDebug()
	{

	# Add the contents of specified pathfile $1 to the runtime log.

	# Inputs: (local)
	#	$1 = pathfilename of log to add.

	# Inputs: (global)
	#	$debug

	# Outputs: (global)
	#	$debug

	[[ -e ${1:?no filename supplied} ]] || return

	local a=''
	local debug_was_set=$debug

	# Prevent external log contents appearing on-screen again, as they have already been seen "live".
	debug=false

	DebugAsLog ''
	DebugAsLog 'adding external log to main log ...'
	DebugExtLogMinorSeparator
	DebugAsLog "$(FormatAsLogFilename "$1")"

	while read -r a; do
		DebugAsLog "$a"
	done < "$1"

	DebugExtLogMinorSeparator
	debug=$debug_was_set

	}

FormatAsLogFilename()
	{

	Display "log file: '${1:-}'"

	}

FormatAsCommand()
	{

	Display "command: '${1:-}'"

	}

FormatAsResultAndStdout()
	{

	if [[ ${1:-0} -eq 0 ]]; then
		echo "= result_code: $(FormatAsExitcode "$1")"
	else
		echo "= result_code: $(FormatAsExitcode "$1")"
	fi

	DebugBulletSeparatorWithText 'stdout & stderr begins below'
	echo "${2:-}"
	DebugBulletSeparatorWithText 'stdout & stderr is complete'

	}

FormatAsExitcode()
	{

	echo "[${1:-}]"

	}

FormatAsPackageName()
	{

	echo "'${1:-}'"

	}

DebugExtLogMinorSeparator()
	{

	DebugAsLog "$(DebugMinorSeparator)"

	}

DebugBulletSeparatorWithText()
	{

	# Inputs: (global)
	#	$r_debug_log_datawidth

	# Inputs:
	#	$1 = Text to center in separator line.

	local a=''
	[[ -n ${1:-} ]] && a=" ${1:-} "

	local b=$(((r_debug_log_datawidth-${#a})/2))
	local c=$((r_debug_log_datawidth-${#a}-b))

	eval printf '%0.s•' "{1..$b}"; printf '%s' "$a"; eval printf '%0.s•' "{1..$c}"; echo	# `seq` is unavailable in QTS, so must resort to `eval` trickery instead.

	}

DebugMinorSeparator()
	{

	# Inputs: (global)
	#	$r_debug_log_datawidth

	eval printf '%0.s-' "{1..$r_debug_log_datawidth}"		# `seq` is unavailable in QTS, so must resort to `eval` trickery instead.

	}

DebugAsLog()
	{

	[[ -n ${1:-} ]] || return

	DebugThis "(LL) $1"

	}

DebugThis()
	{

	# Inputs: (global)
	#	$debug

	[[ $debug = true ]] && Display "${1:-}"
	WriteAsDebug "${1:-}"

	}

WriteAsDebug()
	{

	WriteToServiceLog dbug "${1:-}"

	}

WriteToServiceLog()
	{

	# Inputs: (global)
	#	$r_service_log_pathfile

	# Inputs: (local)
	#	$1 = pass/fail
	#	$2 = message

	printf "%-4s: %s\n" "$(StripANSICodes "${1:-}")" "$(StripANSICodes "${2:-}")" >> "$r_service_log_pathfile"

	}

StripANSICodes()
	{

	# QTS 4.2.6 BusyBox `sed` doesn't fully support extended regexes, so this only works with a real `sed`.

	if [[ -e /opt/bin/sed && -L /opt/etc/passwd ]]; then	# Try to ensure Entware is active before using this utility.
		/opt/bin/sed -r 's/\x1b\[[0-9;]*m//g' <<< "${1:-}"
	else
		echo "${1:-}"		# Can't strip, so pass thru original message unaltered.
	fi

	}

Capitalise()
	{

	# Capitalise first character of $1

	echo "$(Uppercase ${1:0:1})${1:1}"

	}

Uppercase()
	{

	/bin/tr 'a-z' 'A-Z' <<< "$1"

	}

ReWriteUIPorts()
	{

	# Write the current application UI ports into the QTS App Center configuration.

	# QTS App Center requires 'Web_Port' to always be non-zero.

	# 'Web_SSL_Port' behaviour:
	#		   < -2 = crashes current QTS session. Starts with non-responsive package icons in App Center.
	# missing or -2 = QTS will fallback from HTTPS to HTTP, with a warning to user.
	#			 -1 = launch QTS UI again (only if WebUI = '/'), else show "QNAP Error" page.
	#			  0 = "unable to connect".
	#			> 0 = works if logged-in to QTS UI via HTTPS.

	# If SSL is enabled, attempting to access with non-SSL via 'Web_Port' results in "connection was reset".

	# Inputs: (global)
	#	$get_daemon_port_cmd
	#	$r_qpkg_name
	#	$ui_port
	#	$ui_port_secure

	[[ $get_daemon_port_cmd != undefined ]] && return		# Don't need to rewrite QTS UI ports if this app has a daemon port, as UI ports are unused.

	DisplayAndCommitProcessWaitToServiceLog 'update QPKG icon with UI ports'
	/sbin/setcfg $r_qpkg_name Web_Port "$ui_port" -f /etc/config/qpkg.conf

	if IsSSLEnabled; then
		/sbin/setcfg $r_qpkg_name Web_SSL_Port "$ui_port_secure" -f /etc/config/qpkg.conf
	else
		/sbin/setcfg $r_qpkg_name Web_SSL_Port '-2' -f /etc/config/qpkg.conf
	fi

	DisplayAndCommitOutcomeToServiceLog OK

	}

WatchForPortsActive()
	{

	# Inputs: (global)
	#	$daemon_port
	#	$ui_listening_address
	#	$ui_port
	#	$ui_port_secure

	local a=''

	DisplayAndCommitInfoToServiceLog "daemon listening address: $ui_listening_address"

	if [[ $daemon_port -ne 0 ]]; then
		DisplayAndCommitInfoToServiceLog "daemon port: $daemon_port"

		if IsPortResponds $daemon_port; then
			a="daemon port $daemon_port"
		fi
	else
		DisplayAndCommitInfoWaitToServiceLog 'HTTPS port enabled'

		if IsSSLEnabled; then
			DisplayAndCommitOutcomeToServiceLog true
			DisplayAndCommitInfoToServiceLog "HTTPS port: $ui_port_secure"

			if IsPortSecureResponds $ui_port_secure; then
				a="HTTPS port $ui_port_secure"
			fi
		else
			DisplayAndCommitOutcomeToServiceLog false
		fi

		DisplayAndCommitInfoToServiceLog "HTTP port: $ui_port"

		if IsPortResponds $ui_port; then
			[[ -n $a ]] && a+=' and '
			a+="HTTP port $ui_port"
		fi
	fi

	if [[ -z $a ]]; then
		DisplayAndCommitWarnToServiceLog 'no response on configured port(s)'
		return 1
	else
		ReWriteUIPorts
		return 0
	fi

	}

GetPythonVer()
	{

	local a=''

	a=$(GetThisBinPath ${1:-python} &> /dev/null && ${1:-python} -V 2>&1 | /bin/sed 's|^Python ||;s|\.||g')

	[[ -n $a ]] && echo "${a:0:3}"

	}

GetThisBinPath()
	{

	[[ -n ${1:?null} ]] && command -v "$1" 2>&1

	}

RenameSharedObjectFile()
	{

	# Must check 3 possible module locations.

	[[ -n ${1:-} ]] || return

	if [[ -e $(GetModulePath)/$(GetOriginalModuleSOFilename "_$1") ]]; then
		mv "$(GetModulePath)/$(GetOriginalModuleSOFilename "_$1")" "$(GetModulePath)/$(GetFixedModuleSOFilename "_$1")"
		DisplayAndCommitToServiceLog "= renamed module: _$1"
	fi

	if [[ -e $(GetModulePath)/$1/$(GetOriginalModuleSOFilename "$1") ]]; then
		mv "$(GetModulePath)/$1/$(GetOriginalModuleSOFilename "$1")" "$(GetModulePath)/$1/$(GetFixedModuleSOFilename "$1")"
		DisplayAndCommitToServiceLog "= renamed module: $1/$1"
	fi

	if [[ -e $(GetModulePath)/$(GetOriginalModuleSOFilename "$1") ]]; then
		mv "$(GetModulePath)/$(GetOriginalModuleSOFilename "$1")" "$(GetModulePath)/$(GetFixedModuleSOFilename "$1")"
		DisplayAndCommitToServiceLog "= renamed module: $1"
	fi

	return 0

	}

GetOriginalModuleSOFilename()
	{

	# Inputs: (local)
	#	$1 = Python module name

	# Inputs: (global)
	#	$pyver

	# Outputs: (local)
	#	stdout = filename

	# Outputs: (global)
	#	$pyver

	[[ -z $pyver ]] && pyver=$(GetPythonVer)
	[[ -n ${1:-} ]] && echo "$1.cpython-$pyver-$r_nas_arch-linux-gnu.so"

	}

GetFixedModuleSOFilename()
	{

	# Inputs: (local)
	#	$1 = Python module name

	# Inputs: (global)
	#	$pyver

	# Outputs: (local)
	#	stdout = filename

	# Outputs: (global)
	#	$pyver

	[[ -z $pyver ]] && pyver=$(GetPythonVer)
	[[ -n ${1:-} ]] && echo "$1.cpython-$pyver.so"

	}

GetModulePath()
	{

	# Inputs: (local)
	#	$1 = Python module name

	# Inputs: (global)
	#	$pyver
	#	$qpkg_venv_path

	# Outputs: (local)
	#	stdout = path

	# Outputs: (global)
	#	$pyver

	[[ -z $pyver ]] && pyver=$(GetPythonVer)
	echo "$qpkg_venv_path/lib/python${pyver:0:1}.${pyver:1:2}/site-packages"

	}

GetQpkgArch()
	{

	# Translate arch from local NAS (QTS/QuTS) to sherpa notation.

	# sherpa arch for NAS is a single 3-character code.
	# prefix is 'a' for ARM, 'i' for Intel.

	# Inputs: (global)
	#	$r_nas_arch
	#	$r_nas_firmware_ver
	#	$r_nas_platform

	# Outputs: (local)
	#	stdout = translated QPKG arch.

	if [[ $(get_display_name) = 'TS-269H' ]]; then
		printf i53
		return
	fi

	SetNasArch
	SetOsFirmwareVer
	SetHardwarePlatform

	case $r_nas_arch in
		x86_64)
			[[ $r_nas_firmware_ver -ge 430 ]] && printf i64 || printf i86
			;;
		i686|x86)
			printf i86
			;;
		armv5tel)
			printf a19
			;;
		armv7l)
			case $r_nas_platform in
				ARM_MS)
					printf a31
					;;
				ARM_AL)
					printf a41
					;;
				*)
					printf unknown
			esac
			;;
		aarch64)
			printf a64
			;;
		*)
			printf unknown
	esac

	}

GetNasArch()
	{

	/bin/uname -m

	}

GetOsFirmwareVer()
	{

	# Same as firmware version, but an integer-only (no periods).

	# Outputs: (local)
	#	stdout = integer.
	#	$? = 0 if found, 250 if not.

	/sbin/getcfg System Version -d undefined -f /etc/config/uLinux.conf | tr -d '.'

	}

GetHardwarePlatform()
	{

	# Outputs: (local)
	#	$? = 0 if found, 250 if not.

	/sbin/getcfg '' Platform -d undefined -f /etc/platform.conf

	}

parse_yaml()
	{

	# a nice bit of coding! https://stackoverflow.com/a/21189044

	# Inputs: (local)
	#	$1 = filename to parse.
	#	$2 (optional) = key prefix.

	# Outputs: (local)
	#	stdout = parsed YAML

	local s='[[:space:]]*' w='[a-zA-Z0-9_]*' fs=$(echo @|tr @ '\034')

	/bin/sed -ne "s|^\($s\):|\1|" \
		-e "s|^\($s\)\($w\)$s:$s[\"']\(.*\)[\"']$s\$|\1$fs\2$fs\3|p" \
		-e "s|^\($s\)\($w\)$s:$s\(.*\)$s\$|\1$fs\2$fs\3|p"  $1 |
		/bin/awk -F$fs '{
			indent = length($1)/2;
			vname[indent] = $2;
			for (i in vname) {if (i > indent) {delete vname[i]}}
				if (length($3) > 0) {
				vn=""; for (i=0; i<indent; i++) {vn=(vn)(vname[i])("_")}
				printf("%s%s%s=\"%s\"\n", "'${2:-}'",vn, $2, $3);
				}
			}'
	}

GetKeyFromYAML()						# unused-ignore
	{

	# Inputs: (local)
	#	$1 = key to return value for.
	#	$2 = pathfilename to YAML structure.

	# Outputs: (local)
	#	stdout = value.
	#	$? = 0 if key was found, !0 if not.

	[[ -n ${1:-} && -n ${2:-} ]] || return
	[[ -e $2 ]] || return

	set -o pipefail

	parse_yaml "$2" | grep "${1/:/_}" | cut -d '"' -f2

	}

GetKeyFromTOML()						# unused-ignore
	{

	# Inputs: (local)
	#	$1 = key to return value for.
	#	$2 = pathfilename to TOML structure.

	# Outputs: (local)
	#	stdout = value.
	#	$? = 0 if key was found, !0 if not.

	[[ -n ${1:-} && -n ${2:-} ]] || return
	[[ -e $2 ]] || return

	set -o pipefail

	/bin/grep "^$1 " "$2" | cut -d '=' -f2 | tr -d ' \"'

	}

GetKeyFromPyload()
	{

	# Inputs: (local)
	#   $1 = section name
	#   $2 = variable name to return value for
	#   $3 = pathfilename to read from

	# Outputs: (local)
	#   $? = 0 : variable found
	#   $? = 1 : file/section/variable not found
	#   stdout = variable value

	local target_section_name=${1:?no section supplied}
	local target_var_name=${2:?no variable supplied}
	local source_pathfile=${3:?no pathfilename supplied}

	if [[ ! -e $source_pathfile ]]; then
		echo false
		return
	fi

	local blank=''
	local end_line_num='$'
	local -i line_num=0
	local raw_var_type=''
	local raw_var_description=''
	local result_line=''
	local section_description=''
	local section_line=''
	local section_name=''
	local section_raw=''
	local -i start_line_num=0
	local target_section=''
	local value=''
	local value_raw=''
	local var_found=false
	local var_name=''
	local var_type=''

	while read -r result_line; do
		IFS=':' read -r line_num section_raw <<< "$result_line"
		IFS=' ' read -r section_name blank section_description <<< "$section_raw"

		if [[ $section_name = "$target_section_name" ]]; then
			[[ $start_line_num -eq 0 ]] && start_line_num=$((line_num+1))
		else
			if [[ $start_line_num -ne 0 ]]; then
				end_line_num=$((line_num-2))
				break
			fi
		fi
	done <<< "$(/bin/grep '.*:$' -n "$source_pathfile")"

	if [[ $start_line_num -eq 0 ]]; then
		echo 'section match not found'
		return 1
	fi

	target_section=$(/bin/sed -n "${start_line_num},${end_line_num}p" "$source_pathfile")

	while read -r section_line; do
		IFS=':' read -r raw_var_type raw_var_description <<< "$section_line"
		read -r var_type var_name <<< "$raw_var_type"

		[[ $var_name != "$target_var_name" ]] && continue

		var_found=true
		IFS='"' read -r blank var_description value_raw <<< "$raw_var_description"
		IFS='=' read -r blank value <<< "$value_raw"
		value=${value% }; value=${value# }
		break
	done <<< "$target_section"

	if [[ $var_found = false ]]; then
		echo 'variable match not found'
		return 1
	fi

	echo "$value"

	}

SetNasArch()
	{

	# Outputs: (global)
	#	$r_nas_arch

	[[ ${r_nas_arch:-unset} = unset ]] && readonly r_nas_arch=$(GetNasArch)

	}

SetQpkgArch()
	{

	# Outputs: (global)
	#	$r_nas_qpkg_arch

	[[ ${r_nas_qpkg_arch:-unset} = unset ]] && readonly r_nas_qpkg_arch=$(GetQpkgArch)

	}

SetOsFirmwareVer()
	{

	# Same as firmware version, but as an integer-only (no periods).

	# Outputs: (global)
	#	$r_nas_firmware_ver

	[[ ${r_nas_firmware_ver:-unset} = unset ]] && readonly r_nas_firmware_ver=$(GetOsFirmwareVer)

	}

SetHardwarePlatform()
	{

	# Outputs: (global)
	#	$r_nas_platform

	[[ ${r_nas_platform:-unset} = unset ]] && readonly r_nas_platform=$(GetHardwarePlatform)

	}

IsQNAP()
	{

	# Outputs: (local)
	#	$? = 0 : this is a QNAP NAS
	#	$? = 1 : not a QNAP

	if [[ ! -e /etc/init.d/functions ]]; then
		Display 'QTS functions missing (is this a QNAP NAS?)'

		SetError; return
	fi

	return 0

	}

IsQpkgInstalled()
	{

	# Check if specified QPKG is installed.

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name.

	# Inputs: (global)
	#	$r_qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local a=${1:-$r_qpkg_name}

	[[ $(/sbin/getcfg $a Name -d undefined -f /etc/config/qpkg.conf) = "$a" ]]

	}

IsNtQpkgInstalled()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name.

	# Inputs: (global)
	#	$r_qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgInstalled "${1:-$r_qpkg_name}"

	}

IsQpkgEnabled()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name.

	# Inputs: (global)
	#	$r_qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	[[ $(/sbin/getcfg ${1:-$r_qpkg_name} Enable -u -d FALSE -f /etc/config/qpkg.conf) = TRUE ]]

	}

IsNtQpkgEnabled()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name.

	# Inputs: (global)
	#	$r_qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsQpkgEnabled "${1:-$r_qpkg_name}"

	}

IsConfigMigrated()
	{

	# Check if specified QPKG is in the migration list (from leading 'O' QPKGs).

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name.

	# Inputs: (global)
	#	$r_qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	[[ $(/sbin/getcfg ${1:-$r_qpkg_name} Migrated -u -d FALSE -f /etc/config/qpkg.conf) = TRUE ]]

	}

IsNtConfigMigrated()
	{

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name.

	# Inputs: (global)
	#	$r_qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	! IsConfigMigrated "${1:-$r_qpkg_name}"

	}

IsQpkgMigrated()
	{

	# Check if specified QPKG has been migrated from a prohibited QPKG name (leading 'O').

	# Inputs: (local)
	#	$1 (optional) (string) = QPKG name.

	# Inputs: (global)
	#	$r_qpkg_name (default for $1)

	# Outputs: (local)
	#	$? = true/false

	local re=\\b${1:-$r_qpkg_name}\\b			# bash 3.2 regex with word boundaries: https://stackoverflow.com/a/9793094

	[[ ${r_qpkgs_name_migrated[*]} =~ $re ]]

	}

