IsDaemonCheck()
	{

	# Inputs: (global)
	#	$daemon_check_pathfile

	# Outputs: (local)
	#	$? = true/false

	[[ $daemon_check_pathfile != undefined ]]

	}

ShowDaemonState()
	{

	if [[ -e $daemon_pid_pathfile && -s $daemon_pid_pathfile ]]; then
		DisplayAndCommitInfoToServiceLog "daemon PID: $(< "$daemon_pid_pathfile")"
	else
		DisplayAndCommitInfoToServiceLog 'daemon PID: none'
	fi

	}

IsDaemonActive()
	{

	# Inputs: (global)
	#	$daemon_check_pathfile
	#	$daemon_exec_pathfile
	#	$daemon_pid_pathfile

	# Outputs: (local)
	#	$? = true  : $daemon_exec_pathfile is in memory.
	#	$? = false : $daemon_exec_pathfile is not in memory.

	if [[ -e $daemon_pid_pathfile && -d /proc/"$(< $daemon_pid_pathfile)" ]]; then
		if IsDaemonCheck; then
			[[ $(/usr/bin/readlink /proc/"$(< $daemon_pid_pathfile)"/exe) = "$daemon_check_pathfile" ]]
		else
			[[ $(</proc/"$(< $daemon_pid_pathfile)"/cmdline) =~ $daemon_exec_pathfile ]]
		fi
	else
		false
	fi

	}

IsNtDaemonActive()
	{

	# Outputs: (local)
	#	$? = true  : $daemon_exec_pathfile is not in memory.
	#	$? = false : $daemon_exec_pathfile is in memory.

	! IsDaemonActive

	}

IsPortAvailable()
	{

	# Inputs: (local)
	#	$1 = port to check.

	# Outputs: (local)
	#	$? = true  : available.
	#	$? = false : already used.

	local port=${1//[!0-9]/}			# Strip all non-numerals.
	[[ -n $port && $port -gt 0 ]] || return 0

	/usr/sbin/lsof -i :"$port" -sTCP:LISTEN > /dev/null 2>&1 && return 1

	return 0

	}

IsNtPortAvailable()
	{

	# Inputs: (local)
	#	$1 = port to check.

	# Outputs: (local)
	#	$? = true  : already used.
	#	$? = false : port available.

	! IsPortAvailable "${1:-0}"

	}

IsPortResponds()
	{

	# Inputs: (local)
	#	$1 = port to check.

	# Inputs: (global)
	#	$watch_port_check_seconds

	# Outputs: (local)
	#	$? = 0 : response received.
	#	$? = 1 : not OK.

	local -i a=${1//[!0-9]/}			# Strip all non-numerals.
	local -i b=$(CalcAdaptiveSeconds "$watch_port_check_seconds")
	local -i c=0

	if [[ -z $a ]]; then
		Display 'empty port: not testing for response'
		return 1
	elif [[ $a -eq 0 ]]; then
		Display 'port 0: not testing for response'
		return 1
	fi

	DisplayAndCommitProcessWaitToServiceLog "test for port $a response (no-more than $b second$(Pluralise "$b"))"

	while true; do
		if ! IsDaemonActive; then
			DisplayAndCommitToServiceLog 'process not active'
			break
		fi

		/sbin/curl --silent --fail --max-time 1 http://localhost:"$a" &> /dev/null

		case $? in
			0|22|52)	# Accept these exitcodes as evidence of valid responses.
				DisplayAndCommitOutcomeToServiceLog OK
				CommitDoneToServiceLog "responded in $c second$(Pluralise "$c")"
				return 0
				;;
			28)			# Timed-out.
				:				# do nothing
				;;
			7)			# This code is returned immediately,
				/bin/sleep 1	# ... so let's wait here a bit.
				;;
			*)
				:			# do nothing
		esac

		((c++))
		DisplayWait "$c,"

		if [[ $c -ge $b ]]; then
			DisplayAndCommitOutcomeToServiceLog failed
			CommitErrorToSysLog "port $a failed to respond after $c second$(Pluralise "$c")"
			break
		fi
	done

	return 1

	}

IsPortSecureResponds()
	{

	# Inputs: (local)
	#	$1 = secure port to check.

	# Inputs: (global)
	#	$watch_port_check_seconds

	# Outputs: (local)
	#	$? = 0 : response received.
	#	$? = 1 : not OK or secure port unspecified.

	local -i a=${1//[!0-9]/}			# Strip all non-numerals.
	local -i b=$(CalcAdaptiveSeconds "$watch_port_check_seconds")
	local -i c=0

	if [[ -z $a ]]; then
		Display 'empty port: not testing for response'
		return 1
	elif [[ $a -eq 0 ]]; then
		Display 'port 0: not testing for response'
		return 1
	fi

	DisplayAndCommitProcessWaitToServiceLog "test for secure port $a response (no-more than $b second$(Pluralise "$b"))"

	while true; do
		if ! IsDaemonActive; then
			DisplayAndCommitToServiceLog 'process not active'
			break
		fi

		/sbin/curl --silent --insecure --fail --max-time 1 https://localhost:"$a" &> /dev/null

		case $? in
			0|22|52)	# Accept these exitcodes as evidence of valid responses.
				Display OK
				CommitToServiceLog "port responded after $c second$(Pluralise "$c")"
				return 0
				;;
			35)
				DisplayAndCommitToServiceLog 'TLS inactive'
				break
				;;
			28)			# Timed-out.
				:			# do nothing
				;;
			7)			# This code is returned immediately,
				/bin/sleep 1		# ... so let's wait here a bit.
				;;
			*)
				:			# do nothing
		esac

		((c++))
		DisplayWait "$c,"

		if [[ $c -ge $b ]]; then
			DisplayAndCommitToServiceLog failed
			CommitErrorToSysLog "secure port $a failed to respond after $c second$(Pluralise "$c")"
			break
		fi
	done

	return 1

	}

UsesConfig()
	{

	# Does this application use a configuration file?

	# Inputs: (local)
	#	$1 = possible - test variables for any settings.
	#	$1 = valid - test variables for valid settings.

	# Inputs: (global)
	#	$qpkg_config_default_pathfile
	#	$qpkg_config_path
	#	$qpkg_config_pathfile

	# Outputs: (local)
	#	$? = 0 : true
	#	$? = 1 : false

	[[ -n ${1:-} ]] || return

	case $1 in
		possible)
			IsVarDefined qpkg_config_path || IsVarDefined qpkg_config_pathfile || IsVarDefined qpkg_config_default_pathfile
			;;
		valid)
			IsVarDefined qpkg_config_path && { IsVarDefined qpkg_config_pathfile || IsVarDefined qpkg_config_default_pathfile ;}
	esac

	}

UsesReleasePackage()
	{

	# Does this application use a release package sourced online?

	# Inputs: (local)
	#	$1 = possible - test variables for any settings.
	#	$1 = valid - test variables for valid settings.

	# Inputs: (global)
	#	$qpkg_config_default_pathfile
	#	$qpkg_config_path
	#	$qpkg_config_pathfile

	# Outputs: (local)
	#	$? = 0 : true
	#	$? = 1 : false

	[[ -n ${1:-} ]] || return

	case $1 in
		possible)
			IsVarDefined source_asset_url || IsVarDefined source_asset_url_match || IsVarDefined source_url_arch
			;;
		valid)
			IsVarDefined source_asset_url && IsVarDefined qpkg_temp_path && IsVarDefined qpkg_repo_path
	esac

	}

IsVirtualPythonEnvFound()
	{

	# Is there a virtual Python environment?

	# Inputs: (global)
	#	$qpkg_venv_path

	# Outputs: (local)
	#	$? = 0 : true
	#	$? = 1 : false

	[[ -e $qpkg_venv_path/bin/activate ]]

	}

IsNtVirtualPythonEnvFound()
	{

	! IsVirtualPythonEnvFound

	}

IsOsCanSecureDownload()
	{

	# Inputs: (global)
	#	$r_nas_firmware_ver

	# Outputs: (local)
	#	$? = 0 : true
	#	$? = 1 : false

	[[ $r_nas_firmware_ver -ge 500 ]]

	}

IsSiteUp()
	{

	# Test if remote site is reachable.

	# Inputs: (local)
	#	$1 = URL to query.

	# Outputs: (local)
	#	$? = 0 : true
	#	$? = 1 : false

	[[ -n $1 && $1 != undefined ]] || return

	local a=$(cut -d'/' -f3 <<< "$1" | cut -d':' -f1)

	[[ -n $a && $a != undefined ]] || return

	local -i n=0

	for ((n=0; n<20; n++)); do
		/bin/ping -c 1 -w 1 "$a" && return 0
		/bin/sleep 5
	done

	return 1

	} &> /dev/null

IsHaveSingleQuote()
	{

	# Inputs: (local)
	#	$1 = string to be tested.

	# Outputs: (local)
	#	$? = true if $1 contains a single quote.
	#	$? = false if $1 does not contain a single quote.

	/bin/grep "'" <<< "${1:-}"

	} &> /dev/null

IsCheckNetworkBeforeStart()
	{

	[[ $check_network_before_start = true ]]

	}

IsInterfaceUp()
	{

	# Inputs: (local)
	#	$1 = interface name to check.

	# Outputs: (local)
	#	$? = true if $1 is up, false if not.

	[[ -n ${1:-} ]] || return
	[[ -n $(/bin/ip a | /bin/sed -rn '/: '"$1"':.*state UP/{N;N;s/.*inet (\S*).*/\1/p}') ]]		# https://unix.stackexchange.com/a/121525

	} &> /dev/null

IsAnyInterfaceUp()
	{

	# Inputs: (global)
	#	$interface_name

	# Outputs: (global)
	#	$interface_name

	local a=''
	interface_name=null

	for a in $(/bin/grep ':' /proc/net/dev | cut -d':' -f1 | tr -d ' '); do
		[[ $a != 'lo' ]] || continue
		[[ ! $a =~ 'docker' ]] || continue
		[[ ! $a =~ 'bond' ]] || continue
		[[ ! $a =~ 'dummy' ]] || continue
		[[ ! $a =~ 'lxc' ]] || continue
		[[ ! $a =~ 'lxd' ]] || continue

		if IsInterfaceUp "$a"; then
			echo "interface $a is operational"
			interface_name=$a
			return
		fi
	done

	return 1

	} &> /dev/null

IsVarDefined()
	{

	# Inputs: (local)
	#	$1 = variable name to test.

	# Outputs: (local)
	#	$? = true if $1 is defined, false if not.

	[[ -n ${!1:-} && ${!1:-undefined} != undefined ]]

	} &> /dev/null

RequestLatestReleaseFilename()
	{

	# Request latest release filename from remote site.

	# NOTE: *arr servers don't permit HEAD request, so must issue a GET and follow 304 URL to get final filename.
	# Issuing a GET will also attempt to download the target file, so rate-limit the download speed to 1KB/s as the file isn't actually wanted anyway, and let file download time-out.

	# Inputs: (local)
	#	$1 = URL to check.
	#	$2 (optional) = arch to match.

	# Inputs: (global)
	#	$curl_insecure_opt
	#	$get_remote_filename_timeout_seconds

	# Outputs: (local)
	#	stdout = filename.

	ConfirmVarIsDefined 1 "${1:-}" "$e_nourl" || return

	local a="$curl_insecure_opt --silent --max-time $get_remote_filename_timeout_seconds --limit-rate 1K --location --dump-header -"	# https://stackoverflow.com/a/26644485
	local b=$(/sbin/curl $a "${1/https/http}" | /bin/grep -v 'Location:' | /bin/grep filename | cut -d';' -f2 | cut -d'=' -f2 | /bin/sed -e 's|\r||g')
	[[ -n ${2:-} && ${2:-} != undefined ]] && b=$(/bin/grep -e "$2" <<< "$b")

	# Trim whitespace from beginning-and-end of $b, then test length.

	local -i c=$(wc -l <<< "$b")

	case $c in
		0)
			printf '%s' "${FUNCNAME[0]}(): zero filenames matched"
			return 1
			;;
		1)
			printf '%s' "$b"
			return 0
			;;
		*)
			printf '%s' "${FUNCNAME[0]}(): multiple filenames matched"
			return 1
	esac

	} 2> /dev/null

RequestLatestReleaseURL()
	{

	# Request latest release URL from remote site.

	# Inputs: (local)
	#	$1 = URL to check.
	#	$2 (optional) = longest string to match.

	# Inputs: (global)
	#	$curl_insecure_opt
	#	$get_remote_filename_timeout_seconds

	# Outputs: (local)
	#	stdout = URL.

	ConfirmVarIsDefined 1 "${1:-}" "$e_nourl" || return

	local a="$curl_insecure_opt --silent --max-time $get_remote_filename_timeout_seconds --location"	# https://gist.github.com/steinwaywhw/a4cd19cda655b8249d908261a62687f8
	local b=$(/sbin/curl $a "$1" | /bin/grep browser_download_url | cut -d\" -f4)
	[[ -n ${2:-} && ${2:-} != undefined ]] && b=$(/bin/grep -e "$2" <<< "$b")

	# Need to trim whitespace from beginning-and-end of $b, then test length.

	local -i c=$(wc -l <<< "$b")

	case $c in
		0)
			printf '%s' "${FUNCNAME[0]}(): zero URLs matched"
			return 1
			;;
		1)
			printf '%s' "$b"
			return 0
			;;
		*)
			printf '%s' "${FUNCNAME[0]}(): multiple URLs matched"
			return 1
	esac

	} 2> /dev/null

DownloadReleasePackage()
	{

	# Request specific release filename from remote site.

	# Inputs: (local)
	#	$1 = URL of the source release package.
	#	$2 = pathfilename to save the release package to.

	# Inputs: (global)
	#	$curl_insecure_opt
	#	$debug

	ConfirmVarIsDefined 1 "${1:-}" "$e_nourl" || return
	ConfirmVarIsDefined 2 "${2:-}" "$e_nopfi" || return

	local a=$curl_insecure_opt
	local b=''

	[[ $debug = false ]] && a+=' --silent'

	if [[ -e $2 ]]; then
		b='refresh existing release package (only-if-newer)'
		a+=" --time-cond $2"
	else
		b='download latest release package'
	fi

	a+=" --show-error --max-time 300 --location --output $2"

	DisplayRunAndLog "$b" "/sbin/curl $a '$1'" log:failure-only

	}

ExtractReleasePackage()
	{

	# Inputs: (local)
	#	$1 = pathfilename of the release package to process.
	#	$2 (optional) = release package name ref pathfilename.

	# Inputs: (global)
	#	$compare_release_filename
	#	$debug
	#	$qpkg_repo_path

	ConfirmVarIsDefined 1 "${1:-}" "$e_nopfi" || return

	local tar_opts=''
	local tar_verbose=''
	local unzip_opts=''
	local unzip_verbose=''

	if [[ $debug = true ]]; then
		tar_verbose+=' --verbose'
#		unzip_verbose+=' -v'			# Don't enable this, seems to prevent file extraction.
	fi

	if [[ -e $1 ]]; then
		tar_opts="$tar_verbose --extract --gzip --file=$1 --directory=$qpkg_repo_path"
		unzip_opts="$unzip_verbose -o $1 -d $qpkg_repo_path"

		# Try as '.zip' first, then '.tar.gz'
		DisplayRunAndLog 'extract from release package' "/usr/bin/unzip $unzip_opts 2> /dev/null || /bin/tar $tar_opts" log:failure-only

		if [[ $compare_release_filename = true && -n $2 ]]; then
			if [[ ! -e $2 ]]; then
				DisplayRunAndLog 'create release package name reference' "/bin/touch $2" log:failure-only
			fi
		fi
	fi

	}

MakeExecReleasePackage()
	{

	# Inputs: (local)
	#	$1 = pathfilename of the release package to process.
	#	$2 (optional) = release package name ref pathfilename.

	# Inputs: (global)
	#	$compare_release_filename
	#	$daemon_exec_pathfile
	#	$qpkg_repo_path

	ConfirmVarIsDefined 1 "${1:-}" "$e_nopfi" || return

	if [[ -e $1 ]]; then
		DisplayRunAndLog 'copy release package' "cp -f $1 $daemon_exec_pathfile" log:failure-only
		[[ ! -x $daemon_exec_pathfile ]] && DisplayRunAndLog 'make release package executable' "chmod +x $daemon_exec_pathfile" log:failure-only

		if [[ $compare_release_filename = true && -n $2 ]]; then
			if [[ ! -e $2 ]]; then
				DisplayRunAndLog 'create release package name reference' "/bin/touch $2" log:failure-only
			fi
		fi
	fi

	}

ResetServiceAction()
	{

	SetServiceAction reset-action
	SetServiceResultAsOK

	}

SetServiceAction()
	{

	service_action=${1:-none}
	CommitServiceAction
	SetServiceResultAsInProgress
	DisplayAndCommitActionToServiceLog

	}

SetServiceResultAsOK()
	{

	service_result=ok
	CommitServiceResult
	DisplayAndCommitResultToServiceLog

	}

SetServiceResultAsFailed()
	{

	service_result=failed
	CommitServiceResult
	DisplayAndCommitResultToServiceLog

	}

SetServiceResultAsAborted()
	{

	# Selected action received a SIGINT while executing.

	service_result=aborted
	CommitServiceResult
	DisplayAndCommitResultToServiceLog

	}

SetServiceResultAsInProgress()
	{

	# Selected action is in-progress and hasn't generated a result yet.

	service_result=in-progress
	CommitServiceResult

	}

CommitServiceAction()
	{

	if IsNtStatus && IsNtLog && IsNtNone; then
		[[ $r_service_action_pathfile != undefined ]] && echo "$service_action" > "$r_service_action_pathfile"
	fi

	}

CommitServiceResult()
	{

	if IsNtStatus && IsNtLog && IsNtNone; then
		[[ $r_service_result_pathfile != undefined ]] && echo "$service_result" > "$r_service_result_pathfile"
	fi

	}

SetDaemonWasActive()
	{

	_daemon_was_active=true

	}

DaemonWasNotActive()
	{

	[[ ${_daemon_was_active:=false} = false ]]

	}

SetStatusGet()
	{

	_get_status_flag=true

	}

IsStatus()
	{

	[[ ${_get_status_flag:=false} = true ]]

	}

IsNtStatus()
	{

	! IsStatus

	}

SetError()
	{

	IsError && return
	_error_flag=true
	false

	}

UnsetError()
	{

	IsNtError && return
	_error_flag=false

	}

IsError()
	{

	[[ ${_error_flag:=false} = true ]]

	}

IsNtError()
	{

	! IsError

	}

SetSkipDaemonStart()
	{

	_skipd_flag=true
	false

	}

UnsetSkipDaemonStart()
	{

	_skipd_flag=false

	}

IsSkipDaemonStart()
	{

	[[ ${_skipd_flag:=false} = true ]]

	}

IsNtSkipDaemonStart()
	{

	! IsSkipDaemonStart

	}

IsInstall()
	{

	# `INSTALL_QPKG=true` is set in sherpa management script when action 'install' is run.

	[[ ${INSTALL_QPKG:=false} = true ]]

	}

IsReinstall()
	{

	# `REINSTALL_QPKG=true` is set in sherpa management script when action 'reinstall' is run.

	[[ ${REINSTALL_QPKG:=false} = true ]]

	}

IsUpgrade()
	{

	# `UPGRADE_QPKG=true` is set in sherpa management script when action 'upgrade' is run.

	[[ ${UPGRADE_QPKG:=false} = true ]]

	}

IsUninstall()
	{

	# `UNINSTALL_QPKG=true` is set in sherpa management script when action 'uninstall' is run.

	[[ ${UNINSTALL_QPKG:=false} = true ]]

	}

IsStart()
	{

	[[ $service_action = start ]]

	}

IsNtStart()
	{

	! IsStart

	}

IsStop()
	{

	[[ $service_action = stop ]]

	}

IsRestart()
	{

	[[ $service_action = restart ]]

	}

IsNtRestart()
	{

	! IsRestart

	}

IsLog()
	{

	[[ $service_action = log ]]

	}

IsNtLog()
	{

	! IsLog

	}

IsNone()
	{

	[[ $service_action = none ]]

	}

IsNtNone()
	{

	! IsNone

	}

IsClean()
	{

	[[ $service_action = clean ]]

	}

IsNtClean()
	{

	! IsClean

	}

IsUnsupported()
	{

	[[ $service_action = unsupported ]]

	}

IsInProgress()
	{

	[[ $service_result = in-progress ]]

	}

IsPathEmpty()
	{

	# Inputs: (local)
	#	$1 = directory to check if empty.

	# Outputs: (local)
	#	$? = 0 : true
	#	$? = 1 : false or $1 does not exist.

	local a=${1:-}

	[[ -n $a && -d $a ]] || return

	rmdir "$a" &> /dev/null && mkdir "$a"

	}

ShowAsNote()						# unused-ignore
	{

	# Note to user.

	Display "$(TextBrightYellow note): ${1:-}"

	} >&2

ShowAsImportant()					# unused-ignore
	{

	# Important note to user.

	Display "$(TextBrightYellowBlink note): ${1:-}"

	} >&2

ShowAsError()
	{

	# fatal error

	Display "$(TextBrightRed derp): ${1:-}"

	} >&2

ShowAsBug()
	{

	# Fatal development error.

	# Inputs: (local)
	#	$1 = Problem function name.
	#	$2 = Error message to display.

	[[ -n ${1:-} ]] || return
	[[ -n ${2:-} ]] || return

	local a='fstack: '
	local -i i=0

	# Re-order FUNCNAME[] elements in-reverse.

	for ((i=${#FUNCNAME[@]}-1; i>=0; i--)); do
		[[ $i -ne $((${#FUNCNAME[@]}-1)) ]] && a+=' > '		# Insert separators.

		if [[ ${FUNCNAME[$i]} = "$1" ]]; then
			a+="${FUNCNAME[$i]}($2)"
		else
			a+="${FUNCNAME[$i]}()"
		fi
	done

	CommitErrorToServiceLog "buug: $a"
	Display "$(TextBrightRed buug): $a"
	SetError

	} >&2

ShowAsURL()							# unused-ignore
	{

	TextUnderlinedCyan "${1:?${FUNCNAME[0]}(): $e_nourl}"

	}

DisplayAndCommitInfoToAllLogs()
	{

	DisplayAndCommitInfoToServiceLog "${1:-}"
	CommitInfoToSysLog "${1:-}"

	}

CommitWarnToAllLogs()
	{

	CommitWarnToServiceLog "${1:-}"
	CommitWarnToSysLog "${1:-}"

	}

DisplayAndCommitErrorToAllLogs()
	{

	DisplayAndCommitErrorToServiceLog "${1:-}"
	CommitErrorToSysLog "${1:-}"

	}

DisplayAndCommitInfoToServiceLog()
	{

	DisplayAndCommitToServiceLog "- ${1:-}"

	}

DisplayAndCommitWarnToServiceLog()
	{

	DisplayAndCommitToServiceLog "w ${1:-}"

	}

DisplayAndCommitErrorToServiceLog()
	{

	DisplayAndCommitToServiceLog "! ${1:-}"

	}

DisplayAndCommitDoneToServiceLog()
	{

	DisplayAndCommitToServiceLog "= ${1:-}"

	}

DisplayAndCommitOutcomeToServiceLog()
	{

	# Display the outcome of a previous command where a linefeed was not used. Typically done with a Display...Wait...() function.

#	DisplayAndCommitToServiceLog "'${1:-}'"
	DisplayAndCommitToServiceLog "${1:-}"

	}

DisplayAndCommitRetryToServiceLog()
	{

	DisplayAndCommitToServiceLog "~ ${1:-}"

	}

DisplayAndCommitActionToServiceLog()
	{

	# Inputs: (global)
	#	$r_qpkg_version
	#	$service_action
	#	$r_service_library_version
	#	$r_service_script_version

	# Outputs: (global)
	#	$starttime

	[[ $service_action = unspecified ]] && return

	starttime=$(ConvertNowToNanoseconds)
	local msg="- source: $(/usr/bin/basename "$0"), action: $service_action, time: $(ConvertNowToFullDate), load: $(GetSysLoad1MinAverage)"
	msg="$(/bin/tr -s ' ' <<< "$msg") "
	local a=DisplayAndCommitToServiceLog

	if IsNtStatus && IsNtLog && IsNtNone; then
		IsUnsupported && a=CommitToServiceLog
		CommitToServiceLog '•'

		$a "$(TextInverse "$msg")"
		$a "- package: $r_qpkg_version, service: $r_service_script_version, library: $r_service_library_version"
	fi

	}

DisplayAndCommitResultToServiceLog()
	{

	# Inputs: (global)
	#	$service_action
	#	$service_result
	#	$starttime

	[[ $service_action = unspecified ]] && return

	local msg="= source: $(/usr/bin/basename "$0"), action: $service_action, time: $(ConvertNowToFullDate), result: $(Uppercase "$service_result"), elapsed: $(FormatAsDuration "$(CalcMilliDifference "$starttime" "$(ConvertNowToNanoseconds)")"), load: $(GetSysLoad1MinAverage)"
	msg="$(/bin/tr -s ' ' <<< "$msg") "
	local a=DisplayAndCommitToServiceLog

	if IsNtStatus && IsNtLog && IsNtNone; then
		IsUnsupported && a=CommitToServiceLog

		case $service_result in
			ok)
				$a "$(TextBlackOnGreen "$msg")"
				;;
			failed)
				$a "$(TextBlackOnRed "$msg")"
				;;
			*)
				$a "$(TextBlackOnYellow "$msg")"
		esac
	fi

	}

DisplayAndCommitToServiceLog()
	{

	Display "${1:-}"
	CommitToServiceLog "${1:-}"

	}

DisplayAndCommitProcessWaitToServiceLog()
	{

	DisplayWait "> ${1:-}:"					# squeezer-ignore
	CommitWaitToServiceLog "> ${1:-}:"		# squeezer-ignore

	}

DisplayAndCommitInfoWaitToServiceLog()
	{

	DisplayWait "- ${1:-}:"
	CommitWaitToServiceLog "- ${1:-}:"

	}

CommitInfoToServiceLog()
	{

	CommitToServiceLog "- ${1:-}"

	}

CommitDoneToServiceLog()
	{

	CommitToServiceLog "= ${1:-}"

	}

CommitInfoToSysLog()
	{

	CommitToSysLog "${1:-}." 4

	}

CommitWarnToSysLog()
	{

	CommitToSysLog "${1:-}. Please check the service log for more information." 2

	}

CommitErrorToSysLog()
	{

	CommitToSysLog "${1:-}. Please check the service log for more information." 1

	}

CommitToServiceLog()
	{

	if IsNtStatus && IsNtLog && IsNtNone; then
		[[ ${1:-} = '•' && ! -s "$r_service_log_pathfile" ]] || echo -e "${1:-}" >> "$r_service_log_pathfile"
	fi

	}

CommitWaitToServiceLog()
	{

	if IsNtStatus && IsNtLog && IsNtNone; then
		printf '%s' "${1:-} " >> "$r_service_log_pathfile"
	fi

	}

CommitToSysLog()
	{

	# Inputs: (global)
	#	$r_qpkg_name

	# Inputs: (local)
	#	$1 = message to append to QTS system log
	#	$2 = event type:
	#		1 : Error
	#		2 : Warning
	#		4 : Information

	if IsNtStatus && IsNtLog && IsNtNone; then
		if [[ -z ${1:-} || -z ${2:-} ]]; then
			SetError; return
		fi

		/sbin/write_log "[$r_qpkg_name] $1" "$2"
	fi

	}

DisplayAsHelp()
	{

	printf '  %-22s  - %s\n' "${1:-}" "${2:-}."

	}

Display()
	{

	echo "${1:-}"

	}

DisplayWait()
	{

	echo -n "${1:-} "

	}

TextBrightWhite()
	{

	printf '\033[1;97m%s\033[0m' "${1:-}"

	} 2> /dev/null

TextBrightRed()
	{

	printf '\033[1;31m%s\033[0m' "${1:-}"

	} 2> /dev/null

TextBrightYellow()
	{

	printf '\033[1;33m%s\033[0m' "${1:-}"

	} 2> /dev/null

TextBrightYellowBlink()
	{

	printf '\033[1;5;33m%s\033[0m' "${1:-}"

	} 2> /dev/null

TextBlackOnGreen()
	{

	printf '\033[30;42m%s\033[0m' "${1:-}"

	} 2> /dev/null

TextBlackOnRed()
	{

	printf '\033[30;41m%s\033[0m' "${1:-}"

	} 2> /dev/null

TextBlackOnYellow()
	{

	printf '\033[30;43m%s\033[0m' "${1:-}"

	} 2> /dev/null

TextUnderlinedCyan()
	{

	printf '\033[4;36m%s\033[0m' "${1:-}"

	} 2> /dev/null

TextInverse()
	{

	printf '\033[7m%s\033[0m' "${1:-}"

	} 2> /dev/null

Pluralise()
	{

	[[ ${1:-0} -ne 1 ]] && printf s

	}

CalcMilliDifference()
	{

	# Inputs: (local)
	#	$1 = starttime in epoch nanoseconds
	#	$2 = endtime in epoch nanoseconds

	# Outputs: (local)
	#	stdout = difference in milliseconds

	echo "$(((${2:-1}-${1:-0})/1000000))"

	}

ConvertAsSmartDate()
	{

	# Convert a datecode or epoch time to an extended date format, or a full date format for epoch time.

	# Inputs: (local)
	#	$1 = datecode in the format 'YYMMDD'. Example: '240928' with 6 digits.
	#	$1 = longdatecode in the format 'YYYYMMDD'. Example: '20240928' with 8 digits.
	#	$1 = epoch time. Example: '1234567890'. Since 9th September 2001, epoch time has-been 10 digits and will remain-so until 21st November 2286.

	# Inputs: (global)
	#	$r_extended_datetime_format
	#	$r_full_datetime_format

	# Outputs: (local)
	#	stdout = formatted datetime string.

	[[ -n ${1:-} ]] || return

	local a=$(/bin/sed 's/[^0-9]*//g' <<< "$1")		# Strip non-digits.
	local b=''

	case ${#a} in
		6)		# Assume input is datecode, so convert to extended date format.
			b=$(/bin/date -d "${a::2}-${a:2:2}-${a:4:2}" "$r_extended_datetime_format")
			;;
		8)		# Assume input is longdatecode, so convert to extended date format.
			b=$(/bin/date -d ${a::4}-${a:4:2}-${a:6:2} "$r_extended_datetime_format")
			;;
		10)		# Assume input is epoch time, so convert to full date format.
			b=$(/bin/date -d @"$a" "$r_full_datetime_format")
	esac

	if [[ -n $b ]]; then
		printf '%s (%s)' "$1" "$b"
	else
		printf '%s' "$1"
	fi

	return

	} 2> /dev/null

ConvertNowToFullDate()
	{

	# Outputs: (local)
	#	stdout = real date.

	/bin/date "$r_full_datetime_format"

	} 2> /dev/null

ConvertNowToSeconds()
	{

	# Outputs: (local)
	#	stdout = epoch seconds.

	/bin/date +%s

	} 2> /dev/null

ConvertNowToNanoseconds()
	{

	# Outputs: (local)
	#	stdout = epoch nanoseconds.

	/bin/date +%s%N

	} 2> /dev/null

FormatAsThous()
	{

	# Format as thousands.

	# A string-based thousands-group formatter totally unreliant on locale.
	# Why? Because builtin `printf` in 32b ARM QTS versions doesn't follow locale. ¯\_(ツ)_/¯

	# Inputs: (local)
	#	$1 = Integer value.

	# Outputs: (local)
	#	stdout = formatted number string

	local rightside_group=''
	local foutput=''
	local remainder=$(/bin/sed 's/[^0-9]*//g' <<< "${1:-}")	# Strip all non-numerals.

	while [[ ${#remainder} -gt 0 ]]; do
		rightside_group=${remainder:${#remainder}<3?0:-3}	# A nifty trick found here: https://stackoverflow.com/a/19858692

		if [[ -z $foutput ]]; then
			foutput=$rightside_group
		else
			foutput=$rightside_group,$foutput
		fi

		if [[ ${#rightside_group} -eq 3 ]]; then
			remainder=${remainder%???}						# Trim rightside 3 characters.
		else
			break
		fi
	done

	printf '%s' "$foutput"

	return 0

	}

FormatAsDuration()
	{

	# Inputs: (local)
	#	$1 = Duration in milliseconds.

	if [[ ${1:-0} -lt 10000 ]]; then
		printf '%s' "$(FormatAsThous "${1:-0}")ms"
	else
		FormatSecsToHoursMinutesSecs "$(((${1:-0}+500)/1000))"		# Add 0.5s to improve apparent rounding accuracy.
	fi

	}

FormatSecsToHoursMinutesSecs()
	{

	# http://stackoverflow.com/questions/12199631/convert-seconds-to-hours-minutes-seconds

	# Inputs: (local)
	#	$1 = a time in seconds to convert to `HHh:MMm:SSs`

	# Outputs: (local)
	#	stdout = formatted time string

	((h=${1:-0}/3600))
	((m=(${1:-0}%3600)/60))
	((s=${1:-0}%60))

	printf '%01dh:%02dm:%02ds\n' "$h" "$m" "$s"

	} 2> /dev/null

IsAutoUpdateMissing()
	{

	# Inputs: (global)
	#	$r_qpkg_name

	# Outputs: (local)
	#	$? = 0 : true
	#	$? = 1 : false

	[[ $(/sbin/getcfg $r_qpkg_name Auto_Update -f /etc/config/qpkg.conf) = '' ]]

	}

IsAutoUpdate()
	{

	# Inputs: (global)
	#	$r_qpkg_name

	# Outputs: (local)
	#	$? = 0 : true
	#	$? = 1 : false

	IsSupportAutoUpdate && [[ $(/sbin/getcfg $r_qpkg_name Auto_Update -u -f /etc/config/qpkg.conf) = TRUE ]]

	}

IsNtAutoUpdate()
	{

	! IsAutoUpdate

	}

EnableAutoUpdate()
	{

	StoreAutoUpdateSelection true

	}

DisableAutoUpdate()
	{

	StoreAutoUpdateSelection false

	}

StoreAutoUpdateSelection()
	{

	# Inputs: (local)
	#	$1 = 'true', 'false'

	# Inputs: (global)
	#	$r_qpkg_name

	/sbin/setcfg $r_qpkg_name Auto_Update "$(Uppercase "$1")" -f /etc/config/qpkg.conf
	DisplayAndCommitInfoToServiceLog "application auto-update: $1"

	}

GetPathGitBranch()
	{

	# Inputs: (local)
	#	$1 = path to git repo

	# Outputs: (local)
	#	stdout = branch name

	[[ -n $1 ]] || return

	/opt/bin/git -C "$1" branch | /bin/grep '^\*' | /bin/sed 's|^\* ||'

	} 2> /dev/null

IsSU()
	{

	# Running as superuser?

	# Inputs: (global)
	#	$EUID
	#	$r_chars_super_prompt
	#	$r_user_args_raw

	if [[ $EUID -ne 0 ]]; then
		if [[ -e /usr/bin/sudo ]]; then
			ShowAsError 'this utility must be run with superuser privileges. Try again as:'
			Display "${r_chars_sudo_prompt}$0 $r_user_args_raw" >&2
		else
			ShowAsError "this utility must be run as the 'admin' user. Please login via SSH as 'admin' and try again"
		fi

		return 1
	fi

	return 0

	}

ShowUnsupportedAction()
	{

	ShowAsError "specified action '$1' is unsupported by this service-script."
	SetError
	CommitInfoToServiceLog "specified action '$1' is unsupported."
	Display
	ShowHelp

	}

CalcAdaptiveSeconds()
	{

	# Inputs: (local)
	#	$1 = Integer of base seconds (to suit 1m load average of 1.0 on a single-core CPU). The minimum output value.

	# Outputs: (local)
	#	stdout = Integer of adapted seconds based-on present 1 minute load average. Maximum of 1800.

	local a=$(GetSysLoad1MinAverage); a=${a/./}0	# Convert to thousands. Increase this to workaround decimal rounding.
	local b=$(($(GetCPUCores)*100))					# Convert to hundreds.
	local c=$((10#$a/10#$b))						# Multiplier.
	local d=$((10#${1:-1}))

	[[ $((10#$c)) -gt 10 ]] && d=$(((c*d)/10))		# Decrease this as decimal rounding is now a non-issue.
	[[ $((10#$d)) -gt 1800 ]] && d=1800

	printf '%s' "$d"

	}

GetSysLoad1MinAverage()
	{

	/usr/bin/uptime | /bin/sed 's/.*load average: //' | /bin/awk -F', ' '{print $1}'

	}

GetCPUCores()
	{

	local a=$(/bin/grep -c '^processor' /proc/cpuinfo)

	[[ $a -eq 0 ]] && a=$(/bin/grep -c '^Processor' /proc/cpuinfo)

	printf '%s' "$a"

	}

AddToQpkgPostInstallDeps()			# unused-ignore
	{

	# Inputs: (local)
	#	$1 = target QPKG name.
	#	$2 = QPKG name to add as a post-install dependency.

	# Layout:
	#	'Dependency = packageA:packageB:packageC'

	[[ -n ${1:-} && -n ${2:-} ]] || return

	RemoveFromQpkgPostInstallDeps "$1" "$2"

	SetQpkgPostInstallDeps "$1" "$(GetQpkgPostInstallDeps "$1"):$2"

	}

GetQpkgPostInstallDeps()
	{

	# Inputs: (local)
	#	$1 = source QPKG name.

	# Outputs: (local)
	#	stdout = target QPKG dependency list, colon-separated.

	# Layout:
	#	'Dependency = packageA:packageB:packageC'

	[[ -n ${1:-} ]] || return

	CleanDependencyField "$(/sbin/getcfg $1 Dependency -f /etc/config/qpkg.conf)"

	}

RemoveFromQpkgPostInstallDeps()
	{

	# Inputs: (local)
	#	$1 = target QPKG name.
	#	$2 = QPKG name to remove as a post-install dependency.

	# Layout:
	#	'Dependency = packageA:packageB:packageC'

	[[ -n ${1:-} && -n ${2:-} ]] || return

	local re=\\b${2}\\b

	SetQpkgPostInstallDeps "$1" "$(/bin/sed "s|${re}||g" <<< "$(GetQpkgPostInstallDeps "$1")")"

	}

SetQpkgPostInstallDeps()
	{

	# Inputs: (local)
	#	$1 = target QPKG name.
	#	$2 (optional) = dependency field.

	# Layout:
	#	'Dependency = packageA:packageB:packageC'

	[[ -n ${1:-} ]] || return

	local a=$(CleanDependencyField "${2:-}")

	if [[ -n $a ]]; then
		/sbin/setcfg "$1" Dependency "$a" -f /etc/config/qpkg.conf
	else
		/sbin/setcfg -e "$1" Dependency -f /etc/config/qpkg.conf
	fi

	}

CleanDependencyField()
	{

	# Inputs: (local)
	#	$1 = dependency field to clean.

	# Outputs: (local)
	#	$1 = cleaned dependency field.

	# Layout:
	#	'Dependency = packageA:packageB:packageC'

	[[ -n ${1:-} ]] || return

	local a=$(/bin/tr -s ':' <<< "$1")
	[[ -n $a && ${a:0:1} = ':' ]] && a=${a#?}
	[[ -n $a && ${a: -1:1} = ':' ]] && a=${a%?}

	printf '%s' "$a"

	}

SetTraps()
	{

	trap CaughtSIGHUP SIGHUP
	trap CaughtSIGINT SIGINT
	trap CaughtEXIT EXIT

	}

CaughtSIGHUP()
	{

	# NOTE: Processing will terminate in this function (no-return).

	trap - SIGHUP

	if IsInProgress; then
		Display
		DisplayAndCommitWarnToServiceLog 'caught SIGHUP: abort'
		SetServiceResultAsAborted
	fi

	exit

	}

CaughtSIGINT()
	{

	# NOTE: Processing will terminate in this function (no-return).

	trap - SIGINT

	if IsInProgress; then
		Display
		DisplayAndCommitWarnToServiceLog 'caught SIGINT: abort'
		SetServiceResultAsAborted
	fi

	exit

	}

CaughtEXIT()
	{

	# NOTE: Processing will terminate in this function (no-return).

	trap - EXIT

	if IsInProgress; then
		Display
		DisplayAndCommitWarnToServiceLog 'caught EXIT: abort'
		SetServiceResultAsAborted
	fi

	}

ProcessArgs()						# unused-ignore.
	{

	# NOTE: Processing will terminate in this function (no-return).

	if IsReinstall; then			# Ignore 'start' and 'stop' requests issued by QTS during QPKG reinstallation. If QPKG is disabled, then reinstalled, the service result will be 'failed' (which is technically correct as the last action after reinstall is 'start', but probably better to see the reinstall result instead).
		echo "Detected 'reinstall' in-progress, so not processing internal QPKG actions further."
		exit
	fi

	if IsUpgrade; then				# Ignore 'start' and 'stop' requests issued by QTS during QPKG upgrade. If QPKG is disabled, then upgraded, the service result will be 'failed' (which is technically correct as the last action after upgrade is 'start', but probably better to see the upgrade result instead).
		echo "Detected 'upgrade' in-progress, so not processing internal QPKG actions further."
		exit
	fi

	if IsSourceGit; then
		local test_branch=$(/sbin/getcfg $r_qpkg_name Git_Branch -d unknown -f /etc/config/qpkg.conf)

		if [[ $test_branch = unknown ]]; then
			/sbin/setcfg $r_qpkg_name Git_Branch $source_git_branch -f /etc/config/qpkg.conf
		else
			source_git_branch=$test_branch
		fi
	fi

	if IsNtError; then
		local user_arg=${r_user_args_raw%% *}		# Only process first argument.

		case $user_arg in
			?(--)activate|?(--)start)
				IsSU || exit

				SetServiceAction start

				if IsQpkgEnabled; then
					SetTraps
					StartQpkg
				else
					ShowDisabledPrompt
					SetError
				fi
				;;
			?(-)b|?(--)backup?(-config))
				IsSU || exit

				if IsSupportBackup; then
					SetServiceAction backup
					SetTraps
					StopQpkg
					BackupConfig
					IsQpkgEnabled && StartQpkg
				else
					SetServiceAction unsupported
					ShowUnsupportedAction "$user_arg"
				fi
				;;
			?(--)clean|?(--)update|?(--)upgrade)
				IsSU || exit

				if IsSourcedOnline; then
					SetServiceAction clean
					SetTraps
					StopQpkg
#					[[ $r_qpkg_name = nzbToMedia ]] && BackupConfig
					CleanLocalRepo
					IsQpkgEnabled && StartQpkg
#					[[ $r_qpkg_name = nzbToMedia ]] && RestoreConfig
				else
					SetServiceAction unsupported
					ShowUnsupportedAction "$user_arg"
				fi
				;;
			?(--)deactivate|?(--)stop)
				IsSU || exit
				IsUninstall && exit					# No-need to 'stop' during 'uninstall' from sherpa, as 'stop' has already been done by sherpa.

				SetServiceAction stop
				SetTraps
				StopQpkg
				;;
			?(--)disable)
				IsSU || exit

				SetServiceAction disable
				SetTraps

				[[ $(type -t PreDisableQpkgCustom) = function ]] && PreDisableQpkgCustom

				/sbin/qpkg_service disable "$r_qpkg_name"

				if IsNtQpkgEnabled; then
					ShowDisabled
				else
					ShowDisableFailed
					SetError
				fi
				;;
			?(--)disable-auto-update)
				IsSU || exit

				if IsSupportAutoUpdate; then
					SetServiceAction disable-auto-update
					SetTraps
					DisableAutoUpdate
				else
					SetServiceAction unsupported
					ShowUnsupportedAction "$user_arg"
				fi
				;;
			?(--)enable)
				IsSU || exit

				SetServiceAction enable
				SetTraps

				[[ $(type -t PreEnableQpkgCustom) = function ]] && PreEnableQpkgCustom

				/sbin/qpkg_service enable "$r_qpkg_name"

				if IsQpkgEnabled; then
					ShowEnabled
				else
					ShowEnableFailed
					SetError
				fi
				;;
			?(--)enable-auto-update)
				IsSU || exit

				if IsSupportAutoUpdate; then
					SetServiceAction enable-auto-update
					SetTraps
					EnableAutoUpdate
				else
					SetServiceAction unsupported
					ShowUnsupportedAction "$user_arg"
				fi
				;;
			?(--)help)
				ShowHelp
				;;
			?(-)+(l|L)|?(--)log)
				SetServiceAction log
				ViewLog
				;;
			?(-)r|?(--)reactivate|?(--)restart)
				IsSU || exit

				SetServiceAction restart

				if IsQpkgEnabled; then
					SetTraps
					StopQpkg && StartQpkg
				else
					ShowDisabledPrompt
					SetError
				fi
				;;
			remove)			# Only called by the QDK '.uninstall.sh' script.
				SetServiceAction uninstall
				;;
			?(--)reset-action)
				IsSU || exit

				if IsSupportActions; then
					ResetServiceAction
					exit
				else
					SetServiceAction unsupported
					ShowUnsupportedAction "$user_arg"
				fi
				;;
			?(--)reset-config)
				IsSU || exit

				if IsSupportReset; then
					SetServiceAction reset
					SetTraps
					StopQpkg
					ResetConfig
					IsQpkgEnabled && StartQpkg
				else
					SetServiceAction unsupported
					ShowUnsupportedAction "$user_arg"
				fi
				;;
			?(--)restore?(-config))
				IsSU || exit

				if IsSupportBackup; then
					SetServiceAction restore
					SetTraps
					StopQpkg
					RestoreConfig
					IsQpkgEnabled && StartQpkg
				else
					SetServiceAction unsupported
					ShowUnsupportedAction "$user_arg"
				fi
				;;
			?(-)s|?(--)status)
				IsSU || exit

				SetStatusGet
				StatusQpkg
				;;
			uninstall)
				: # Ignore.
				;;
			?(-)+(v|V)|?(--)version?(s))
				Display "QPKG: $(ConvertAsSmartDate ${r_qpkg_version:-undefined})"
				Display "service: $(ConvertAsSmartDate "${r_service_script_version:-undefined}")"
				Display "library: $(ConvertAsSmartDate "${r_service_library_version:-undefined}")"
				;;
			*)
				if [[ -z $user_arg ]]; then
					ShowHelp
				else
					SetServiceAction unsupported
					ShowUnsupportedAction "$user_arg"
				fi
		esac
	fi

	if IsNtLog && IsNtNone; then
		if IsError; then
			SetServiceResultAsFailed

			exit 1
		else
			SetServiceResultAsOK
		fi
	fi

	exit 0

	}

InitLibrary
